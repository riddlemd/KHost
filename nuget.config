<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Oriel is not published: each machine packs it once into its own checkout's artifacts/pkg
         (Oriel's eng/pack.ps1, plus the runtime package for that OS). The path assumes the
         {root}/{owner}/{repo}/{branch} layout, so Oriel's main sits two folders up from here. -->
    <add key="oriel-local" value="../../Oriel/main/artifacts/pkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="oriel-local">
      <package pattern="Oriel" />
      <package pattern="Oriel.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
