<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Riftway is not published: each machine packs it once into its own checkout's artifacts/pkg
         (Riftway's eng/pack.ps1, plus the runtime package for that OS). The path assumes the
         {root}/{owner}/{repo}/{branch} layout, so Riftway's main sits two folders up from here. -->
    <add key="riftway-local" value="../../Riftway/main/artifacts/pkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="riftway-local">
      <package pattern="Riftway" />
      <package pattern="Riftway.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
