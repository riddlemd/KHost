<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Needed to compile against HttpContext for the middleware/redirect-provider tests. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KHost.Abstractions\KHost.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\KHost.DataAccess\KHost.DataAccess.csproj" />
    <ProjectReference Include="..\..\src\KHost.Domain\KHost.Domain.csproj" />
    <ProjectReference Include="..\..\src\KHost.IPC.SignalR\KHost.IPC.SignalR.csproj" />
    <ProjectReference Include="..\..\src\KHost.LrcLib\KHost.LrcLib.csproj" />
    <ProjectReference Include="..\..\src\KHost.Screen\KHost.Screen.csproj" />
    <ProjectReference Include="..\..\src\KHost.Telemetry\KHost.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\KHost.UserInterface\KHost.UserInterface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NSubstitute" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
