{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Audio": {
    "Volume": 1.0
  },
  "PlaybackService": {
    "MoveSingerToBottomAfterPerformance": true
  },
  "SingerQueueService": {
    "PromptBeforeRemovingSinger": true,
    "ClearOnClose": true
  }
}
