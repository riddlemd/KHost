@using KHost.Domain.Collections.Generics
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services
@using KHost.Domain.Chronography;
@implements IDisposable

<div class="kh-selected-singer-info-panel kh-card">
    <div class="kh-card__header d-flex align-items-center gap-2">
        <Icon Name="queue-music" />
        <Icon Name="music-note-list" />
        @if (SingerQueueService?.SelectedSinger is { } singer)
        {
            <span class="kh-card__title">@singer.Name's Queue</span>
            <span class="kh-badge kh-badge--secondary kh-selected-singer-info-panel__song-count ms-auto" title="Number of songs in queue">@_performanceCount</span>
        }
        else
        {
            <span class="kh-card__title">Singer Media Queue</span>
        }
        <div class="kh-selected-singer-info-panel__quick-menu">
            <span class="kh-selected-singer-info-panel__flags">
                <button class="kh-selected-singer-info-panel__toggle-regular-btn kh-button--icon-minimal @(SingerQueueService?.SelectedSinger?.IsRegular == false ? " kh-button--off" : "")"
                        title="@(SingerQueueService?.SelectedSinger?.IsRegular == true ? "This singer is a Regular!" : "Click to flag this singer as a Regular")"
                        @onclick="() => ToggleIsRegularAsync()">
                    <Icon Name="heart-fill" Class="kh-selected-singer-info-panel__flag-icon--regular" />
                </button>

                <button class="kh-selected-singer-info-panel__toggle-tipper-btn kh-button--icon-minimal @(SingerQueueService?.SelectedSinger?.IsTipper == false ? " kh-button--off" : "")"
                        title="@(SingerQueueService?.SelectedSinger?.IsTipper == true ? "This singer is a Tipper!" : "Click to flag this singer as a Tipper")"
                        @onclick="() => ToggleIsTipperAsync()">
                    <Icon Name="coin" Class="kh-selected-singer-info-panel__flag-icon--tipper" />
                </button>
            </span>

            <button class="kh-selected-singer-info-panel__menu-btn kh-button kh-button--primary" title="Click to view Singer's Performance history"
                    @onclick="OpenPerformanceHistoryDialogAsync" @onclick:stopPropagation>
                <Icon Name="music-note-list" />
            </button>
            <button class="kh-selected-singer-info-panel__menu-btn kh-button kh-button--primary" title="Click to edit Singer's Profile"
                    @onclick="OpenSingerEditDialogAsync" @onclick:stopPropagation>
                <Icon Name="pencil-fill" />
            </button>
        </div>
    </div>

    <div class="kh-card__body kh-selected-singer-info-panel__body">
        @if (SingerQueueService?.SelectedSinger is null)
        {
            // Do nothing, we should not see this.
        }
        else
        {
            var selected = SingerQueueService.SelectedSinger!;

            if (_performances.Count == 0)
            {
                <div class="kh-panel--empty">
                    <Icon Name="music-note-list" />
                    <span>No Media queued for @selected.Name yet</span>
                </div>
            }
            else
            {
            <table class="kh-table kh-selected-singer-info-panel__table">
                <thead class="sticky-top">
                    <tr>
                        <th class="kh-selected-singer-info-panel__col--number">#</th>
                        <th>Title</th>
                        <th>Artist</th>
                        <th class="kh-selected-singer-info-panel__col--duration">Duration</th>
                        <th class="kh-selected-singer-info-panel__col--status">Status</th>
                        <th class="kh-selected-singer-info-panel__col--actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (performance, idx) in _performances.Select((p, i) => (p, i)))
                    {
                        var isCurrent = PlaybackService?.CurrentPerformance?.Id == performance.Id;
                        var isSelected = _selectedPerformanceId == performance.Id;
                        var disableMoveUp = idx == 0;
                        var disableMoveDown = idx == _performances.Count - 1;
                        var disableRemove = PlaybackService?.CurrentPerformance?.Id == performance.Id;
                        var rowClass = isSelected ? "kh-selected-singer-info-panel__row--selected" : isCurrent ? "kh-selected-singer-info-panel__row--current" : "";
                        var nameClass = isCurrent ? "kh-selected-singer-info-panel__name--current" : "";
                        var disablePlay = PlaybackService?.CurrentPerformance != null;

                        <tr class="kh-selected-singer-info-panel__row @rowClass" @onclick="() => SelectPerformance(performance.Id)">
                            <td class="kh-selected-singer-info-panel__pos">
                                @if (isCurrent && PlaybackService?.State == PlaybackState.Playing)
                                {
                                    <div class="kh-now-playing__bars kh-now-playing__bars--sm">
                                        <div class="kh-now-playing__bar"></div>
                                        <div class="kh-now-playing__bar"></div>
                                        <div class="kh-now-playing__bar"></div>
                                    </div>
                                }
                                else
                                {
                                    <span>@(idx + 1)</span>
                                }
                            </td>
                            @{ _mediaCache.TryGetValue(performance.MediaId, out var rowMedia); }
                            <td class="text-truncate kh-selected-singer-info-panel__name kh-table__cell--fill">
                                <span class="@nameClass">@(rowMedia?.Title ?? "—")</span>
                            </td>
                            <td>@(rowMedia?.Artist ?? "")</td>
                            <td class="kh-selected-singer-info-panel__duration">
                                    @rowMedia?.Duration?.ToTotalMinutesAndSeconds()
                            </td>
                            <td>@(rowMedia?.Status)</td>
                            <td>
                                <SplitButton 
                                        Title="@(disablePlay ? "Cannot Load and Play while another Song is loaded" : "Load and Play Song")"
                                        disabled="@disablePlay"
                                        @onclick="() => LoadAndPlayAsync(performance)">
                                     <Text><Icon Name="play-fill" /></Text>
                                     <Buttons>
                                        <button class="kh-button kh-button--primary"
                                                @onclick="() => {}"
                                                title="Edit Song">
                                            <Icon Name="pencil-fil" /> Edit
                                        </button>
                                    </Buttons>
                                </SplitButton>
                                <button class="kh-selected-singer-info-panel__move-up-btn kh-button--icon-minimal" title="Move up Queue"
                                        disabled="@disableMoveUp"
                                        @onclick="() => PerformanceService?.MoveUpInQueueAsync(selected.Id, performance.Id) ?? Task.CompletedTask">
                                    <Icon Name="chevron-up" />
                                </button>
                                <button class="kh-selected-singer-info-panel__move-down-btn kh-button--icon-minimal" title="Move down Queue"
                                        disabled="@disableMoveDown"
                                        @onclick="() => PerformanceService?.MoveDownInQueueAsync(selected.Id, performance.Id) ?? Task.CompletedTask">
                                    <Icon Name="chevron-down" />
                                </button>
                                <button class="kh-selected-singer-info-panel__remove-btn kh-button--icon-danger" title="Remove from Queue"
                                        disabled="@disableRemove"
                                        @onclick="() => PerformanceService?.DeleteAsync(performance.Id) ?? Task.CompletedTask">
                                    <Icon Name="x" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            }
        }
    </div>
</div>

@code {
    [Inject] private ISingerQueueService? SingerQueueService { get; set; }
    [Inject] private IPerformanceService? PerformanceService { get; set; }
    [Inject] private IPlaybackService? PlaybackService { get; set; }
    [Inject] private IMediaSearchService? MediaSearchService { get; set; }
    [Inject] private ISingersService? SingersService { get; set; }
    [Inject] private IMediaService? MediaService { get; set; }
    [Inject] private IDialogService? DialogService { get; set; }

    private List<Performance> _performances = [];
    private Dictionary<Guid, Media?> _mediaCache = [];
    private int _performanceCount = 0;
    private Guid? _selectedPerformanceId;

    protected override async Task OnInitializedAsync()
    {
        SingerQueueService?.StateChanged += OnStateChanged;
        PerformanceService?.StateChanged += OnStateChanged;
        PlaybackService?.StateChanged += OnStateChanged;
        MediaService?.StateChanged += OnStateChanged;

        await RefreshPerformancesAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (SingerQueueService?.SelectedSinger is null) return;

        var currentIdx = _performances.FindIndex(s => s.Id == _selectedPerformanceId);

        Performance? selectedPerformance = null;

        if (e.Key == "ArrowUp" && currentIdx > 0)
            selectedPerformance = _performances[currentIdx - 1];
        else if (e.Key == "ArrowDown" && currentIdx < _performances.Count - 1)
            selectedPerformance = _performances[currentIdx + 1];

        if (selectedPerformance != null)
            SelectPerformance(selectedPerformance.Id);
    }

    private async Task LoadAndPlayAsync(Performance performance)
    {
        if (PlaybackService is null) return;

        // Prevent loading a new media if one is already playing
        if (PlaybackService.State == PlaybackState.Playing && PlaybackService.CurrentPerformance?.Id != performance.Id)
            return;

        if (!_mediaCache.TryGetValue(performance.MediaId, out var media) || media is null)
            return;

        await PlaybackService.LoadAsync(performance, media);
        await PlaybackService.PlayAsync();
    }

    private async Task OpenPerformanceHistoryDialogAsync()
    {
        if (SingerQueueService?.SelectedSinger is null) return;
        await DialogService!.ShowSingerPerformanceHistoryAsync(SingerQueueService.SelectedSinger.Id);
    }

    private async Task OpenSingerEditDialogAsync()
    {
        if (SingerQueueService?.SelectedSinger is null) return;
        await DialogService!.RequestEditAsync(SingerQueueService.SelectedSinger, async singer => await SaveSingerAsync(singer));
    }

    private async Task SaveSingerAsync(Singer? singer)
    {
        if (SingerQueueService is null || SingersService is null || singer is null) return;
        await SingersService.UpdateAsync(singer);
        await SingerQueueService.RefreshAsync();
    }

    private async Task ToggleIsRegularAsync()
    {
        if (SingerQueueService is null) return;
        if (SingersService is null) return;

        if (SingerQueueService.SelectedSinger is { } singer)
        {
            await SingersService.ToggleIsRegularAsync(singer.Id);
            await SingerQueueService.RefreshAsync();
        }
    }

    private async Task ToggleIsTipperAsync()
    {
        if (SingerQueueService is null) return;
        if (SingersService is null) return;

        if (SingerQueueService.SelectedSinger is { } singer)
        {
            await SingersService.ToggleIsTipperAsync(singer.Id);
            await SingerQueueService.RefreshAsync();
        }
    }

    private void SelectPerformance(Guid performanceId)
    {
        _selectedPerformanceId = performanceId;
        StateHasChanged();
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(async () =>
    {
        await RefreshPerformancesAsync();
        StateHasChanged();
    });

    private async Task RefreshPerformancesAsync()
    {
        if (SingerQueueService is null) return;
        if (PerformanceService is null) return;

        if (SingerQueueService.SelectedSinger is { } singer)
        {
            _performances = (await PerformanceService.ReadQueuedAsync()).Where(p => p.SingerId == singer.Id).ToList();
            _performanceCount = _performances.Count;
            if (!_performances.Any(p => p.Id == _selectedPerformanceId))
                _selectedPerformanceId = null;

            // Fetch all media for this singer's performances
            if (_performances.Count > 0 && MediaService is not null)
            {
                var mediaIds = _performances.Select(p => p.MediaId).Distinct().ToList();
                var mediaTasks = mediaIds.Select(id => MediaService.ReadAsync(id)).ToList();
                var mediaResults = await Task.WhenAll(mediaTasks);
                _mediaCache = mediaIds.Zip(mediaResults).ToDictionary(x => x.First, x => x.Second);
            }
            else
            {
                _mediaCache = [];
            }
        }
        else
        {
            _performances = [];
            _performanceCount = 0;
            _selectedPerformanceId = null;
            _mediaCache = [];
        }
    }

    public void Dispose()
    {
        SingerQueueService?.StateChanged    -= OnStateChanged;
        PerformanceService?.StateChanged    -= OnStateChanged;
        PlaybackService?.StateChanged -= OnStateChanged;
        MediaService?.StateChanged -= OnStateChanged;
    }
}
