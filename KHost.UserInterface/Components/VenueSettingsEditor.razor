@using KHost.Abstractions.Models

<div class="kh-venue-settings-editor__section">
    <span class="kh-venue-settings-editor__section-title">Playback</span>
    <div class="kh-venue-settings-editor__row">
        <label for="venue-settings-volume" class="form-label mb-0">Default Volume</label>
        <InputNumber id="venue-settings-volume" class="form-control" @bind-Value="Settings.DefaultVolume" min="0" max="100" disabled="@Disabled" />
    </div>
</div>

<div class="kh-venue-settings-editor__section">
    <span class="kh-venue-settings-editor__section-title">Queue behavior</span>

    <label class="kh-venue-settings-editor__row form-check mb-2">
        <span class="form-check-label">Move singer to bottom after performance</span>
        <InputCheckbox class="form-check-input" @bind-Value="Settings.MoveSingerToBottomAfterPerformance" disabled="@Disabled" />
    </label>
    <label class="kh-venue-settings-editor__row form-check">
        <span class="form-check-label">Clear queue when closing</span>
        <InputCheckbox class="form-check-input" @bind-Value="Settings.ClearQueueOnClose" disabled="@Disabled" />
    </label>
</div>

<div class="kh-venue-settings-editor__section">
    <span class="kh-venue-settings-editor__section-title">Require confirmation when removing</span>

    <div class="kh-venue-settings-editor__prompt-grid">
        <label class="kh-venue-settings-editor__prompt-item form-check">
            <span class="kh-venue-settings-editor__prompt-item-label">
                <Icon Name="person-x-fill" />
                <span class="form-check-label">Singer from queue</span>
            </span>
            <InputCheckbox class="form-check-input" @bind-Value="Settings.PromptBeforeRemovingSinger" disabled="@Disabled" />
        </label>
        <label class="kh-venue-settings-editor__prompt-item form-check">
            <span class="kh-venue-settings-editor__prompt-item-label">
                <Icon Name="music-note-beamed" />
                <span class="form-check-label">Song from queue</span>
            </span>
            <InputCheckbox class="form-check-input" @bind-Value="Settings.PromptBeforeRemovingPerformance" disabled="@Disabled" />
        </label>
        <label class="kh-venue-settings-editor__prompt-item form-check">
            <span class="kh-venue-settings-editor__prompt-item-label">
                <Icon Name="clock-history" />
                <span class="form-check-label">Performance history</span>
            </span>
            <InputCheckbox class="form-check-input" @bind-Value="Settings.PromptBeforeRemovingPerformanceHistory" disabled="@Disabled" />
        </label>
        <label class="kh-venue-settings-editor__prompt-item form-check">
            <span class="kh-venue-settings-editor__prompt-item-label">
                <Icon Name="person-fill" />
                <span class="form-check-label">User</span>
            </span>
            <InputCheckbox class="form-check-input" @bind-Value="Settings.PromptBeforeRemovingUser" disabled="@Disabled" />
        </label>
        <label class="kh-venue-settings-editor__prompt-item form-check">
            <span class="kh-venue-settings-editor__prompt-item-label">
                <Icon Name="people-fill" />
                <span class="form-check-label">User group</span>
            </span>
            <InputCheckbox class="form-check-input" @bind-Value="Settings.PromptBeforeRemovingUserGroup" disabled="@Disabled" />
        </label>
        <label class="kh-venue-settings-editor__prompt-item form-check">
            <span class="kh-venue-settings-editor__prompt-item-label">
                <Icon Name="building" />
                <span class="form-check-label">Venue</span>
            </span>
            <InputCheckbox class="form-check-input" @bind-Value="Settings.PromptBeforeRemovingVenue" disabled="@Disabled" />
        </label>
        <label class="kh-venue-settings-editor__prompt-item form-check">
            <span class="kh-venue-settings-editor__prompt-item-label">
                <Icon Name="film" />
                <span class="form-check-label">Media</span>
            </span>
            <InputCheckbox class="form-check-input" @bind-Value="Settings.PromptBeforeRemovingMedia" disabled="@Disabled" />
        </label>
        <label class="kh-venue-settings-editor__prompt-item form-check">
            <span class="kh-venue-settings-editor__prompt-item-label">
                <Icon Name="cash-coin" />
                <span class="form-check-label">Tip</span>
            </span>
            <InputCheckbox class="form-check-input" @bind-Value="Settings.PromptBeforeRemovingTip" disabled="@Disabled" />
        </label>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Venue.VenueSettings Settings { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
}
