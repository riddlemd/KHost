@using KHost.UserInterface.Components.Karaoke
@using KHost.Abstractions.Services
@inject IMediaService MediaService

<div class="kh-setup-wizard__step kh-setup-wizard__step--full-height">
    <div class="kh-setup-wizard__header">
        <h2>Import Media Library</h2>
        <p>Browse your computer to import karaoke songs.</p>
    </div>

    <div class="kh-setup-wizard__media-browser">
        <MediaBrowser OnImportCompleted="OnImportCompletedAsync" />
    </div>

    <div class="kh-setup-wizard__actions">
        <button class="kh-button kh-button--primary"
                disabled="@(_isLoading)"
                @onclick="OnCompleteAsync"
                type="button">
            @if (_isLoading)
            {
                <Icon Name="hourglass-split" /> <span>Finalizing...</span>
            }
            else
            {
                <Icon Name="check-lg" /> <span>Finish Setup</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnComplete { get; set; }

    private bool _isLoading = false;

    private async Task OnImportCompletedAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCompleteAsync()
    {
        _isLoading = true;
        try
        {
            await OnComplete.InvokeAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
