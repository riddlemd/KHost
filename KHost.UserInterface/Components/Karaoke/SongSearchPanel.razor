@implements IDisposable
@inject ISongSearchService SongSearchService
@inject ISingerQueueService SingerQueueService

<div class="card h-100">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-search"></i>
        <span class="card-title">Song Search</span>
    </div>

    <div class="card-body d-flex flex-column gap-3">

        <div class="panel-form-row">
            <div class="form-grow">
                <label class="form-label" for="song-search-input">Search for Song</label>
                <input type="text" id="song-search-input" class="form-control form-control-sm" placeholder="Type a song name or artist..."
                       autocomplete="off" @bind="_filter" @bind:event="oninput" @onkeydown="OnFilterKeyDownAsync" />
            </div>
            <button id="song-search-btn" class="btn btn-primary btn-sm d-flex align-items-center gap-2"
                    @onclick="RunSearchAsync" disabled="@_searching">
                @if (_searching)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <i class="bi bi-search"></i>
                }
                Search
            </button>
        </div>

        @if (_errorMessage is not null)
        {
            <div class="alert alert-warning py-2 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>@_errorMessage
            </div>
        }

        @if (_results is not null)
        {
            <div class="song-search-results-header">
                <span class="text-caption">
                    @if (_results.Count == 0)
                    {
                        <span>No compatible files found.</span>
                    }
                    else
                    {
                        <i class="bi bi-files me-1"></i>
                        <span>@_results.Count file(s) found@(_results.Count > MaxDisplay ? $" — showing first {MaxDisplay}" : "")</span>
                    }
                </span>
                @if (SingerQueueService.SelectedSingerId is null && _results.Count > 0)
                {
                    <span class="song-search-hint">
                        <i class="bi bi-arrow-left me-1"></i>Select a singer in the queue to add songs
                    </span>
                }
            </div>

            <div class="song-search-results">
                @if (_results.Count == 0)
                {
                    <div class="panel-empty">
                        <i class="bi bi-folder-x"></i>
                        <span>No compatible media files found in that directory.</span>
                    </div>
                }
                else
                {
                    <table id="song-search-results-table" class="table table-sm table-hover table-header-primary mb-0">
                        <thead class="sticky-top">
                            <tr>
                                <th>Name</th>
                                <th>Duration</th>
                                <th id="song-search-col-type">Format</th>
                                <th id="song-search-col-actions">Options</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var songSearchEntity in _results.Take(MaxDisplay))
                            {
                                <tr>
                                    <td class="text-truncate table-cell-fill" title="@songSearchEntity.FilePath">
                                        <i class="bi bi-file-earmark-music me-1 song-search-file-icon"></i>
                                        @songSearchEntity.DisplayName
                                    </td>
                                    <td>--:--</td>
                                    <td>
                                        @songSearchEntity.Format
                                    </td>
                                    <td>
                                        <button class="btn btn-primary btn-sm song-search-add-btn"
                                                disabled="@(SingerQueueService.SelectedSingerId is null)"
                                                @onclick="() => EnqueueSongAsync(songSearchEntity)"
                                                title="Enqueue for selected singer">
                                            <i class="bi bi-plus-lg me-1"></i> Enqueue
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else {
            <div class="panel-empty">
                <i class="bi bi-cassette"></i>
                <span>No songs have been searched for yet.</span>
            </div>
        }
    </div>
</div>

@code {
    private const int MaxDisplay = 200;

    private string _directory = string.Empty;
    private string _filter = string.Empty;
    private bool _searching;
    private List<ISongSearchEntity>? _results;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        _directory = Path.Combine(Environment.ExpandEnvironmentVariables("%USERPROFILE%"), "OneDrive", "Karaoke");
        SingerQueueService.StateChanged += OnStateChanged;
    }

    private async Task RunSearchAsync()
    {
        _errorMessage = null;
        _searching = true;
        _results = null;
        StateHasChanged();

        if (!Directory.Exists(_directory))
        {
            _errorMessage = $"Directory not found: {_directory}";
            _searching = false;
            return;
        }

        _results = await SongSearchService.SearchAsync(_directory, _filter, recursive: true);

        _searching = false;
    }

    private async Task OnFilterKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_searching)
            await RunSearchAsync();
    }

    private async Task EnqueueSongAsync(ISongSearchEntity song)
    {
        if (SingerQueueService.SelectedSingerId is { } singerId)
            await SingerQueueService.AddSongAsync(singerId, song);
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() =>
        SingerQueueService.StateChanged -= OnStateChanged;
}
