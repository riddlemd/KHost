@implements IDisposable
@inject SongSearchService SearchService
@inject SingerQueueService QueueService

<div class="card h-100">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-search"></i>
        <span class="card-title">Song Search</span>
    </div>

    <div class="card-body d-flex flex-column gap-3">

        <div class="panel-form-row">
            <div class="form-grow">
                <label class="form-label" for="search-filter-input">Search for Song</label>
                <input type="text" id="search-filter-input" class="form-control form-control-sm" placeholder="Type a song name or artist..."
                       autocomplete="off" @bind="_filter" @bind:event="oninput" @onkeydown="OnFilterKeyDown" />
            </div>
            <button id="search-btn" class="btn btn-primary btn-sm d-flex align-items-center gap-2"
                    @onclick="RunSearch" disabled="@_searching">
                @if (_searching)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <i class="bi bi-search"></i>
                }
                Search
            </button>
        </div>

        @if (_errorMessage is not null)
        {
            <div class="alert alert-warning py-2 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>@_errorMessage
            </div>
        }

        @if (_results is not null)
        {
            <div class="song-results-header">
                <span class="text-caption">
                    @if (_results.Count == 0)
                    {
                        <span>No compatible files found.</span>
                    }
                    else
                    {
                        <i class="bi bi-files me-1"></i>
                        <span>@_results.Count file(s) found@(_results.Count > MaxDisplay ? $" — showing first {MaxDisplay}" : "")</span>
                    }
                </span>
                @if (QueueService.SelectedSingerId is null && _results.Count > 0)
                {
                    <span class="search-hint">
                        <i class="bi bi-arrow-left me-1"></i>Select a singer in the queue to add songs
                    </span>
                }
            </div>

            <div class="song-results">
                @if (_results.Count == 0)
                {
                    <div class="panel-empty">
                        <i class="bi bi-folder-x"></i>
                        <span>No compatible media files found in that directory.</span>
                    </div>
                }
                else
                {
                    <table id="song-search-results-table" class="table table-sm table-hover table-header-purple mb-0">
                        <thead class="sticky-top">
                            <tr>
                                <th>Name</th>
                                <th id="ssp-col-type">Type</th>
                                <th id="ssp-col-actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var song in _results.Take(MaxDisplay))
                            {
                                var ext = Path.GetExtension(song.FilePath).ToLowerInvariant();
                                var isCdg = ext == ".cdg";
                                <tr>
                                    <td class="text-truncate" title="@song.FilePath">
                                        <i class="bi bi-file-earmark-music me-1 song-file-icon"></i>
                                        @song.DisplayName
                                    </td>
                                    <td>
                                        <span class="badge @(isCdg ? "badge-cdg" : "badge-ext")">@ext[1..]</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-primary btn-sm song-add-btn"
                                                disabled="@(QueueService.SelectedSingerId is null)"
                                                @onclick="() => AddSong(song)"
                                                title="Add to singer">
                                            <i class="bi bi-plus-lg me-1"></i>Add
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else {
            <div class="panel-empty">
                <i class="bi bi-cassette"></i>
                <span>No songs have been searched for yet.</span>
            </div>
        }
    </div>
</div>

@code {
    private const int MaxDisplay = 200;

    private string _directory = string.Empty;
    private string _filter = string.Empty;
    private bool _searching;
    private List<SongFile>? _results;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        _directory = Path.Combine(Environment.ExpandEnvironmentVariables("%USERPROFILE%"), "OneDrive", "Karaoke");
        QueueService.StateChanged += OnStateChanged;
    }

    private async Task RunSearch()
    {
        _errorMessage = null;
        _searching = true;
        _results = null;
        StateHasChanged();

        _results = await Task.Run(() =>
        {
            if (!Directory.Exists(_directory))
                return null;
            return SearchService.Search(_directory, _filter, recursive: true);
        });

        if (_results is null)
            _errorMessage = $"Directory not found: {_directory}";

        _searching = false;
    }

    private async Task OnFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_searching)
            await RunSearch();
    }

    private void AddSong(SongFile song)
    {
        if (QueueService.SelectedSingerId is { } singerId)
            QueueService.AddSong(singerId, song);
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() =>
        QueueService.StateChanged -= OnStateChanged;
}
