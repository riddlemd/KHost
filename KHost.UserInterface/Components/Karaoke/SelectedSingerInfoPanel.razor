@using KHost.Domain.Collections.Generics
@using KHost.UserInterface.Components.Dialogs
@implements IDisposable

<div class="kh-card" tabindex="0" @onkeydown="OnKeyDownAsync" @ref="_card">
    <div class="kh-card__header d-flex align-items-center gap-2">
        <i class="bi bi-queue-music"></i>
        <i class="bi bi-music-note-list"></i>
        @if (SingerQueueService?.SelectedSinger is { } singer)
        {
            <span class="kh-card__title">@singer.Name's Queue</span>
            <span class="kh-badge kh-badge--secondary ms-auto">@_performanceCount</span>
        }
        else
        {
            <span class="kh-card__title">Singer Media Queue</span>
        }
        <div class="kh-selected-singer-info__quick-menu">
            <span class="kh-selected-singer-info__quick-menu__flags">
                <button class="kh-selected-singer-info__quick-menu__flags__toggle-regular-btn kh-button--icon-minimal @(SingerQueueService.SelectedSinger?.IsRegular == false ? " kh-button--off" : "")"
                        title="@(SingerQueueService.SelectedSinger?.IsRegular == true ? "This singer is a Regular!" : "Click to flag this singer as a Regular")"
                        @onclick="() => ToggleIsRegularAsync()">
                    <i class="bi bi-heart-fill kh-selected-singer-info__quick-menu__flags__icon--regular"></i>
                </button>

                <button class="kh-selected-singer-info__quick-menu__toggle-tipper-btn kh-button--icon-minimal @(SingerQueueService.SelectedSinger?.IsTipper == false ? " kh-button--off" : "")"
                        title="@(SingerQueueService.SelectedSinger?.IsTipper == true ? "This singer is a Tipper!" : "Click to flag this singer as a Tipper")"
                        @onclick="() => ToggleIsTipperAsync()">
                    <i class="bi bi-coin kh-selected-singer-info__quick-menu__flags__icon--tipper"></i>
                </button>
            </span>
            
            <button class="kh-selected-singer-info__quick-menu__edit-singer-btn kh-button kh-button--primary" title="Click to view Singer's Performance history"
                    @onclick="OpenPerformanceHistoryDialogAsync" @onclick:stopPropagation>
                <i class="bi bi-music-note-list"></i>
            </button>
            <button class="kh-selected-singer-info__quick-menu__edit-singer-btn kh-button kh-button--primary" title="Click to edit Singer's Profile"
                    @onclick="OpenSingerEditDialogAsync" @onclick:stopPropagation>
                <i class="bi bi-pencil-fill"></i>
            </button>
        </div>
    </div>

    <div class="kh-card__body kh-selected-singer-info__body">
        @if (SingerQueueService.SelectedSinger is null)
        {
            // Do nothing, we should not see this.
        }
        else
        {
            var selected = SingerQueueService.SelectedSinger!;

            if (_performances.Count == 0)
            {
                <div class="kh-panel--empty">
                    <i class="bi bi-music-note-list"></i>
                    <span>No Media queued for @selected.Name yet</span>
                </div>
            }
            else
            {
            <table class="kh-table kh-selected-singer-info__table">
                <thead class="sticky-top">
                    <tr>
                        <th class="kh-selected-singer-info__col--number">#</th>
                        <th>Title</th>
                        <th>Artist</th>
                        <th class="kh-selected-singer-info__col--duration">Duration</th>
                        <th class="kh-selected-singer-info__col--status">Status</th>
                        <th class="kh-selected-singer-info__col--actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (performance, idx) in _performances.Select((p, i) => (p, i)))
                    {
                        var isCurrent = PlaybackService?.CurrentPerformance?.Id == performance.Id;
                        var isSelected = _selectedPerformanceId == performance.Id;
                        var disableMoveUp = idx == 0;
                        var disableMoveDown = idx == _performances.Count - 1;
                        var disableRemove = PlaybackService?.CurrentPerformance?.Id == performance.Id;
                        var rowClass = isSelected ? "kh-selected-singer-info__row--selected" : isCurrent ? "kh-selected-singer-info__row--current" : "";
                        var nameClass = isCurrent ? "kh-selected-singer-info__name--current" : "";
                        var disablePlay = PlaybackService?.CurrentPerformance != null;

                        <tr class="@rowClass" @onclick="() => SelectPerformance(performance.Id)" style="cursor: pointer;">
                            <td class="kh-selected-singer-info__pos kh-table__cell--shrink">
                                @if (isCurrent && PlaybackService?.State == PlaybackState.Playing)
                                {
                                    <div class="kh-np__bars kh-np__bars--sm">
                                        <div class="kh-np__bar"></div>
                                        <div class="kh-np__bar"></div>
                                        <div class="kh-np__bar"></div>
                                    </div>
                                }
                                else
                                {
                                    <span>@(idx + 1)</span>
                                }
                            </td>
                            @{ _mediaCache.TryGetValue(performance.MediaId, out var rowMedia); }
                            <td class="text-truncate kh-selected-singer-info__name kh-table__cell--fill">
                                <span class="@nameClass">@(rowMedia?.Title ?? "—")</span>
                            </td>
                            <td>@(rowMedia?.Artist ?? "")</td>
                            <td class="kh-selected-singer-info__duration kh-table__cell--shrink">
                                @if (rowMedia?.Duration is { } dur)
                                {
                                    @($"{(int)dur.TotalMinutes}:{dur.Seconds:D2}")
                                }
                            </td>
                            <td class="kh-table__cell--shrink">@(rowMedia?.Status)</td>
                            <td class="kh-table__cell--shrink">
                                <button class="kh-selected-singer-info__btn--play kh-button" title="@(disablePlay ? "Cannot Load and Play while another Media is loaded" : "Load and Play")"
                                        disabled="@disablePlay"
                                        @onclick="() => LoadAndPlayAsync(performance)">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                                <button class="kh-selected-singer-info__move-up-btn kh-button--icon-minimal" title="Move up"
                                        disabled="@disableMoveUp"
                                        @onclick="() => PerformanceService.MoveUpInQueueAsync(selected.Id, performance.Id)">
                                    <i class="bi bi-chevron-up"></i>
                                </button>
                                <button class="kh-selected-singer-info__move-down-btn kh-button--icon-minimal" title="Move down"
                                        disabled="@disableMoveDown"
                                        @onclick="() => PerformanceService.MoveDownInQueueAsync(selected.Id, performance.Id)">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                <button class="kh-selected-singer-info__remove-btn kh-button--icon-danger" title="Remove"
                                        disabled="@disableRemove"
                                        @onclick="() => PerformanceService.DeleteAsync(performance.Id)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            }
        }
    </div>
</div>

<SingerPerformanceHistoryDialog @ref="_singerPerformanceHistoryDialog" />
<SingerEditDialog @ref="_singerEditDialog" OnSave="SaveSingerAsync" />

@code {
    [Inject] private ISingerQueueService? SingerQueueService { get; set; }
    [Inject] private IPerformanceService? PerformanceService { get; set; }
    [Inject] private IPlaybackService? PlaybackService { get; set; }
    [Inject] private IMediaSearchService? MediaSearchService { get; set; }
    [Inject] private ISingersService? SingersService { get; set; }
    [Inject] private IMediaService? MediaService { get; set; }

    private ElementReference _card;
    private SingerPerformanceHistoryDialog? _singerPerformanceHistoryDialog;
    private SingerEditDialog? _singerEditDialog;
    private List<Performance> _performances = [];
    private Dictionary<Guid, Media?> _mediaCache = [];
    private int _performanceCount = 0;
    private Guid? _selectedPerformanceId;

    protected override async Task OnInitializedAsync()
    {
        SingerQueueService?.StateChanged += OnStateChanged;
        PerformanceService?.StateChanged += OnStateChanged;
        PlaybackService?.StateChanged += OnStateChanged;
        MediaService?.StateChanged += OnStateChanged;

        await RefreshPerformancesAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (SingerQueueService?.SelectedSinger is null) return;

        var currentIdx = _performances.FindIndex(s => s.Id == _selectedPerformanceId);

        Performance? selectedPerformance = null;

        if (e.Key == "ArrowUp" && currentIdx > 0)
            selectedPerformance = _performances[currentIdx - 1];
        else if (e.Key == "ArrowDown" && currentIdx < _performances.Count - 1)
            selectedPerformance = _performances[currentIdx + 1];

        if (selectedPerformance != null)
            SelectPerformance(selectedPerformance.Id);
    }

    private async Task LoadAndPlayAsync(Performance performance)
    {
        if (PlaybackService is null) return;

        // Prevent loading a new media if one is already playing
        if (PlaybackService.State == PlaybackState.Playing && PlaybackService.CurrentPerformance?.Id != performance.Id)
            return;

        if (!_mediaCache.TryGetValue(performance.MediaId, out var media) || media is null)
            return;

        await PlaybackService.LoadAsync(performance, media);
        await PlaybackService.PlayAsync();
    }

    private async Task OpenPerformanceHistoryDialogAsync()
    {
        if (_singerPerformanceHistoryDialog is null || SingerQueueService?.SelectedSinger is null)
            return;

        await _singerPerformanceHistoryDialog.OpenAsync(SingerQueueService.SelectedSinger.Id);
    }

    private async Task OpenSingerEditDialogAsync()
    {
        if (_singerEditDialog is null || SingerQueueService?.SelectedSinger is null)
            return;

        await _singerEditDialog.OpenAsync(SingerQueueService.SelectedSinger);
    }

    private async Task SaveSingerAsync(SingerEditDialog.SingerEditModel model)
    {
        if (SingerQueueService is null) return;
        if (SingersService is null) return;

        var singer = SingerQueueService.SelectedSinger;
        if (singer is null) return;
        singer.Name = model.Name.Trim();
        singer.Notes = model.Notes;
        singer.IsRegular = model.IsRegular;
        singer.IsTipper = model.IsTipper;
        await SingersService.UpdateAsync(singer);
        await SingerQueueService.RefreshAsync();
    }

    private async Task ToggleIsRegularAsync()
    {
        if (SingerQueueService is null) return;
        if (SingersService is null) return;

        if (SingerQueueService.SelectedSinger is { } singer)
        {
            await SingersService.ToggleIsRegularAsync(singer.Id);
            await SingerQueueService.RefreshAsync();
        }
    }

    private async Task ToggleIsTipperAsync()
    {
        if (SingerQueueService is null) return;
        if (SingersService is null) return;

        if (SingerQueueService.SelectedSinger is { } singer)
        {
            await SingersService.ToggleIsTipperAsync(singer.Id);
            await SingerQueueService.RefreshAsync();
        }
    }

    private void SelectPerformance(Guid performanceId)
    {
        _selectedPerformanceId = performanceId;
        StateHasChanged();
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(async () =>
    {
        await RefreshPerformancesAsync();
        StateHasChanged();
    });

    private async Task RefreshPerformancesAsync()
    {
        if (SingerQueueService is null) return;
        if (PerformanceService is null) return;

        if (SingerQueueService.SelectedSinger is { } singer)
        {
            _performances = (await PerformanceService.GetSingerPerformances(singer.Id)).ToList();
            _performanceCount = _performances.Count;
            if (!_performances.Any(p => p.Id == _selectedPerformanceId))
                _selectedPerformanceId = null;

            // Fetch all media for this singer's performances
            if (_performances.Count > 0 && MediaService is not null)
            {
                var mediaIds = _performances.Select(p => p.MediaId).Distinct().ToList();
                var mediaTasks = mediaIds.Select(id => MediaService.ReadAsync(id)).ToList();
                var mediaResults = await Task.WhenAll(mediaTasks);
                _mediaCache = mediaIds.Zip(mediaResults).ToDictionary(x => x.First, x => x.Second);
            }
            else
            {
                _mediaCache = [];
            }
        }
        else
        {
            _performances = [];
            _performanceCount = 0;
            _selectedPerformanceId = null;
            _mediaCache = [];
        }
    }

    public void Dispose()
    {
        SingerQueueService?.StateChanged    -= OnStateChanged;
        PerformanceService?.StateChanged    -= OnStateChanged;
        PlaybackService?.StateChanged -= OnStateChanged;
        MediaService?.StateChanged -= OnStateChanged;
    }
}
