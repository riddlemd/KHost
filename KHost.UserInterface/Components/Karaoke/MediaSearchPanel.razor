@implements IDisposable

<div class="kh-card">
    <div class="kh-card__header d-flex align-items-center gap-2">
        <i class="bi bi-search"></i>
        <span class="kh-card__title">Media Search</span>
    </div>

    <div class="kh-card__body d-flex flex-column gap-3">

        <div class="kh-panel__form-row">
            <div class="kh-panel__form-grow">
                <label class="form-label">Search</label>
                <input type="text" class="kh-media-search__input form-control form-control-sm" placeholder="Type a Media name or artist..."
                       autocomplete="off" @bind="_query" @bind:event="oninput" @onkeydown="OnFilterKeyDownAsync" />
            </div>
            <button class="kh-media-search__search-btn kh-button kh-button--primary d-flex align-items-center gap-2"
                    @onclick="RunSearchAsync" disabled="@_searching">
                @if (_searching)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <i class="bi bi-search"></i>
                }
                Search
            </button>
        </div>

        @if (_errorMessage is not null)
        {
            <div class="kh-alert--warning py-2 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>@_errorMessage
            </div>
        }

        @if (_results is not null)
        {
            <div class="kh-media-search__results-header">
                @if (SingerQueueService.SelectedSingerId is null && _results.Count > 0)
                {
                    <span class="kh-media-search__hint">
                        <i class="bi bi-arrow-left me-1"></i>Select a singer in the queue to add media
                    </span>
                }
            </div>

            <div class="kh-media-search__results">
                @if (_results.Count == 0)
                {
                    <div class="kh-panel--empty">
                        <i class="bi bi-folder-x"></i>
                        <span>No compatible media files found in that directory.</span>
                    </div>
                }
                else
                {
                    <table class="kh-media-search__results-table kh-table">
                        <thead class="sticky-top">
                            <tr>
                                <th>Name</th>
                                <th>Duration</th>
                                <th class="kh-media-search__col--source">Source</th>
                                <th class="kh-media-search__col--actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mediaSearchEntity in _results.Take(300))
                            {
                                <tr>
                                    <td class="text-truncate kh-table__cell--fill">
                                        @mediaSearchEntity.DisplayName
                                    </td>
                                    <td>--:--</td>
                                    <td>
                                        @mediaSearchEntity.Source
                                    </td>
                                    <td>
                                        @foreach(var action in mediaSearchEntity.SupportedActions)
                                        {
                                            <button class="kh-button kh-button--primary kh-media-search__add-btn"
                                                    disabled="@(SingerQueueService.SelectedSingerId is null)"
                                                    @onclick="() => action.PerformAsync(mediaSearchEntity.ForeignKey)"
                                                    title="Enqueue for selected singer">
                                                @action.DisplayName
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else {
            <div class="kh-panel--empty">
                <i class="bi bi-cassette"></i>
                <span>No media has been searched for yet.</span>
            </div>
        }
    </div>
</div>

@code {
    [Inject] private IMediaSearchService? MediaSearchService { get; set; }
    [Inject] private ISingerQueueService? SingerQueueService { get; set; }
    [Inject] private IPerformanceService? PerformanceService { get; set; }

    private bool _searching;
    private string _query = "";
    private List<MediaSearchEntity>? _results;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        SingerQueueService?.StateChanged += OnStateChanged;
    }

    private async Task RunSearchAsync()
    {
        if (MediaSearchService is null)
            return;

        _errorMessage = null;
        _searching = true;
        _results = null;

        StateHasChanged();

        _results = await MediaSearchService.SearchAsync(_query);

        _searching = false;
    }

    private async Task OnFilterKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_searching)
            await RunSearchAsync();
    }

    private async Task EnqueueMediaAsync(MediaSearchEntity mediaSearchEntity)
    {
        if (PerformanceService is null)
            return;

        if (SingerQueueService?.SelectedSingerId is not { } singerId)
            return;



        await PerformanceService.CreateAndEnqueueAsync(new()
            {
                MediaId = new Guid(mediaSearchEntity.ForeignKey),
                SingerId = singerId
            });
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() =>
        SingerQueueService?.StateChanged -= OnStateChanged;
}
