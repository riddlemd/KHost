@implements IDisposable
@inject SingerQueueService QueueService
@inject PlaybackService PlaybackService

<div class="card h-100" tabindex="0" @onkeydown="OnKeyDown" @ref="_card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-queue-music"></i>
        <i class="bi bi-music-note-list"></i>
        @if (QueueService.SelectedSinger is { } singer)
        {
            <span class="card-title">@singer.Name's Queue</span>
            <span class="badge bg-secondary ms-auto">@singer.SongQueue.Count</span>
        }
        else
        {
            <span class="card-title">Singer Song Queue</span>
        }
        <div class="ssq-singer-flags">
            @if (QueueService.SelectedSinger?.IsPerforming == true)
            {
                <i class="bi bi-music-note singer-is-performing" title="This singer is a Regular!"></i>
            }
            
            @if (QueueService.SelectedSinger?.IsRegular == true)
            {
                <i class="bi bi-heart-fill singer-is-regular" title="This singer is a Regular!"></i>
            }

            @if (QueueService.SelectedSinger?.IsTipper == true)
            {
                <i class="bi bi-coin singer-is-tipper" title="This singer is a Tipper!"></i>
            }
        </div>
    </div>

    <div class="card-body ssq-body">
        @if (QueueService.SelectedSinger is null)
        {
            <div class="panel-empty">
                <i class="bi bi-music-player-fill"></i>
                <span>Select a singer in the Singer Queue to view their queue</span>
            </div>
        }
        else if (QueueService.SelectedSinger.SongQueue.Count == 0)
        {
            <div class="panel-empty">
                <i class="bi bi-music-note-list"></i>
                <span>No songs queued for @QueueService.SelectedSinger.Name yet</span>
            </div>
        }
        else
        {
            var selected = QueueService.SelectedSinger!;
            <table id="singer-song-queue-table" class="table table-sm table-hover table-header-purple mb-0 ssq-table">
                <thead class="sticky-top">
                    <tr>
                        <th id="ssq-col-number">#</th>
                        <th>Song</th>
                        <th id="ssq-col-duration">Duration</th>
                        <th id="ssq-col-status">Status</th>
                        <th id="ssq-col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (song, idx) in selected.SongQueue.Select((q, i) => (q, i)))
                    {
                        var isCurrent = PlaybackService.CurrentSong?.Id == song.Id;
                        var isSelected = QueueService.SelectedSongId == song.Id;
                        var isFirst   = idx == 0;
                        var isLast    = idx == selected.SongQueue.Count - 1;
                        var rowClass  = isSelected ? "ssq-row-selected" : isCurrent ? "ssq-row-current" : song.Status == SongStatus.Played ? "ssq-row-played" : "";
                        var nameClass = isCurrent ? "ssq-name-current" : song.Status == SongStatus.Played ? "ssq-name-played" : "";

                        <tr class="@rowClass" @onclick="() => QueueService.SelectSong(song.Id)" style="cursor: pointer;">
                            <td class="ssq-pos">
                                @if (isCurrent && PlaybackService.State == PlaybackState.Playing)
                                {
                                    <div class="np-bars np-bars-sm">
                                        <div class="np-bar"></div>
                                        <div class="np-bar"></div>
                                        <div class="np-bar"></div>
                                    </div>
                                }
                                else
                                {
                                    <span>@(idx + 1)</span>
                                }
                            </td>
                            <td class="text-truncate ssq-name" title="@song.FilePath">
                                <span class="@nameClass">@song.Song.DisplayName</span>
                            </td>
                            <td class="ssq-duration">
                                @if (song.Song.Duration is { } duration)
                                {
                                    <span>@(((int)duration.TotalMinutes).ToString("D2")):@duration.Seconds.ToString("D2")</span>
                                }
                            </td>
                            <td>
                                @if (song.Status == SongStatus.Playing || isCurrent && PlaybackService.State == PlaybackState.Playing)
                                {
                                    <span class="ssq-badge ssq-badge-playing"><i class="bi bi-play-fill"></i> Playing</span>
                                }
                                else if (song.Status == SongStatus.Played)
                                {
                                    <span class="ssq-badge ssq-badge-played"><i class="bi bi-check"></i> Done</span>
                                }
                                else
                                {
                                    <span class="ssq-badge ssq-badge-pending"><i class="bi bi-clock"></i> Pending</span>
                                }
                            </td>
                            <td class="ssq-actions-cell">
                                <div class="actions-inline">
                                    @if (song.Status != SongStatus.Played)
                                    {
                                        var isPlayingOtherSong = PlaybackService.State == PlaybackState.Playing && PlaybackService.CurrentSong?.Id != song.Id;
                                        <button class="btn btn-sm ssq-btn-play" title="@(isPlayingOtherSong ? "Cannot play while another song is playing" : "Load and play")"
                                                disabled="@isPlayingOtherSong"
                                                @onclick="() => LoadAndPlay(song)">
                                            <i class="bi bi-play-fill"></i>
                                        </button>
                                    }
                                    <button class="btn-icon-minimal" title="Move up"
                                            disabled="@isFirst"
                                            @onclick="() => QueueService.MoveSongUp(selected.Id, song.Id)">
                                        <i class="bi bi-chevron-up"></i>
                                    </button>
                                    <button class="btn-icon-minimal" title="Move down"
                                            disabled="@isLast"
                                            @onclick="() => QueueService.MoveSongDown(selected.Id, song.Id)">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                    <button class="btn-icon-danger" title="Remove"
                                            @onclick="() => QueueService.RemoveSong(selected.Id, song.Id)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private ElementReference _card;

    protected override void OnInitialized()
    {
        QueueService.StateChanged    += OnStateChanged;
        PlaybackService.StateChanged += OnStateChanged;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        var currentIdx = QueueService.SelectedSinger?.SongQueue.FindIndex(s => s.Id == QueueService.SelectedSongId) ?? -1;

        QueuedSong? selectedSong = null;

        if (e.Key == "ArrowUp" && currentIdx > 0)
            selectedSong = QueueService.SelectedSinger?.SongQueue[currentIdx - 1];
        else if (e.Key == "ArrowDown" && currentIdx < QueueService.SelectedSinger?.SongQueue.Count - 1)
            selectedSong = QueueService.SelectedSinger?.SongQueue[currentIdx + 1];

        if (selectedSong != null)
            QueueService.SelectSong(selectedSong.Id);
    }

    private void LoadAndPlay(QueuedSong song)
    {
        // Prevent loading a new song if one is already playing
        if (PlaybackService.State == PlaybackState.Playing && PlaybackService.CurrentSong?.Id != song.Id)
            return;

        PlaybackService.Load(song);
        PlaybackService.Play();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        QueueService.StateChanged    -= OnStateChanged;
        PlaybackService.StateChanged -= OnStateChanged;
    }
}
