@using Microsoft.Extensions.Options
@implements IDisposable
@inject ISingerQueueService SingerQueueService
@inject IPlaybackService PlaybackService
@inject IJSRuntime JS

<div class="card h-100" tabindex="0" @onkeydown="OnKeyDownAsync">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-people-fill"></i>
        <span class="card-title">Singer Queue</span>
        @if (SingerQueueService.Singers.Count > 0)
        {
            <span class="badge bg-secondary ms-auto">@SingerQueueService.Singers.Count</span>
        }
        <span class="card-shortcut">ctrl+1</span>
    </div>
    <div class="add-singer-inputs card-body d-flex flex-column gap-3">
        <form name="add-singer-form" class="panel-form-row" @onsubmit="AddSingerAsync" @onsubmit:preventDefault>
            <input type="text" id="singer-name-input" class="form-control form-grow" placeholder="Type New Singer's Name..."
                   autocomplete="off" @bind="_newSingerName" @bind:event="oninput" />
            <button type="submit" id="singer-add-btn" class="btn btn-primary"
                    disabled="@string.IsNullOrWhiteSpace(_newSingerName)" title="Add Singer to Queue">
                <i class="bi bi-plus-lg"></i>
            </button>
        </form>
    </div>
    <div class="card-body d-flex flex-column gap-3">
        @if (!SingerQueueService.Singers.Any())
        {
            <div class="panel-empty panel-empty-lg">
                <i class="bi bi-person-plus"></i>
                <span>No singers yet. Add one above to get started.</span>
            </div>
        }

        @foreach (var (singer, singerIdx) in SingerQueueService.Singers.Select((s, i) => (s, i)))
        {
            var isFirst = singerIdx == 0;
            var disableMoveUp = isFirst || singer.IsPerforming;
            var disableMoveDown  = singerIdx == SingerQueueService.Singers.Count - 1 || singer.IsPerforming;
            var disableRemove = singer.IsPerforming;

            <div class="singer-card @(SingerQueueService.SelectedSingerId == singer.Id ? "singer-card-selected" : "")" @onclick="() => SingerQueueService.SelectSingerAsync(singer.Id)">
                <div class="singer-icon">
                    @if (isFirst && PlaybackService.CurrentQueuedSong?.Singer.Id == singer.Id && PlaybackService.State == PlaybackState.Playing)
                    {
                        <div class="np-bars np-bars-sm">
                            <div class="np-bar"></div>
                            <div class="np-bar"></div>
                            <div class="np-bar"></div>
                        </div>
                    }
                    else
                    {
                        <i class="bi bi-person-circle"></i>
                    }
                </div>
                <div>
                    <div class="singer-name">@singer.Name</div>
                    <div class="singer-info">
                        @((MarkupString)FormatSongCount(@singer.SongQueue.Count))
                        @FormatEwt(CalculateEwt(singerIdx))
                    </div>
                </div>

                <div class="singer-card-actions">
                    <button class="btn-icon-minimal" title="Move up (Shift+Up)"
                            disabled="@disableMoveUp"
                            @onclick="() => SingerQueueService.MoveSingerUpAsync(singer.Id)"
                            @onclick:stopPropagation>
                        <i class="bi bi-chevron-up"></i>
                    </button>
                    <button class="btn-icon-minimal" title="Move down (Shift+Down)"
                            disabled="@disableMoveDown"
                            @onclick="() => SingerQueueService.MoveSingerDownAsync(singer.Id)"
                            @onclick:stopPropagation>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <button class="btn-icon-danger" title="Remove singer"
                            disabled="@disableRemove"
                            @onclick="() => ConfirmRemoveSingerAsync(singer)"
                            @onclick:stopPropagation>
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _newSingerName = string.Empty;

    protected override void OnInitialized()
    {
        SingerQueueService.StateChanged  += OnStateChanged;
        PlaybackService.StateChanged += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SingerQueueService.SelectedSingerId.HasValue)
            await ScrollToSelectedSingerAsync();
    }

    private async Task AddSingerAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSingerName)) return;
        var singer = await SingerQueueService.AddSingerAsync(_newSingerName.Trim());
        await SingerQueueService.SelectSingerAsync(singer.Id);
        _newSingerName = string.Empty;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var selectedSingerId = SingerQueueService.SelectedSingerId;
        var currentIdx = SingerQueueService.Singers.ToList().FindIndex(s => s.Id == SingerQueueService.SelectedSingerId);

        if (e.ShiftKey && selectedSingerId != null)
        {
            if (e.Key == "ArrowUp" && currentIdx > 0)
                await SingerQueueService.MoveSingerUpAsync(SingerQueueService.SelectedSingerId!.Value);
            else if (e.Key == "ArrowDown" && currentIdx < SingerQueueService.Singers.Count - 1)
                await SingerQueueService.MoveSingerDownAsync(SingerQueueService.SelectedSingerId!.Value);
        }
        else
        {
            ISinger? selectedSinger = null;

            if (e.Key == "ArrowUp" && currentIdx > 0)
                selectedSinger = SingerQueueService.Singers[currentIdx - 1];
            else if (e.Key == "ArrowDown" && currentIdx < SingerQueueService.Singers.Count - 1)
                selectedSinger = SingerQueueService.Singers[currentIdx + 1];

            if(selectedSinger != null)
                await SingerQueueService.SelectSingerAsync(selectedSinger.Id);
        }
    }

    private TimeSpan CalculateEwt(int singerIndex)
    {
        var totalDuration = TimeSpan.Zero;
        for (int i = 0; i < singerIndex; i++)
        {
            var firstSong = SingerQueueService.Singers[i].SongQueue.FirstOrDefault(x => x.Status != QueuedSongStatus.Played);
            if (firstSong?.Song.Duration is { } duration)
                totalDuration += duration;
        }
        return totalDuration;
    }

    private string FormatEwt(TimeSpan duration)
    {
        if (duration.TotalSeconds == 0) return string.Empty;
        return $", EWT: {((int)Math.Floor(duration.TotalMinutes)):D2}:{duration.Seconds:D2}";
    }

    private string FormatSongCount(int songCount)
    {
        var className = "";

        if (songCount <= 0)
            className = "empty-song-queue";

        return $"<span class=\"{className}\">{songCount} song(s) queued<span>";
    }

    private async Task ScrollToSelectedSingerAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollIntoViewSmooth", ".singer-card-selected", -10);
        }
        catch { }
    }

    private async Task ConfirmRemoveSingerAsync(ISinger singer)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Remove {singer.Name} from the queue?");
        if (confirmed)
            await SingerQueueService.RemoveSingerAsync(singer.Id);
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SingerQueueService.StateChanged  -= OnStateChanged;
        PlaybackService.StateChanged -= OnStateChanged;
    }
}
