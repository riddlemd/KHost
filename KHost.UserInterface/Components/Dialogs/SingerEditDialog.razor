@using System.ComponentModel.DataAnnotations
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class?.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="person-fill" /> Edit Singer
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="_model.Name" autofocus />
                <ValidationMessage For="() => _model.Name" />
            </div>
            
            <div class="mb-3">
                <label class="form-label">Notes</label>
                <InputTextArea class="form-control" @bind-Value="_model.Notes" rows="5" />
                <ValidationMessage For="() => _model.Notes" />
            </div>
            
            <div class="mb-3 d-flex gap-4">
                <label class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.IsRegular" />
                    <span class="form-check-label">Regular</span>
                </label>
                <label class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.IsTipper" />
                    <span class="form-check-label">Tipper</span>
                </label>
            </div>

            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CancelAsync">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SaveAsync">Save</button>
    </Footer>
</Dialog>

@code {
    private const string _rootClassName = "kh-singer-edit-dialog";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Singer? Singer { get; set; }
    [Parameter] public bool CloseOnScrimClick { get; set; }
    [Parameter] public string Class { get; set; } = "";

    [Parameter] public EventCallback<Singer> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private SingerEditModel _model = new();
    private EditContext _editContext = default!;
    private bool _prevIsOpen;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_prevIsOpen)
        {
            _model = Singer is null
                    ? new SingerEditModel()
                    : new SingerEditModel
                    {
                        Id = Singer.Id,
                        Name = Singer.Name,
                        Notes = Singer.Notes,
                        IsRegular = Singer.IsRegular,
                        IsTipper = Singer.IsTipper
                    };

            _editContext = new EditContext(_model);
        }
        _prevIsOpen = IsOpen;
    }

    public async Task CloseAsync()
    {
        IsOpen = false;

        await OnClose.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        await OnClose.InvokeAsync();

        await CloseAsync();
    }

    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;

        var singer = Singer ?? new Singer { Id = _model.Id, Name = _model.Name };
        singer.Name = _model.Name;
        singer.Notes = _model.Notes;
        singer.IsRegular = _model.IsRegular;
        singer.IsTipper = _model.IsTipper;

        await OnSave.InvokeAsync(singer);

        await CloseAsync();
    }

    public record DialogRequest : EditDialogRequest<Singer>
    {
        public DialogRequest(Singer? value, Action<Singer?> onSave, Action? onCancel, Action? onClose) : base(value, onSave, onCancel, onClose)
        {
        }
    }
}
