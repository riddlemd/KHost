@page "/venues"
@rendermode InteractiveServer
@implements IDisposable
@inject IVenuesService VenuesService

<PageTitle>KHost &mdash; Manage Venues</PageTitle>

<div class="khost-layout">
    <header class="khost-header">
        <i class="bi bi-headphones khost-logo-icon"></i>
        <span class="khost-logo-text">KHost</span>
        <span class="khost-logo-sep">|</span>
        <span class="khost-logo-sub">Karaoke for the people, by the people.</span>
        <span class="khost-header-manage-venues ms-auto">
            <a href="/" class="btn btn-sm btn-outline-secondary">&#8592; Back to Queue</a>
        </span>
    </header>

    <div class="khost-body">
        <div style="flex: 1; overflow: auto; display: flex; flex-direction: column;">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span class="card-title">Manage Venues</span>
                    @if (VenuesService.Venues.Count > 0)
                    {
                        <span class="badge bg-secondary ms-auto">@VenuesService.Venues.Count</span>
                    }
                </div>
                <div class="card-body">
                    <form class="panel-form-row mb-3" @onsubmit="AddVenueAsync" @onsubmit:preventDefault>
                        <input type="text" class="form-control form-grow" placeholder="Enter venue name..."
                               autocomplete="off" @bind="_newVenueName" @bind:event="oninput" />
                        <button type="submit" class="btn btn-primary"
                                disabled="@string.IsNullOrWhiteSpace(_newVenueName)">
                            <i class="bi bi-plus-lg"></i> Add Venue
                        </button>
                    </form>

                    @if (VenuesService.Venues.Count == 0)
                    {
                        <div class="panel-empty panel-empty-lg">
                            <i class="bi bi-geo-alt"></i>
                            <span>No venues yet. Add one above to get started.</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2 text-muted small">
                            <span>Page @_currentPage of @TotalPages (@VenuesService.Venues.Count total)</span>
                            <span>10 per page</span>
                        </div>

                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Notes</th>
                                    <th>Enabled</th>
                                    <th>Last Updated</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var venue in PagedVenues)
                                {
                                    @if (_editingVenueId == venue.Id)
                                    {
                                        <tr class="table-warning">
                                            <td><input type="text" class="form-control form-control-sm" @bind="_editName" /></td>
                                            <td><input type="text" class="form-control form-control-sm" @bind="_editNotes" /></td>
                                            <td><input type="checkbox" class="form-check-input" @bind="_editEnabled" /></td>
                                            <td class="text-muted small">@venue.LastUpdated.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-success me-1" @onclick="SaveEditAsync">Save</button>
                                                <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">Cancel</button>
                                            </td>
                                        </tr>
                                    }
                                    else if (_deletingVenueId == venue.Id)
                                    {
                                        <tr class="table-danger">
                                            <td colspan="4" class="fw-semibold">Remove <em>@venue.Name</em>? This cannot be undone.</td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-danger me-1" @onclick="ConfirmDeleteAsync">Confirm</button>
                                                <button class="btn btn-sm btn-secondary" @onclick="CancelDelete">Cancel</button>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>@venue.Name</td>
                                            <td class="text-muted">@venue.Notes</td>
                                            <td>
                                                @if (venue.Enabled)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td class="text-muted small">
                                                @(venue.LastUpdated == default ? "—" : venue.LastUpdated.ToString("yyyy-MM-dd HH:mm"))
                                            </td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(venue)">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => StartDelete(venue)">
                                                    <i class="bi bi-trash"></i> Remove
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                        @if (TotalPages > 1)
                        {
                            <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                                <button class="btn btn-sm btn-outline-secondary" disabled="@(_currentPage <= 1)" @onclick="PreviousPage">
                                    &#8592; Prev
                                </button>
                                <span class="px-2">@_currentPage</span>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage">
                                    Next &#8594;
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const int PageSize = 10;

    private int _currentPage = 1;
    private string _newVenueName = "";
    private Guid? _editingVenueId;
    private string _editName = "";
    private string _editNotes = "";
    private bool _editEnabled;
    private Guid? _deletingVenueId;

    private int TotalPages => (int)Math.Ceiling(VenuesService.Venues.Count / (double)PageSize);

    private IEnumerable<IVenue> PagedVenues =>
        VenuesService.Venues.Skip((_currentPage - 1) * PageSize).Take(PageSize);

    protected override void OnInitialized()
    {
        VenuesService.StateChanged += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AddVenueAsync()
    {
        if (string.IsNullOrWhiteSpace(_newVenueName)) return;
        await VenuesService.AddVenueAsync(_newVenueName.Trim());
        _newVenueName = "";
        _currentPage = 1;
    }

    private void StartEdit(IVenue venue)
    {
        _editingVenueId = venue.Id;
        _editName = venue.Name;
        _editNotes = venue.Notes;
        _editEnabled = venue.Enabled;
        _deletingVenueId = null;
        _newVenueName = "";
    }

    private void CancelEdit() => _editingVenueId = null;

    private async Task SaveEditAsync()
    {
        if (_editingVenueId is null) return;
        await VenuesService.UpdateVenueAsync(_editingVenueId.Value, _editName, _editNotes, _editEnabled);
        _editingVenueId = null;
    }

    private void StartDelete(IVenue venue)
    {
        _deletingVenueId = venue.Id;
        _editingVenueId = null;
        _newVenueName = "";
    }

    private void CancelDelete() => _deletingVenueId = null;

    private async Task ConfirmDeleteAsync()
    {
        if (_deletingVenueId is null) return;
        await VenuesService.RemoveVenueAsync(_deletingVenueId.Value);
        _deletingVenueId = null;
        if (_currentPage > TotalPages && TotalPages > 0)
            _currentPage = TotalPages;
        else if (TotalPages == 0)
            _currentPage = 1;
    }

    private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
    private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        VenuesService.StateChanged -= OnStateChanged;
    }
}
