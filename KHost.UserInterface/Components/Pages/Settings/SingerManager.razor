@page "/settings/singers-manager"
@rendermode InteractiveServer
@implements IDisposable
@using KHost.UserInterface.Components.Dialogs

<PageTitle>KHost &mdash; Manage Singers</PageTitle>

<div class="kh-app">
    <header class="kh-app__header">
        <i class="bi bi-headphones kh-app__logo-icon"></i>
        <span class="kh-app__logo-text">KHost</span>
        <span class="kh-app__logo-sep">|</span>
        <span class="kh-app__logo-sub">Karaoke for the people, by the people.</span>
        <span class="kh-app__manage-singers ms-auto">
            <a href="/" class="kh-button kh-button--outline-secondary">&#8592; Back to Queue</a>
        </span>
    </header>

    <div class="kh-app__body">
        <div style="flex: 1; overflow: auto; display: flex; flex-direction: column;">
            <div class="kh-card h-100">
                <div class="kh-card__header d-flex align-items-center gap-2">
                    <i class="bi bi-person-fill"></i>
                    <span class="kh-card__title">Singers Manager</span>
                    @if (FilteredSingers.Count > 0)
                    {
                        <span class="kh-badge kh-badge--secondary">@FilteredSingers.Count</span>
                    }
                    <button class="kh-singers__add-btn kh-button kh-button--primary ms-auto" @onclick="OpenAddDialogAsync" type="button">
                        <i class="bi bi-plus-lg"></i> Add Singer
                    </button>
                </div>
                <div class="kh-card__body">
                    <form class="kh-panel__form-row mb-3" @onsubmit:preventDefault>
                        <input type="text" class="form-control kh-panel__form-grow" placeholder="Search singers..."
                               autocomplete="off" @bind="_searchQuery" @bind:event="oninput" />
                        <button type="button" class="kh-singers__clear-search-btn kh-button kh-button--primary" @onclick="ClearSearch"
                                disabled="@string.IsNullOrWhiteSpace(_searchQuery)">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
                <div class="kh-card__body">
                    @if (_singers?.Count == 0)
                    {
                        <div class="kh-panel--empty kh-panel--empty-lg">
                            <i class="bi bi-person"></i>
                            <span>No singers yet. Add one using the button above to get started.</span>
                        </div>
                    }
                    else if (FilteredSingers.Count == 0)
                    {
                        <div class="kh-panel--empty kh-panel--empty-lg">
                            <i class="bi bi-search"></i>
                            <span>No singers match your search.</span>
                        </div>
                    }
                    else
                    {
                        <div class="kh-pagination__menu">
                            <span>Page @_currentPage of @TotalPages (@FilteredSingers.Count filtered)</span>
                            <span>10 per page</span>
                        </div>

                        <table class="kh-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Notes</th>
                                    <th>Regular</th>
                                    <th>Tipper</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var singer in PagedSingers)
                                {
                                    <tr>
                                        <td>@singer.Name</td>
                                        <td>@singer.Notes</td>
                                        <td class="kh-table__cell--shrink">
                                            @if (singer.IsRegular)
                                            {
                                                <span class="kh-badge kh-badge--success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="kh-badge kh-badge--secondary">No</span>
                                            }
                                        </td>
                                        <td class="kh-table__cell--shrink">
                                            @if (singer.IsTipper)
                                            {
                                                <span class="kh-badge kh-badge--success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="kh-badge kh-badge--secondary">No</span>
                                            }
                                        </td>
                                        <td class="kh-table__cell--shrink">
                                            <button class="kh-singers__edit-btn kh-button--icon-minimal" @onclick="() => OpenEditDialogAsync(singer)" type="button">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="kh-singers__delete-btn kh-button--icon-minimal" @onclick="() => StartDeleteAsync(singer)" type="button">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (TotalPages > 1)
                        {
                            <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                                <button class="kh-singers__prev-page-btn kh-button kh-button--outline-secondary" disabled="@(_currentPage <= 1)" @onclick="PreviousPage" type="button">
                                    &#8592; Prev
                                </button>
                                <span class="px-2">@_currentPage</span>
                                <button class="kh-singers__next-page-btn kh-button kh-button--outline-secondary" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage" type="button">
                                    Next &#8594;
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <SingerEditDialog @ref="_singerEditDialog" OnSave="SaveAsync" />
    <ConfirmationDialog @ref="_deleteSingerDialog" Verb="Delete" Message="@_confirmationMessage" OnConfirm="DeleteAsync" />
</div>

@code {
    [Inject] private ISingersService? SingersService { get; set; }

    private SingerEditDialog? _singerEditDialog;
    private ConfirmationDialog? _deleteSingerDialog;
    private const int PageSize = 10;
    private int _currentPage = 1;
    private string _searchQuery = "";
    private Singer? _dialogSinger;
    private string _confirmationMessage = "";
    private IReadOnlyList<Singer>? _singers;

    private List<Singer> FilteredSingers
    {
        get
        {
            if (_singers?.Count == 0)
                return [];

            if (string.IsNullOrWhiteSpace(_searchQuery))
                return _singers?.ToList() ?? [];

            var lowerQuery = _searchQuery.ToLowerInvariant();
            return (_singers ?? [])
                .Where(s => s.Name.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase) ||
                           s.Notes.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private int TotalPages => (int)Math.Ceiling(FilteredSingers.Count / (double)PageSize);

    private IEnumerable<Singer> PagedSingers =>
        FilteredSingers.Skip((_currentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        var result = await SingersService.ReadAllAsync(pageSize: 1000);
        _singers = result.Items;
        SingersService.StateChanged += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenAddDialogAsync()
    {
        if (_singerEditDialog is null)
            return;

        await _singerEditDialog.OpenAsync();
    }

    private async Task OpenEditDialogAsync(Singer singer)
    {
        if (_singerEditDialog is null)
            return;

        await _singerEditDialog.OpenAsync(singer);
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _currentPage = 1;
    }

    private async Task SaveAsync(SingerEditDialog.SingerEditModel model)
    {
        if (SingersService is null)
            return;

        var existingSinger = await SingersService.ReadAsync(model.Id);

        var singer = new Singer
        {
            Id = model.Id,
            Name = model.Name.Trim(),
            Notes = model.Notes.Trim(),
            IsRegular = model.IsRegular,
            IsTipper = model.IsTipper
        };

        if (existingSinger is null)
        {
            await SingersService.CreateAsync(singer);
        }
        else
        {
            await SingersService.UpdateAsync(singer);
        }
    }

    private async Task StartDeleteAsync(Singer singer)
    {
        if (_deleteSingerDialog is null)
            return;

        _dialogSinger = singer;
        _confirmationMessage = $"Are you sure you want to delete {singer.Name}? This cannot be undone.";

        await _deleteSingerDialog.OpenAsync();
    }

    private async Task DeleteAsync()
    {
        if (_dialogSinger is null) return;
        if (SingersService is null) return;

        await SingersService.DeleteAsync(_dialogSinger.Id);
        _dialogSinger = null;

        if (_currentPage > TotalPages && TotalPages > 0)
            _currentPage = TotalPages;
        else if (TotalPages == 0)
            _currentPage = 1;
    }

    private void PreviousPage() { if (_currentPage > 1) _currentPage--; }
    private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        var result = await SingersService.ReadAllAsync(pageSize: 1000);
        _singers = result.Items;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SingersService?.StateChanged -= OnStateChanged;
    }
}
