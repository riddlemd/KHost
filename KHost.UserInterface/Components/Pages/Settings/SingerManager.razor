@page "/settings/singers-manager"
@rendermode InteractiveServer
@implements IDisposable
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<PageTitle>KHost &mdash; Manage Singers</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <div class="kh-card h-100">
            <div class="kh-card__header d-flex align-items-center gap-2">
                <span class="kh-card__title"><Icon Name="person-fill" /> Singers Manager</span>
                <button class="kh-button kh-button--primary ms-auto" @onclick="OpenAddDialogAsync" type="button">
                    <Icon Name="plus-lg" /> Add Singer
                </button>
            </div>
            <div class="kh-card__body">
                <form class="kh-panel__form-row mb-3" @onsubmit:preventDefault>
                    <input type="text" class="form-control kh-panel__form-grow" placeholder="Search singers..."
                            autocomplete="off" @bind="_searchQuery" @bind:event="oninput" @onchange="OnSearchChanged" />
                </form>
            </div>
            <div class="kh-card__body">
                @if (_paginatedResult?.Items.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        @if (string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <Icon Name="person" />
                            <span>No singers yet. Add one using the button above to get started.</span>
                        }
                        else
                        {
                            <Icon Name="search" />
                            <span>No singers match your search.</span>
                        }
                    </div>
                }
                else
                {
                    <table class="kh-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Notes</th>
                                <th>Regular</th>
                                <th>Tipper</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var singer in _paginatedResult!.Items)
                            {
                                <tr>
                                    <td class="kh-table__cell--fill">@singer.Name</td>
                                    <td class="kh-table__cell--fill">@singer.Notes</td>
                                    <td class="kh-table__cell--centered"><Icon Name="@(singer.IsRegular ? "check" : "")" /></td>
                                    <td class="kh-table__cell--centered"><Icon Name="@(singer.IsTipper ? "check" : "")" /></td>
                                    <td class="kh-table__cell--actions">
                                        <button class="kh-singer-manager__edit-btn kh-button--icon-minimal" title="Edit Singer" @onclick="() => OpenEditDialogAsync(singer)">
                                            <Icon Name="pencil" />
                                        </button>
                                        <button class="kh-singer-manager__history-btn kh-button--icon-minimal" title="View Performance History" @onclick="() => OpenPerformanceHistoryAsync(singer)">
                                            <Icon Name="music-note-list" />
                                        </button>
                                        <button class="kh-singer-manager__delete-btn kh-button--icon-minimal" title="Delete Singer" @onclick="@(async () => await StartDeleteAsync(singer))">
                                            <Icon Name="trash" />
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <Pagination
                        CurrentPage="_currentPage"
                        TotalPages="@(_paginatedResult?.TotalPages ?? 0)"
                        OnPreviousPage="PreviousPage"
                        OnNextPage="NextPage" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private ISingersService? SingersService { get; set; }
    [Inject] private IDialogService? DialogService { get; set; }

    private const int PageSize = 2;
    private int _currentPage = 1;
    private string _searchQuery = "";
    private PaginatedResult<Singer>? _paginatedResult;

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();

        SingersService!.StateChanged += OnStateChanged;
    }

    private async Task SearchAsync()
    {
        if (SingersService is null)
            return;

        _paginatedResult = await SingersService.SearchAsync(_searchQuery, pageNumber: _currentPage, pageSize: PageSize);
    }

    private async Task OnSearchChanged()
    {
        _currentPage = 1;

        await SearchAsync();
    }

    private async Task OpenAddDialogAsync()
    {
        await DialogService!.RequestEditAsync(new Singer { Name = "" }, async singer => await SaveAsync(singer));
    }

    private async Task OpenEditDialogAsync(Singer singer)
    {
        await DialogService!.RequestEditAsync(singer, async updated => await SaveAsync(updated));
    }

    private async Task OpenPerformanceHistoryAsync(Singer singer)
    {
        await DialogService!.ShowSingerPerformanceHistoryAsync(singer.Id);
    }

    private async Task SaveAsync(Singer? singer)
    {
        if (SingersService is null || singer is null)
            return;

        var existing = await SingersService.ReadAsync(singer.Id);
        if (existing is null)
            await SingersService.CreateAsync(singer);
        else
            await SingersService.UpdateAsync(singer);
    }

    private async Task StartDeleteAsync(Singer singer)
    {
        if (DialogService is null) return;
        if (SingersService is null) return;

        bool confirmed = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete <span class=\"kh-emphasis\">{singer.Name}</span>?",
            async () => await SingersService.DeleteAsync(singer.Id),
            "Delete Singer",
            "Delete"
        );
    }

    private async Task ClearSearch()
    {
        _searchQuery = "";
        _currentPage = 1;

        await SearchAsync();
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;

            await SearchAsync();
        }
    }

    private async Task NextPage()
    {
        if (_currentPage < (_paginatedResult?.TotalPages ?? 0))
        {
            _currentPage++;

            await SearchAsync();
        }
    }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        await SearchAsync();

        var totalPages = _paginatedResult?.TotalPages ?? 0;

        if (_paginatedResult?.Items.Count == 0 && _currentPage > 1)
        {
            _currentPage = Math.Max(1, totalPages);

            await SearchAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SingersService?.StateChanged -= OnStateChanged;
    }
}
