@page "/"
@using KHost.UserInterface.Components.Dialogs
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>KHost &mdash; Karaoke Queue</PageTitle>

@if (_showingSplash)
{
    <LoadingSplash />
}

<div class="kh-app" tabindex="0" @onkeydown="OnGlobalKeyDown">

    <header class="kh-app__header">
        <i class="bi bi-headphones kh-app__logo-icon"></i>
        <span class="kh-app__logo-text">KHost</span>
        <span class="kh-app__logo-sep">|</span>
        <span class="kh-app__logo-sub">Karaoke for the people, by the people.</span>
        <span class="kh-app__venue-selector">
            Venue:
            <select class="form-select form-select-sm" @onchange="OnVenueChanged">
                @if (_venues?.Count > 0)
                {
                    @foreach (var venue in _venues)
                    {
                        <option value="@venue.Id" selected="@(VenuesService.SelectedVenueId == venue.Id)">@venue.Name</option>
                    }
                }
                else
                {
                    <option>No venues available</option>
                }
            </select>
        </span>
        <span class="kh-app__theme-selector">
            Theme:
            <select class="kh-theme-select form-select"></select>
        </span>
        <span class="kh-app__settings-btn">
            <button class="kh-app__open-settings-btn kh-button--icon-minimal" title="Open Settings Menu" @onclick="OpenSettingsDialogAsync">
                <i class="bi bi-gear-fill" style="font-size:2em"></i>
            </button>
        </span>
    </header>

    <div class="kh-app__body">

        <!-- Left column: Singer Queue -->
        <div class="kh-app__col--queue" tabindex="0">
            <SingerQueuePanel />
        </div>

        <!-- Vertical resize handle -->
        <div class="kh-resize-handle--v">
            <div class="kh-resize-handle__grip--v"></div>
        </div>

        <!-- Right column -->
        <div class="kh-app__col--detail">
            @if (QueueService.SelectedSinger is null)
            {
                <div class="kh-panel--empty">
                    <i class="bi bi-arrow-left"></i>
                    <span>@(QueueService.Singers.Count == 0 ? "Add a singer to the Singer Queue to continue." : "Select a singer in the Singer Queue to continue.")</span>
                </div>
            }
            else
            {
                <!-- Top-right: Now Playing -->
                <div class="kh-app__nowplaying" tabindex="0">
                    <NowPlayingPanel />
                </div>

                <!-- Bottom-right: Media Search -->
                <div class="kh-app__search" tabindex="0">
                    <MediaSearchPanel />
                </div>

                <!-- Horizontal resize handle -->
                <div class="kh-resize-handle--h">
                    <div class="kh-resize-handle__grip--h"></div>
                </div>

                <!-- Singer Media Queue detail -->
                <div class="kh-app__singer-detail" tabindex="0">
                    <SelectedSingerInfoPanel />
                </div>
            }
        </div>
    </div>

    <div class="kh-app__footer">
        <AppStatusBar />
    </div>

    <SettingsMenuDialog @ref="_settingsDialog" />
</div>

@code {
    [Inject] private IJSRuntime? JS { get; set; }
    [Inject] private ISingerQueueService? QueueService { get; set; }
    [Inject] private IVenuesService? VenuesService { get; set; }

    private SettingsMenuDialog? _settingsDialog;
    private bool _showingSplash = true;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private IReadOnlyList<Venue>? _venues;

    protected override async Task OnInitializedAsync()
    {
        var result = await VenuesService.ReadAllAsync(pageSize: 1000);
        _venues = result.Items;
        VenuesService.StateChanged += OnVenueStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await JS.InvokeAsync<IJSObjectReference>("import", "/js/prevent-zoom.js");
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/panel-resize.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>("init");
            await JS.InvokeVoidAsync("window.themeInit");
        }
        catch
        {
            // Do nothing...
        }

        await Task.Delay(1);

        _showingSplash = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVenueChanged(ChangeEventArgs e)
    {
        if (e.Value is string venueIdStr && Guid.TryParse(venueIdStr, out var venueId))
        {
            await VenuesService.SelectVenueAsync(venueId);
        }
        else
        {
            await VenuesService.SelectVenueAsync(null);
        }
    }

    private async void OnVenueStateChanged(object? sender, EventArgs e)
    {
        var result = await VenuesService.ReadAllAsync(pageSize: 1000);
        _venues = result.Items;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenSettingsDialogAsync()
    {
        if (_settingsDialog is null)
            return;

        await _settingsDialog.OpenAsync();
    }

    private async Task OnGlobalKeyDown(KeyboardEventArgs e)
    {
        var element = await JS.InvokeAsync<IJSObjectReference>("import", "/js/focus-utils.js");

        if (e.CtrlKey)
        {
            switch (e.Key.ToLower())
            {
                case "1":
                    await element.InvokeVoidAsync("focusSingerInput");
                    break;
                case "2":
                    await element.InvokeVoidAsync("focusSingerDetail");
                    break;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        VenuesService.StateChanged -= OnVenueStateChanged;
        try {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch
        {
            // Do nothing...
        }
    }
}
