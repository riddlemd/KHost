@rendermode InteractiveServer
@using KHost.Abstractions.Services
@implements IAsyncDisposable

@code {
    [Inject] private ISetupService? SetupService { get; set; }
    [Inject] private NavigationManager? Navigation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var setupRequired = !(await SetupService!.IsSetupCompleteAsync());

        if (setupRequired && !Navigation!.Uri.Contains("/setup", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/setup", forceLoad: false);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await Task.CompletedTask;
    }
}
