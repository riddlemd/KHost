{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://*:5251",
  "FFmpegPath": null,
  "Plugins": {
    "MediaDirectory": null
  },
  "PluginCatalog": {
    "Url": "https://raw.githubusercontent.com/riddlemd/KHost/master/catalog.json",
    "CacheLifetime": "06:00:00"
  },
  "MediaFileParsingService": {
    "Format": "ArtistFirst",
    "Separators": [
      " - ",
      " \u2013 ",
      " \u2014 "
    ],
    "PrefixStripPatterns": [
      "^\\[.*?\\]\\s*",
      "^(?:Track\\s+)?\\d+(?:\\s*[.\\)]\\s+|\\s+-\\s+)"
    ],
    "TitleNoisePatterns": [
      "\\s*[\\(\\[]\\s*karaoke(?:\\s+version)?\\s*[\\)\\]]\\s*$",
      "\\s*[\\(\\[]\\s*official(?:\\s+(?:music\\s+)?video)?\\s*[\\)\\]]\\s*$",
      "\\s*[\\(\\[]\\s*hd\\s*[\\)\\]]\\s*$",
      "\\s*[\\(\\[]\\s*lyrics?\\s*[\\)\\]]\\s*$",
      "\\s*[\\(\\[]\\s*instrumental\\s*[\\)\\]]\\s*$"
    ],
    "FeaturingPattern": "\\s*[\\(\\[]?\\s*(?:feat|ft|featuring)\\.?\\s+(.+?)\\s*[\\)\\]]?\\s*$",
    "FeaturingHandling": "MoveToNotes",
    "FallbackArtistName": "Unknown Artist"
  }
}
