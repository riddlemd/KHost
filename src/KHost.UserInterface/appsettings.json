{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Audio": {
    "Volume": 1.0
  },
  "FFmpegPath": null,
  "MediaFileParsingService": {
    "Format": "ArtistFirst",
    "Separators": [ " - ", " – ", " — " ],
    "PrefixStripPatterns": [
      "^\\[.*?\\]\\s*",
      "^(?:Track\\s+)?\\d+(?:\\s*[.\\)]\\s+|\\s+-\\s+)"
    ],
    "TitleNoisePatterns": [
      "\\s*[\\(\\[]\\s*karaoke(?:\\s+version)?\\s*[\\)\\]]\\s*$",
      "\\s*[\\(\\[]\\s*official(?:\\s+(?:music\\s+)?video)?\\s*[\\)\\]]\\s*$",
      "\\s*[\\(\\[]\\s*hd\\s*[\\)\\]]\\s*$",
      "\\s*[\\(\\[]\\s*lyrics?\\s*[\\)\\]]\\s*$",
      "\\s*[\\(\\[]\\s*instrumental\\s*[\\)\\]]\\s*$"
    ],
    "FeaturingPattern": "\\s*[\\(\\[]?\\s*(?:feat|ft|featuring)\\.?\\s+(.+?)\\s*[\\)\\]]?\\s*$",
    "FeaturingHandling": "MoveToNotes",
    "FallbackArtistName": "Unknown Artist"
  }
}
