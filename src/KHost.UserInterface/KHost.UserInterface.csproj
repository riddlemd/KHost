<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--
      Debug only, and only this project. Since .NET 6 `dotnet run` starts the app through a
      per-project apphost that is re-signed ad-hoc on every build, so each build is a different
      application as far as macOS is concerned — and a keychain item only its creator may read
      therefore prompts on every rebuild (dotnet/sdk#22544). Running through the shared `dotnet`
      host instead gives one stable identity across builds.

      Not Screen2: LocalScreenProvider launches it by executable path, and it has no keychain of
      its own to be prompted for. Not Release either, where a published KHost is a real signed
      executable and is the identity the keychain should be trusting.
    -->
    <UseAppHost Condition="'$(Configuration)' == 'Debug'">false</UseAppHost>
    <RepositoryUrl>https://github.com/riddlemd/KHost</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/riddlemd/KHost</PackageProjectUrl>
    <SignAssembly>False</SignAssembly>
    <Title>KHost</Title>
    <Description>Open source karaoke software</Description>
    <PackageTags>karaoke, entertainment, music, songs, performance, performing</PackageTags>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <EnforceCodeStyleInBuild>False</EnforceCodeStyleInBuild>
    <UserSecretsId>3cc5ab26-24c3-4200-8c4f-9035c6d49c07</UserSecretsId>
    <RunWorkingDirectory>$(OutputPath)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Photino.NET" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Compiles co-located *.razor.scss before Blazor rewrites scoped selectors; a plain
         MSBuild target is too late, since scoped css is discovered from evaluation-time items. -->
    <PackageReference Include="AspNetCore.SassCompiler" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KHost.Common\KHost.Common.csproj" />
    <ProjectReference Include="..\KHost.DataAccess\KHost.DataAccess.csproj" />
    <ProjectReference Include="..\KHost.ServiceDefaults\KHost.ServiceDefaults.csproj" />
    <ProjectReference Include="..\KHost.Abstractions\KHost.Abstractions.csproj" />
    <ProjectReference Include="..\KHost.Domain\KHost.Domain.csproj" />
    <ProjectReference Include="..\KHost.Telemetry\KHost.Telemetry.csproj" />
    <ProjectReference Include="..\KHost.Cast\KHost.Cast.csproj" />
    <ProjectReference Include="..\KHost.IPC.SignalR\KHost.IPC.SignalR.csproj" />
    <ProjectReference Include="..\KHost.Screen2\KHost.Screen2.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\themes\" />
  </ItemGroup>

  <!-- Read server-side (AppInfoService) via Assembly.GetManifestResourceStream for the About page —
       never served as a static file, so the appliance lockdown's Release restrictions don't apply. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="legal/LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="legal/THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="..\..\licenses\Apache-2.0.txt" LogicalName="legal/Apache-2.0.txt" />
    <EmbeddedResource Include="..\..\licenses\LGPL-2.1.txt" LogicalName="legal/LGPL-2.1.txt" />
    <EmbeddedResource Include="..\..\licenses\SIL-OFL-1.1.txt" LogicalName="legal/SIL-OFL-1.1.txt" />
  </ItemGroup>

  <!-- SCSS is compiled by AspNetCore.SassCompiler; npm only stages vendor scripts. -->
  <Target Name="CopyVendorScripts" BeforeTargets="Build">
    <Exec Command="npm run copy:vendors" ContinueOnError="false" />
  </Target>


  <!-- Copy wwwroot to output directory to mimic standalone release -->
  <Target Name="CopyWwwrootToOutput" AfterTargets="Build">
    <ItemGroup>
      <WwwrootFiles Include="wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- CopyScreen2ToOutput only runs after Build, so publish emitted an apphost with no managed dll
       and none of the natives — IsAvailable saw the apphost and offered a screen that died on
       launch. A file copy cannot fix it: a self-contained publish pulls natives from runtime packs
       that never appear in the screen's build output, so the screen publishes itself here. -->
  <Target Name="PublishScreenWithHost" AfterTargets="Publish">
    <PropertyGroup>
      <!-- Two-arg GetFullPath leaves PublishDir alone when already rooted (dotnet publish -o) and
           anchors it to this project otherwise. -->
      <_HostPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))</_HostPublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\KHost.Screen2\KHost.Screen2.csproj" Targets="Publish" Properties="Configuration=$(Configuration);&#xA;                         TargetFramework=$(TargetFramework);&#xA;                         RuntimeIdentifier=$(RuntimeIdentifier);&#xA;                         SelfContained=$(SelfContained);&#xA;                         PublishDir=$(_HostPublishDir)" />
  </Target>

  <!-- The screen is a separate executable, so the host has to carry a copy of it. -->
  <Target Name="CopyScreen2ToOutput" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\KHost.Screen2\KHost.Screen2.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform);BaseOutputPath=$(BaseOutputPath)">
      <Output TaskParameter="TargetOutputs" ItemName="_Screen2Exe" />
    </MSBuild>
    <PropertyGroup>
      <Screen2OutputDir>@(_Screen2Exe->'%(RootDir)%(Directory)')</Screen2OutputDir>
    </PropertyGroup>
    <ItemGroup>
      <Screen2Files Include="$(Screen2OutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Screen2Files)" DestinationFiles="@(Screen2Files->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>


  <!-- The song backgrounds shipped with KHost. Copied beside the binary, which is where
       BackgroundPackService looks for them; a host's own folder is added to these, not instead. -->
  <ItemGroup>
    <Content Include="backgrounds\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KHost.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
