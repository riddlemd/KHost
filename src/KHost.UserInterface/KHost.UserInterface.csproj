<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RepositoryUrl>https://github.com/riddlemd/KHost</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/riddlemd/KHost</PackageProjectUrl>
    <SignAssembly>False</SignAssembly>
    <Title>KHost</Title>
    <Description>Open source karaoke software</Description>
    <PackageTags>karaoke, entertainment, music, songs, performance, performing</PackageTags>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <EnforceCodeStyleInBuild>False</EnforceCodeStyleInBuild>
    <UserSecretsId>3cc5ab26-24c3-4200-8c4f-9035c6d49c07</UserSecretsId>
    <RunWorkingDirectory>$(OutputPath)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Compiles co-located *.razor.scss before Blazor rewrites scoped selectors; a plain
         MSBuild target is too late, since scoped css is discovered from evaluation-time items. -->
    <PackageReference Include="AspNetCore.SassCompiler" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KHost.DataAccess\KHost.DataAccess.csproj" />
    <ProjectReference Include="..\KHost.ServiceDefaults\KHost.ServiceDefaults.csproj" />
    <ProjectReference Include="..\KHost.Abstractions\KHost.Abstractions.csproj" />
    <ProjectReference Include="..\KHost.Domain\KHost.Domain.csproj" />
    <ProjectReference Include="..\KHost.Telemetry\KHost.Telemetry.csproj" />
    <ProjectReference Include="..\KHost.IPC.SignalR\KHost.IPC.SignalR.csproj" />
    <ProjectReference Include="..\KHost.Screen\KHost.Screen.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\themes\" />
  </ItemGroup>

  <!-- SCSS is compiled by AspNetCore.SassCompiler; npm only stages vendor scripts. -->
  <Target Name="CopyVendorScripts" BeforeTargets="Build">
    <Exec Command="npm run copy:vendors" ContinueOnError="false" />
  </Target>


  <!-- Copy wwwroot to output directory to mimic standalone release -->
  <Target Name="CopyWwwrootToOutput" AfterTargets="Build">
    <ItemGroup>
      <WwwrootFiles Include="wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Copy Screen executable and all dependencies into output directory -->
  <Target Name="CopyScreenToOutput" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\KHost.Screen\KHost.Screen.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform);BaseOutputPath=$(BaseOutputPath)">
      <Output TaskParameter="TargetOutputs" ItemName="_ScreenExe" />
    </MSBuild>
    <PropertyGroup>
      <ScreenOutputDir>@(_ScreenExe->'%(RootDir)%(Directory)')</ScreenOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <ScreenFiles Include="$(ScreenOutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ScreenFiles)"
          DestinationFiles="@(ScreenFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
