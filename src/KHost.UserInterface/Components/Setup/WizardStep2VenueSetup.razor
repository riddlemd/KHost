@using KHost.Abstractions.Models
@using KHost.Abstractions.Services
@using KHost.UserInterface.Models

<div class="kh-setup-wizard__step">
    <div class="kh-setup-wizard__header">
        <h2>Configure Venue</h2>
        <p>Set up your primary karaoke venue.</p>
    </div>

    <EditForm EditContext="_editContext" OnValidSubmit="OnNextAsync">
        <DataAnnotationsValidator />

        <div class="kh-setup-wizard__form">
            <div class="kh-form-group">
                <label for="venue-name" class="kh-form-label">Venue Name</label>
                <span class="kh-form-hint">Up to 32 characters.</span>
                <InputText id="venue-name"
                           class="kh-form-control"
                           placeholder="e.g., Main Hall, Karaoke Bar"
                           @bind-Value="_model.Name"
                           disabled="@_isLoading" />
                <ValidationMessage For="() => _model.Name" />
            </div>

            <div class="kh-form-group">
                <div class="kh-venue-settings__section">
                    <span class="kh-venue-settings__section-title">Playback</span>
                    <div class="kh-venue-settings__row">
                        <label for="default-volume" class="kh-form-label">Default Volume</label>
                        <InputNumber id="default-volume"
                                     class="kh-form-control"
                                     @bind-Value="_model.DefaultVolume"
                                     min="0"
                                     max="100"
                                     disabled="@_isLoading" />
                    </div>
                </div>

                <div class="kh-venue-settings__section">
                    <span class="kh-venue-settings__section-title">Queue behavior</span>

                    <label class="kh-venue-settings__row kh-form-check">
                        <span class="kh-form-check-label">Clear queue when closing</span>
                        <InputCheckbox class="kh-form-check-input" @bind-Value="_model.ClearQueueOnClose" />
                    </label>
                </div>

                <div class="kh-venue-settings__section">
                    <span class="kh-venue-settings__section-title">Require confirmation when removing</span>

                    <div class="kh-venue-settings__prompt-grid">
                        <label class="kh-venue-settings__prompt-item kh-form-check">
                            <span class="kh-venue-settings__prompt-item-label">
                                <Icon Name="person-x-fill" />
                                <span class="kh-form-check-label">Singer from queue</span>
                            </span>
                            <InputCheckbox class="kh-form-check-input" @bind-Value="_model.PromptBeforeRemovingSinger" />
                        </label>
                        <label class="kh-venue-settings__prompt-item kh-form-check">
                            <span class="kh-venue-settings__prompt-item-label">
                                <Icon Name="music-note-beamed" />
                                <span class="kh-form-check-label">Song from queue</span>
                            </span>
                            <InputCheckbox class="kh-form-check-input" @bind-Value="_model.PromptBeforeRemovingPerformance" />
                        </label>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_serverError))
        {
            <div class="kh-alert kh-alert--danger">
                @_serverError
            </div>
        }

        <div class="kh-setup-wizard__actions">
            <button class="kh-button kh-button--primary"
                    disabled="@_isLoading"
                    type="submit">
                <Icon Name="arrow-right" /> Next
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Inject] private IVenuesService? VenuesService { get; set; }

    [Parameter]
    public EventCallback OnComplete { get; set; }

    private SetupVenueModel _model = new();
    private EditContext _editContext = default!;
    private string _serverError = string.Empty;
    private bool _isLoading = false;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    private async Task OnNextAsync()
    {
        _serverError = string.Empty;
        _isLoading = true;

        try
        {
            var venue = new Venue
            {
                Name = _model.Name,
                Enabled = true,
                Settings = new()
                {
                    DefaultVolume = _model.DefaultVolume,
                    PromptBeforeRemovingSinger = _model.PromptBeforeRemovingSinger,
                    PromptBeforeRemovingPerformance = _model.PromptBeforeRemovingPerformance,
                    ClearQueueOnClose = _model.ClearQueueOnClose,
                }
            };
            var createdVenue = await VenuesService!.CreateAsync(venue);
            await VenuesService.SelectVenueAsync(createdVenue.Id);
            await OnComplete.InvokeAsync();
        }
        catch (Exception ex)
        {
            _serverError = $"Failed to create venue: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
