<div class="kh-setup-wizard__step">
    <div class="kh-setup-wizard__header">
        <h2>Security</h2>
        <p>Decide whether KHost asks for a sign-in.</p>
    </div>

    <div class="kh-setup-wizard__form kh-wizard-security">
        <label class="kh-wizard-security__choice">
            <input type="checkbox" class="kh-form-check-input" checked="@_requireLogin"
                   @onchange="e => _requireLogin = (bool)(e.Value ?? true)" />
            <span class="kh-wizard-security__label">
                Require sign-in to use KHost
                <span class="kh-wizard-security__hint">
                    Operators sign in with a name and password; what each account may do is set
                    per group.
                </span>
            </span>
        </label>

        <p class="kh-wizard-security__off-note">
            Turned off, anyone at this machine has full control — fine for a machine that never
            leaves your booth. It can be changed later in App Settings.
        </p>

        <div class="kh-setup-wizard__actions">
            <button type="button" class="kh-button kh-button--primary" @onclick="OnNextAsync">
                <Icon Name="arrow-right" /> Next
            </button>
        </div>
    </div>
</div>
