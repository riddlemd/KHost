@using KHost.UserInterface.Services

<span class="kh-venue-selector input">
    Venue
    <DropdownMenu Class="kh-venue-selector__dropdown" Title="Switch or edit the current venue">
        <Trigger>@(_selected?.Name ?? "No venues available")</Trigger>
        <Items>
            <span class="kh-dropdown__heading">Switch venue</span>

            @if (_venues?.Count > 0)
            {
                @foreach (var venue in _venues)
                {
                    var isSelected = venue.Id == VenuesService?.SelectedVenueId;

                    <button class="kh-dropdown__item @(isSelected ? "kh-dropdown__item--selected" : "")"
                            @onclick="() => SwitchVenueAsync(venue.Id)">
                        <span class="kh-dropdown__check">
                            @if (isSelected)
                            {
                                <Icon Name="check2" />
                            }
                        </span>
                        @venue.Name
                    </button>
                }
            }
            else
            {
                <span class="kh-dropdown__empty">No venues available</span>
            }

            <div class="kh-dropdown__divider"></div>

            <button class="kh-dropdown__item" disabled="@(_selected is null)" @onclick="OpenEditDialogAsync">
                <span class="kh-dropdown__check"><Icon Name="sliders" /></span>
                Edit venue…
            </button>
            <button class="kh-dropdown__item" @onclick="GoToVenuesManager">
                <span class="kh-dropdown__check"><Icon Name="geo-alt" /></span>
                Manage venues…
            </button>
        </Items>
    </DropdownMenu>
</span>
