@using KHost.Abstractions.Models

@if (Analysers.Any())
{
    <optgroup label="Built-in">
        @foreach (var preset in Analysers)
        {
            <option value="@VisualisationLookEditor.PresetKey(preset.Source, preset.Name)">@(preset.Title ?? preset.Name)</option>
        }
    </optgroup>
}
@if (Ambient.Any())
{
    <optgroup label="Ambient">
        @foreach (var preset in Ambient)
        {
            <option value="@VisualisationLookEditor.PresetKey(preset.Source, preset.Name)">@(preset.Title ?? preset.Name)</option>
        }
    </optgroup>
}
@if (Retro.Any())
{
    <optgroup label="Retro">
        @foreach (var preset in Retro)
        {
            <option value="@VisualisationLookEditor.PresetKey(preset.Source, preset.Name)">@(preset.Title ?? preset.Name)</option>
        }
    </optgroup>
}
<optgroup label="MilkDrop presets">
    @foreach (var preset in Presets.Where(p => p.Source == VisualiserPresetSource.Bundled))
    {
        <option value="@VisualisationLookEditor.PresetKey(preset.Source, preset.Name)">@preset.Name</option>
    }
</optgroup>
@if (Presets.Any(p => p.Source == VisualiserPresetSource.Imported))
{
    <optgroup label="Imported">
        @foreach (var preset in Presets.Where(p => p.Source == VisualiserPresetSource.Imported))
        {
            <option value="@VisualisationLookEditor.PresetKey(preset.Source, preset.Name)">@preset.Name</option>
        }
    </optgroup>
}
