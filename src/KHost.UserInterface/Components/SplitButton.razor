<div class="kh-split-btn @Class" @ref="_rootRef">
    <button
        class="kh-split-btn__primary kh-button"
        disabled="@(Disabled || PrimaryDisabled)"
        title="@Title"
        @onclick="OnClick">
        @Text
    </button>
    <button class="kh-split-btn__toggle kh-button"
        disabled="@Disabled"
        aria-haspopup="listbox" aria-expanded="@_open"
        title="Click to show more options"
        @onclick="ToggleMenu" @onclick:stopPropagation>
        <Icon Name="@(_open ? "chevron-up" : "chevron-down")" />
    </button>

    @if (_open)
    {
        <div class="kh-split-btn__overlay" @onclick="CloseMenu"></div>
    }

    @* Rendered closed as well as open: whether there is anything to open is a question only the
       markup can answer — a caller's menu may be a list that came back empty, or an AuthorizeView
       that drew nothing — and the toggle beside it is hidden off exactly that. *@
    <div class="kh-split-btn__menu" hidden="@(!_open)" @ref="_menuRef" @onclick="CloseMenu">
        @Buttons
    </div>
</div>
