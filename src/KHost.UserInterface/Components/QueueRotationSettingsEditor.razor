@using KHost.Abstractions.Services.QueueRotation
@using KHost.Plugins.Sdk.Models.QueueRotation
@using KHost.Plugins.Sdk.Services.QueueRotation

<div class="kh-venue-settings kh-queue-rotation">
    <div class="kh-venue-settings__section kh-venue-settings__section--head">
        <span class="kh-venue-settings__section-title">Mode</span>
        <div class="kh-venue-settings__row">
            <label class="kh-form-label" for="rotation-mode">Rotation mode</label>
            <select id="rotation-mode" class="kh-form-select" @bind="Config.StrategyId">
                @foreach (var mode in _modes)
                {
                    <option value="@mode.Id">@mode.Name</option>
                }
            </select>
        </div>
        <p class="kh-queue-rotation__hint">@ModeDescription</p>

        @if (Config.StrategyId == "fifo")
        {
            <div class="kh-venue-settings__row">
                <label class="kh-form-label" for="drop-position">Finished singer drops to</label>
                <select id="drop-position" class="kh-form-select" @bind="Config.DropPosition">
                    <option value="@DropPositionMode.End">End of queue</option>
                    <option value="@DropPositionMode.FixedIndex">Fixed position</option>
                    <option value="@DropPositionMode.RandomBackHalf">Random spot in the back half</option>
                    <option value="@DropPositionMode.LeavesQueue">Leaves the queue</option>
                </select>
            </div>
            @if (Config.DropPosition == DropPositionMode.FixedIndex)
            {
                <div class="kh-venue-settings__row">
                    <label class="kh-form-label" for="drop-index">Fixed position (0 = front)</label>
                    <input id="drop-index" type="number" min="0" class="kh-form-control" @bind="Config.DropFixedIndex" />
                </div>
            }
        }

        @if (Config.StrategyId == "weighted-fair")
        {
            <div class="kh-venue-settings__row">
                <label class="kh-form-label" for="wait-weight">Wait time weight</label>
                <input id="wait-weight" type="number" step="0.1" class="kh-form-control" @bind="Config.WeightedFairWaitWeight" />
            </div>
            <div class="kh-venue-settings__row">
                <label class="kh-form-label" for="song-weight">Song count weight</label>
                <input id="song-weight" type="number" step="0.1" class="kh-form-control" @bind="Config.WeightedFairSongCountWeight" />
            </div>
        }
    </div>

    <div class="kh-venue-settings__section">
        <span class="kh-venue-settings__section-title">Modifiers</span>
        <p class="kh-queue-rotation__hint">A value of 0 or (none) leaves a modifier off.</p>

        <div class="kh-venue-settings__row">
            <label class="kh-form-label" for="vip-group">VIP group (always sorted first)</label>
            <select id="vip-group" class="kh-form-select" @bind="VipGroupIdString">
                <option value="">(none)</option>
                @foreach (var group in _groups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
        </div>

        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">Boost first-time singers</span>
            <input type="checkbox" class="kh-form-check-input" @bind="Config.FirstTimeBoostEnabled" />
        </label>
        @if (Config.FirstTimeBoostEnabled)
        {
            <div class="kh-venue-settings__row">
                <label class="kh-form-label" for="boost-slots">Boost by slots</label>
                <input id="boost-slots" type="number" min="1" class="kh-form-control" @bind="Config.FirstTimeBoostSlots" />
            </div>
        }

        <div class="kh-venue-settings__row">
            <label class="kh-form-label" for="cooldown">Cool-down slots after singing</label>
            <input id="cooldown" type="number" min="0" class="kh-form-control" @bind="Config.CoolDownSlots" />
        </div>

        <div class="kh-venue-settings__row">
            <label class="kh-form-label" for="tip-bump">Tip bump window (minutes)</label>
            <input id="tip-bump" type="number" min="0" class="kh-form-control" @bind="Config.TipBumpWindowMinutes" />
        </div>

        <div class="kh-venue-settings__row">
            <label class="kh-form-label" for="time-box">Time-box per singer (minutes)</label>
            <input id="time-box" type="number" min="0" class="kh-form-control" @bind="Config.TimeBoxMinutes" />
        </div>

        <div class="kh-venue-settings__row">
            <label class="kh-form-label" for="no-show-demote">No-show demotion (slots)</label>
            <input id="no-show-demote" type="number" min="0" class="kh-form-control" @bind="Config.NoShowDemoteSlots" />
        </div>
        @if (Config.NoShowDemoteSlots > 0)
        {
            <div class="kh-venue-settings__row">
                <label class="kh-form-label" for="no-show-max">No-show max misses</label>
                <input id="no-show-max" type="number" min="1" class="kh-form-control" @bind="Config.NoShowMaxMisses" />
            </div>
        }

        <div class="kh-venue-settings__row">
            <label class="kh-form-label" for="anchor-singer">Anchor singer</label>
            <select id="anchor-singer" class="kh-form-select" @bind="AnchorSingerIdString">
                <option value="">(none)</option>
                @foreach (var user in _users)
                {
                    <option value="@user.Id">@user.Name</option>
                }
            </select>
        </div>
        @if (Config.AnchorSingerId is not null)
        {
            <div class="kh-venue-settings__row">
                <label class="kh-form-label" for="anchor-every">Anchor every Nth slot</label>
                <input id="anchor-every" type="number" min="0" class="kh-form-control" @bind="Config.AnchorEveryN" />
            </div>
        }

        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">Only rotate singers seen recently (presence)</span>
            <input type="checkbox" class="kh-form-check-input" @bind="Config.PresenceRequired" />
        </label>
        @if (Config.PresenceRequired)
        {
            <div class="kh-venue-settings__row">
                <label class="kh-form-label" for="presence-window">Presence window (minutes)</label>
                <input id="presence-window" type="number" min="1" class="kh-form-control" @bind="Config.PresenceWindowMinutes" />
            </div>
        }
    </div>
</div>

@code {
    [Inject] private IQueueRotationStrategyFactory? StrategyFactory { get; set; }
    [Inject] private IUserGroupsService? UserGroupsService { get; set; }
    [Inject] private IUsersService? UsersService { get; set; }

    [Parameter, EditorRequired] public QueueRotationConfig Config { get; set; } = new();

    private IReadOnlyList<IQueueRotationMode> _modes = [];
    private List<KHostUserGroup> _groups = [];
    private List<KHostUser> _users = [];

    private string ModeDescription => _modes.FirstOrDefault(m => m.Id == Config.StrategyId)?.Description ?? "";

    private string VipGroupIdString
    {
        get => Config.VipGroupId?.ToString() ?? "";
        set => Config.VipGroupId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string AnchorSingerIdString
    {
        get => Config.AnchorSingerId?.ToString() ?? "";
        set => Config.AnchorSingerId = Guid.TryParse(value, out var id) ? id : null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (StrategyFactory is null || UserGroupsService is null || UsersService is null)
            return;

        _modes = StrategyFactory.GetAllModes();

        var groups = await UserGroupsService.ReadAllAsync(pageSize: 1000);
        _groups = groups.Items.OrderBy(g => g.Name).ToList();

        var users = await UsersService.ReadAllAsync(pageSize: 1000);
        _users = users.Items.OrderBy(u => u.Name).ToList();
    }
}
