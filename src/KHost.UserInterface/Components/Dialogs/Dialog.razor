@inject IJSRuntime JS

<Scrim IsOpen="IsOpen" OnClick="OnScrimClick">
    <div class="@($"{_rootClassName} {Class?.Trim()}".Trim())" @ref="_dialogRef" @onclick:stopPropagation>
        <div class="@(_rootClassName)__header">
            <span>@Header</span>
            <button class="@(_rootClassName)__close-btn kh-button--icon-minimal" @onclick="CloseAsync" type="button"><Icon Name="x-lg" /></button>
        </div>
        <div class="@(_rootClassName)__body">
            @Body
        </div>
        <div class="@(_rootClassName)__footer">
            @Footer
        </div>
    </div>
</Scrim>

@code {
    private const string _rootClassName = "kh-dialog";
    private ElementReference _dialogRef;
    private bool _prevIsOpen;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool CloseOnScrimClick { get; set; }
    [Parameter] public string Class { get; set; } = "";

    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    public async Task CloseAsync()
    {
        IsOpen = false;

        await OnClose.InvokeAsync();
    }

    private async Task OnScrimClick()
    {
        if (!CloseOnScrimClick) return;

        await CloseAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_prevIsOpen)
            await JS.InvokeVoidAsync("focusFirstInput", _dialogRef);

        _prevIsOpen = IsOpen;
    }
}
