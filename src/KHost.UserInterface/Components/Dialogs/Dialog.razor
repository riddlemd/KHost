<Scrim IsOpen="IsOpen" OnClick="OnScrimClickAsync">
    <div class="@($"{_rootClassName} {Class?.Trim()}".Trim())" @ref="_dialogRef" @onclick:stopPropagation>
        <div class="@(_rootClassName)__header">
            <span>@Header</span>
            <button class="@(_rootClassName)__close-btn kh-button--icon-minimal" @onclick="CloseAsync" type="button"><Icon Name="x-lg" /></button>
        </div>
        <div class="@(_rootClassName)__body">
            @Body
        </div>
        @if (Footer is not null)
        {
            <div class="@(_rootClassName)__footer">
                @Footer
            </div>
        }
    </div>
</Scrim>
