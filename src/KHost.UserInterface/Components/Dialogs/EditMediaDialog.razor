@using System.ComponentModel.DataAnnotations
@using KHost.Abstractions.Models
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="music-note-beamed" /> Edit Media
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div >
                <label class="kh-form-label">Title</label>
                <InputText class="kh-form-control" @bind-Value="_model.Title" autofocus />
                <ValidationMessage For="() => _model.Title" />
            </div>
            <div >
                <div class="@(_rootClassName)__label-row">
                    <label class="kh-form-label">Artist</label>
                    <button type="button"
                            class="@(_rootClassName)__swap-btn kh-button--icon-minimal"
                            title="Swap Title and Artist"
                            @onclick="SwapTitleAndArtist">
                        <Icon Name="arrow-down-up" />
                    </button>
                </div>
                <InputText class="kh-form-control" @bind-Value="_model.Artist" />
                <ValidationMessage For="() => _model.Artist" />
            </div>
            <div >
                <label class="kh-form-label">Notes</label>
                <InputTextArea class="kh-form-control" @bind-Value="_model.Notes" rows="6" />
                <ValidationMessage For="() => _model.Notes" />
            </div>
            <div >
                <label class="kh-form-label">File Path</label>
                <input type="text" class="kh-form-control" readonly value="@Media?.FilePath" />
            </div>
            <div>
                <label class="kh-form-label">Status</label>
                <div class="@(_rootClassName)__status">
                    <span class="kh-badge @MediaStatusDisplay.BadgeClass(_model.Status)">@_model.Status</span>

                    @if (MediaStatusDisplay.IsUserSettable(_model.Status))
                    {
                        <button type="button"
                                class="@(_rootClassName)__status-btn kh-button @(_model.Status == MediaStatus.Ready ? "kh-button--danger" : "kh-button--secondary")"
                                title="@(_model.Status == MediaStatus.Ready
                                    ? "Flag this song as unplayable — it stays in the library but can't be queued"
                                    : "Clear the broken flag and allow this song to be queued again")"
                                @onclick="ToggleBroken">
                            @(_model.Status == MediaStatus.Ready ? "Mark as broken" : "Mark as ready")
                        </button>
                    }
                </div>
            </div>
            @if (MediaFormats.IsImage(Media?.Format))
            {
                <div>
                    <label for="edit-media-scaling" class="kh-form-label">How it fills the screen</label>
                    <select id="edit-media-scaling" class="kh-form-select" @bind="_model.ImageScaling">
                        <option value="@ImageScaling.Fit">Fit — show all of it</option>
                        <option value="@ImageScaling.Fill">Fill — crop the overflow</option>
                        <option value="@ImageScaling.Stretch">Stretch — distort to fit</option>
                        <option value="@ImageScaling.Original">Original size</option>
                    </select>
                </div>
            }

            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CloseAsync" type="button">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SubmitAsync" type="button">Save</button>
    </Footer>
</Dialog>
