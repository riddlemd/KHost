@using KHost.Abstractions.Models
@using KHost.Abstractions.Services
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class?.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="clock-history" /> Performance History
    </Header>
    <Body>
        @if (_paginatedPerformances?.Items.Count > 0)
        {
            <div class="@(_rootClassName)__table-wrapper">
                <table class="kh-table">
                    <thead>
                        <tr>
                            <th>Media</th>
                            <th>Artist</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var perf in _paginatedPerformances.Items.OrderByDescending(p => p.CreatedDate))
                        {
                            // Kept even when the song is gone from the library — the performance is
                            // still real history, and hiding the row leaves no way to delete it.
                            var media = _media.FirstOrDefault(m => m.Id == perf.MediaId);
                            var isReady = media?.Status == MediaStatus.Ready;
                            var enqueueDescription = media is null
                                ? "This song is no longer in the library"
                                : isReady ? "Add to Singer's Queue" : media.Status.ToString();

                            <tr>
                                <td class="kh-table__cell--fill">
                                    @if (media is null)
                                    {
                                        <span class="@(_rootClassName)__missing-media">
                                            <Icon Name="exclamation-triangle-fill" /> Song no longer in library
                                        </span>
                                    }
                                    else
                                    {
                                        @media.Title
                                    }
                                </td>
                                <td class="kh-table__cell--fill">@(media?.Artist ?? "—")</td>
                                <td>@perf.CreatedDate.ToString("g")</td>
                                <td class="kh-table__cell--actions">
                                    <SplitButton
                                            PrimaryDisabled="@(!isReady)"
                                            @onclick="async () => await EnqueueAsync(media!)"
                                            title="@enqueueDescription">
                                        <Text><Icon Name="plus-lg" /></Text>
                                        <Buttons>
                                            <button class="@(_rootClassName)__edit-media-btn kh-button"
                                                    disabled="@(media is null)"
                                                    @onclick="() => EditAsync(media!)"
                                                    title="Edit song associated with this performance">
                                                <Icon Name="pencil-fill" /> Edit
                                            </button>
                                            <button class="@(_rootClassName)__enqueue-btn kh-button"
                                                    @onclick="() => ConfirmDeleteAsync(perf.Id)"
                                                    title="Delete this performance">
                                                <Icon Name="x-lg" /> Delete
                                            </button>
                                        </Buttons>
                                    </SplitButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pagination CurrentPage="_currentPage"
                        TotalPages="TotalPages"
                        OnPreviousPage="PreviousPage"
                        OnNextPage="NextPage" />
        }
        else
        {
            <p class="@(_rootClassName)__empty">No performances found.</p>
        }
    </Body>
    <Footer>
        <button class="kh-button kh-button--primary" @onclick="CloseAsync" type="button">Close</button>
    </Footer>
</Dialog>

