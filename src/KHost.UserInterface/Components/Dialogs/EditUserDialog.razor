@using KHost.Common.Monetary
@using System.ComponentModel.DataAnnotations
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class?.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="person-fill" /> Edit User
    </Header>
    <Body>
        <div class="@(_rootClassName)__layout">
        <div class="@(_rootClassName)__main">
        <EditForm EditContext="_editContext" OnSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div >
                <label class="kh-form-label">Name</label>
                <InputText class="kh-form-control" @bind-Value="_model.Name" autofocus />
                <ValidationMessage For="() => _model.Name" />
            </div>

            <div >
                <label class="kh-form-label">Notes</label>
                <InputTextArea class="kh-form-control" @bind-Value="_model.Notes" rows="5" />
                <ValidationMessage For="() => _model.Notes" />
            </div>

            <div >
                <label class="kh-form-label">Password</label>
                <InputText type="password" class="kh-form-control" @bind-Value="_newPassword"
                           placeholder="@(_hasPassword ? "Unchanged unless typed" : "No password — cannot sign in")"
                           autocomplete="new-password" />
            </div>

            <div>
                <label class="kh-form-label">Groups</label>
                @if (_availableGroups.Count == 0)
                {
                    <div class="@(_rootClassName)__groups-empty">No groups defined yet.</div>
                }
                else
                {
                    <div class="@(_rootClassName)__groups">
                        @foreach (var group in _availableGroups)
                        {
                            <label class="@(_rootClassName)__group">
                                <input type="checkbox" class="kh-form-check-input" checked="@_model.SelectedGroupIds.Contains(group.Id)"
                                       @onchange="e => ToggleGroup(group.Id, (bool)(e.Value ?? false))" />
                                <span class="@(_rootClassName)__group-name">@group.Name</span>
                                <span class="@(_rootClassName)__group-description">@group.Description</span>
                            </label>
                        }
                    </div>
                }
            </div>

            <button type="submit" class="kh-hidden"></button>
        </EditForm>
        </div>

        @if (_isExistingUser)
        {
            <aside class="@(_rootClassName)__stats">
                <section class="@(_rootClassName)__stats-section">
                    <span class="@(_rootClassName)__stats-title">Total tips</span>
                    <span class="@(_rootClassName)__stats-figure">@_totalTips.ToCurrency()</span>
                </section>

                <section class="@(_rootClassName)__stats-section">
                    <span class="@(_rootClassName)__stats-title">Recent venues</span>
                    @if (_recentVenues.Count == 0)
                    {
                        <span class="@(_rootClassName)__stats-empty">No venues recorded yet.</span>
                    }
                    else
                    {
                        <ul class="@(_rootClassName)__stats-list">
                            @foreach (var venue in _recentVenues)
                            {
                                <li class="@(_rootClassName)__stats-item">
                                    <span class="@(_rootClassName)__stats-primary">@venue.Name</span>
                                    <span class="@(_rootClassName)__stats-secondary">@venue.LastSungOn.ToLocalTime().ToString("d MMM yyyy")</span>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="@(_rootClassName)__stats-section">
                    <span class="@(_rootClassName)__stats-title">Recent songs</span>
                    @if (_recentSongs.Count == 0)
                    {
                        <span class="@(_rootClassName)__stats-empty">No songs sung yet.</span>
                    }
                    else
                    {
                        <ul class="@(_rootClassName)__stats-list">
                            @foreach (var song in _recentSongs)
                            {
                                <li class="@(_rootClassName)__stats-item">
                                    <span class="@(_rootClassName)__stats-primary">@song.Title</span>
                                    <span class="@(_rootClassName)__stats-secondary">
                                        @(string.IsNullOrWhiteSpace(song.Artist) ? song.SungOn.ToLocalTime().ToString("d MMM") : $"{song.Artist} · {song.SungOn.ToLocalTime():d MMM}")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </aside>
        }
        </div>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CancelAsync">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SaveAsync">Save</button>
    </Footer>
</Dialog>

