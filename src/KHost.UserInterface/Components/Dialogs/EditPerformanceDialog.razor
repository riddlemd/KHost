@using KHost.Common.Chronography
@using KHost.UserInterface.Components.Panels

<Dialog IsOpen="IsOpen" Class="@_rootClassName" OnClose="CloseAsync">
    <Header>
        <Icon Name="pencil-square" /> Edit Performance
    </Header>
    <Body>
        @if (!string.IsNullOrWhiteSpace(Media?.Title))
        {
            <div class="@(_rootClassName)__song">
                <span class="@(_rootClassName)__song-glyph"><Icon Name="music-note-beamed" /></span>
                <span class="@(_rootClassName)__song-words">
                    <span class="@(_rootClassName)__title" title="@Media!.Title">@Media.Title</span>
                    @if (!string.IsNullOrWhiteSpace(Media.Artist))
                    {
                        <span class="@(_rootClassName)__artist">@Media.Artist</span>
                    }
                </span>
                @if (Media.Duration is { } length)
                {
                    <span class="@(_rootClassName)__length">@length.ToTotalMinutesAndSeconds()</span>
                }
            </div>
        }

        @* Shown, never an input: the singer wrote it, and the host reads it. *@
        @if (!string.IsNullOrWhiteSpace(Performance?.SingerNotes))
        {
            <div class="@(_rootClassName)__singer-notes">
                <span class="kh-form-label">From the singer</span>
                <p class="@(_rootClassName)__singer-notes-text">@Performance!.SingerNotes</p>
            </div>
        }

        @if (_allowAliases)
        {
            <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" class="@($"{_rootClassName}__alias")">
                <DataAnnotationsValidator />

                <label for="edit-performance-sung-as" class="kh-form-label">Singing As</label>
                <InputText id="edit-performance-sung-as" class="kh-form-control" @bind-Value="_alias.SungAs"
                           placeholder="@SingerName" disabled="@_loaded" />
                @if (_loaded)
                {
                    <span class="kh-note @(_rootClassName)__alias-locked">
                        This song is at the microphone. Its name was announced when it started.
                    </span>
                }
                else
                {
                    <span class="kh-note">
                        Blank uses @_fallbackName. Only announced where the venue allows aliases.
                    </span>
                }
                <ValidationMessage For="() => _alias.SungAs" />

                <button type="submit" class="kh-hidden"></button>
            </EditForm>
        }

        <SongControlList Style="@AppSettings.Current.SongControlStyle" Tracks="@_tracks" Values="@_values"
                         Disabled="@_loaded" />

        @if (_offersBackground)
        {
            <div class="@(_rootClassName)__background">
                <label for="edit-performance-background" class="kh-form-label">Background</label>
                <select id="edit-performance-background" class="kh-form-select" disabled="@_loaded"
                        value="@_backgroundChoice" @onchange="ChooseBackground">
                    <option value="@BackgroundChoice.Venue">Venue's playlist</option>
                    <option value="@BackgroundChoice.Black">Black</option>
                    <option value="@BackgroundChoice.Look">Custom</option>
                </select>
                <p class="kh-note">
                    Drawn on the screen under the words of a song with no picture of its own.
                </p>

                @if (_backgroundChoice == BackgroundChoice.Look)
                {
                    <VisualisationLookEditor Look="_look" Presets="_presets" Disabled="_loaded" />
                }
            </div>
        }

        @if (_loaded)
        {
            <p class="kh-note @(_rootClassName)__locked">
                This song is loaded now. Change it with the song controls while it plays.
            </p>
        }
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CloseAsync" type="button">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SubmitAsync" type="button"
                disabled="@_loaded">Save</button>
    </Footer>
</Dialog>
