@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using KHost.Abstractions.Models
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class?.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="people-fill" /> Edit Group
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div >
                <label class="kh-form-label">Name</label>
                <InputText class="kh-form-control" @bind-Value="_model.Name" autofocus />
                <ValidationMessage For="() => _model.Name" />
            </div>

            <div >
                <label class="kh-form-label">Description</label>
                <InputTextArea class="kh-form-control" @bind-Value="_model.Description" rows="3" />
                <ValidationMessage For="() => _model.Description" />
            </div>

            <div >
                <label class="kh-form-check">
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.IsAdmin" />
                    <span class="kh-form-check-label">Admin (all permissions)</span>
                </label>
            </div>

            <div >
                <label class="kh-form-check">
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.ExcludeFromSingerQueue" />
                    <span class="kh-form-check-label">Not A Singer (leave out of the singer queue)</span>
                </label>
            </div>

            <div class="kh-card">
                <div class="kh-card__header">
                    <span class="kh-card__title">Permissions</span>
                </div>
                <div class="kh-card__body" @ref="_permissionsTableElement">
                    <table class="kh-table" @attributes="_permissionsTableAttrs">
                        <thead>
                            <tr>
                                <th style="width: 40px;"></th>
                                <th>Permission</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in GetGroupedPermissions())
                            {
                                <tr class="kh-table__group-header">
                                    <td colspan="3">@group.Key</td>
                                </tr>
                                @foreach (var permission in group)
                                {
                                    var isChecked = _model.Permissions.Contains(permission);
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="kh-form-check-input" checked="@isChecked" disabled="@_model.IsAdmin"
                                                @onchange="e => TogglePermission(permission, (bool)(e.Value ?? false))" />
                                        </td>
                                        <td>@permission.ToString()</td>
                                        <td>@GetPermissionDescription(permission)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CancelAsync">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SaveAsync">Save</button>
    </Footer>
</Dialog>

