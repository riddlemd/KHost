@using System.ComponentModel.DataAnnotations
@using KHost.Abstractions.Models
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@_rootClassName" OnClose="OnClose">
    <Header>
        <Icon Name="people-fill" /> Edit Group
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div >
                <label class="kh-form-label">Name</label>
                <InputText class="kh-form-control" @bind-Value="_model.Name" autofocus />
                <ValidationMessage For="() => _model.Name" />
            </div>

            <div >
                <label class="kh-form-label">Description</label>
                <InputTextArea class="kh-form-control" @bind-Value="_model.Description" rows="3" />
                <ValidationMessage For="() => _model.Description" />
            </div>

            <div >
                <label class="kh-form-check">
                    <span class="kh-form-check-label">Not A Singer (leave out of the singer queue)</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.ExcludeFromSingerQueue" />
                </label>
            </div>

            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CloseAsync">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SaveAsync">Save</button>
    </Footer>
</Dialog>

