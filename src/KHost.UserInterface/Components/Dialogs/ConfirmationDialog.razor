@using System.Text.Json
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" CloseOnEscape="true" Class="@($"{_rootClassName} {Class.Trim()}".Trim())" OnClose="OnClose">
    <Header>
        @if(!string.IsNullOrWhiteSpace(TitleIcon)) {
             <Icon Name="TitleIcon" />
        }
        @Title
    </Header>
    <Body>
        <div class="@(_rootClassName)__message">
            @((MarkupString)Message)
        </div>
    </Body>
    <Footer>
        @* Focused on open (focusFirstInput takes [autofocus]): the safe answer is the one Enter gives. *@
        <button class="kh-confirmation-dialog__cancel-btn kh-button kh-button--primary" autofocus @onclick="CancelAsync">Cancel</button>
        <button class="kh-confirmation-dialog__cancel-btn kh-button kh-button--primary kh-button--@(GetConfirmButtonClassName())" @onclick="ConfirmAsync">@ConfirmText</button>
    </Footer>
</Dialog>
