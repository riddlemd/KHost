@using KHost.UserInterface.Models
@using KHost.UserInterface.Services
@using Microsoft.AspNetCore.Components.Routing

<Dialog IsOpen="IsOpen" OnClose="OnClose" Class="kh-dialog__settings-menu">
    <Header>
        <span>Settings</span>
    </Header>
    <Body>
        <div class="kh-settings-menu">
            @foreach (var settingsPage in _settingsPages)
            {
                <button class="kh-settings-menu__button" @onclick="() => NavigateToPageAsync(settingsPage.Route)" type="button">
                    <Icon Name="@settingsPage.Icon" />
                    <span>@settingsPage.Title</span>
                </button>
            }
            <button class="kh-settings-menu__button kh-settings-menu__button--exit" @onclick="ConfirmExitAsync" type="button">
                <Icon Name="box-arrow-right" />
                <span>Exit</span>
            </button>
        </div>
    </Body>
</Dialog>

