@using KHost.UserInterface.Models
@using KHost.UserInterface.Services
@using Microsoft.AspNetCore.Components.Routing

<Dialog IsOpen="IsOpen" OnClose="OnClose" Class="kh-dialog__settings-menu">
    <Header>
        <span>Settings</span>
    </Header>
    <Body>
        <div class="kh-settings-menu">
            @foreach (var settingsPage in _settingsPages)
            {
                <button class="kh-settings-menu__button" @onclick="() => NavigateToPageAsync(settingsPage.Route)" type="button">
                    <Icon Name="@settingsPage.Icon" />
                    <span>@settingsPage.Title</span>
                </button>
            }

            @if (_canLock)
            {
            <div class="kh-dropdown__divider"></div>

            @* A native post: the cookie can only be cleared on an HTTP response, not from the circuit. *@
            <form method="post" action="/auth/logout">
                <button class="kh-settings-menu__button kh-settings-menu__button--lock" type="submit"
                        title="Lock the console — the show keeps running, the controls need a sign-in">
                    <Icon Name="lock-fill" />
                    <span>Lock</span>
                </button>
            </form>
            }
        </div>
    </Body>
</Dialog>

