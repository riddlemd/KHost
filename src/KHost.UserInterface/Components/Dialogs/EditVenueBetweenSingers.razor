@using KHost.Abstractions.Models
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<VenueSettingsSection Title="Between singers">

    <div class="kh-venue-settings__row">
        <label for="venue-break-music-mode" class="kh-form-label">Break music mode</label>
        <select id="venue-break-music-mode" class="kh-form-select" @bind="Model.BreakMusicProvider">
            @if (UnavailableProviderSource is { } unavailable)
            {
                <option value="@unavailable">@unavailable: not loaded</option>
            }
            @foreach (var provider in BreakMusic.Providers)
            {
                <option value="@provider.SourceName">@DescribeProvider(provider)</option>
            }
        </select>
    </div>

    @if (IsOnUnavailableProvider)
    {
        <p class="kh-note kh-note--warning">
            Nothing loaded provides this mode. Check its plugin under
            Settings &rsaquo; Plugins Manager. Picking another mode here replaces this
            venue's choice for good.
        </p>
    }

    @if (UsesLocalPlaylists)
    {
        <div class="kh-venue-settings__row">
            <label class="kh-form-label">Break music playlist</label>
            <ComboBox TItem="MediaPool"
                      Class="kh-venue-settings__picker kh-venue-settings__picker--break-music"
                      Value="_breakMusicPool"
                      ValueChanged="OnBreakMusicPoolChanged"
                      @bind-Text="_breakMusicPoolText"
                      Search="SearchBreakMusicPoolsAsync"
                      DisplayName="@(pool => pool.Name)"
                      MinimumSearchLength="0"
                      OpenWhenEmpty="true"
                      Placeholder="None: silence between singers" />
        </div>
    }

    <div class="kh-venue-settings__row">
        <label class="kh-form-label">Ad playlist</label>
        <ComboBox TItem="MediaPool"
                  Class="kh-venue-settings__picker"
                  Value="_adPool"
                  ValueChanged="OnAdPoolChanged"
                  @bind-Text="_adPoolText"
                  Search="SearchAdPoolsAsync"
                  DisplayName="@(pool => pool.Name)"
                  MinimumSearchLength="0"
                  OpenWhenEmpty="true"
                  Placeholder="None: this venue runs no ads" />
    </div>

    <div class="kh-venue-settings__row">
        <label class="kh-form-label">Placeholder image</label>
        <ComboBox TItem="Media"
                  Class="kh-venue-settings__picker"
                  Value="_brandingImage"
                  ValueChanged="OnBrandingImageChanged"
                  @bind-Text="_brandingImageText"
                  Search="SearchImagesAsync"
                  DisplayName="@(image => image.Title)"
                  MinimumSearchLength="0"
                  OpenWhenEmpty="true"
                  Placeholder="None: leave the screen blank" />
    </div>

    @if (_brandingImage is not null)
    {
        <div class="kh-venue-settings__row">
            <label for="venue-branding-scaling" class="kh-form-label">How it fills the screen</label>
            <InputSelect id="venue-branding-scaling" class="kh-form-select"
                         @bind-Value="Model.BrandingImageScaling">
                <ImageScalingOptions IncludeUseOwn="true" />
            </InputSelect>
        </div>
    }

    <div class="kh-venue-settings__row">
        <span class="kh-venue-settings__labelled">
            <label for="venue-next-singer-background" class="kh-form-label">Behind the &ldquo;Up next&rdquo; card</label>
            <span class="kh-note">
                A visualisation comes from this venue's visualisation playlist; with none, the card
                sits over the placeholder image.
            </span>
        </span>
        <InputSelect id="venue-next-singer-background" class="kh-form-select"
                     @bind-Value="Model.NextSingerBackground">
            <option value="@NextSingerBackground.Over">Placeholder image</option>
            <option value="@NextSingerBackground.Blackout">Black</option>
            <option value="@NextSingerBackground.Visualisation">A visualisation</option>
        </InputSelect>
    </div>

    @* Last, with the corner it reveals right under it: the only switch in the section. *@
    <label class="kh-venue-settings__row kh-form-check">
        <span class="kh-form-check-label">
            Name the break music on screen
            <span class="kh-note">
                Only while it is actually playing: it comes down for a singer,
                and for a pause.
            </span>
        </span>
        <input id="venue-break-music-card" type="checkbox" class="kh-form-check-input"
               @bind="Model.BreakMusicCardEnabled" />
    </label>

    @if (Model.BreakMusicCardEnabled)
    {
        <div class="kh-venue-settings__row">
            <label for="venue-break-music-card-corner" class="kh-form-label">Corner</label>
            <InputSelect id="venue-break-music-card-corner" class="kh-form-select"
                         @bind-Value="Model.BreakMusicCardCorner">
                <OverlayCornerOptions />
            </InputSelect>
        </div>
    }
</VenueSettingsSection>
