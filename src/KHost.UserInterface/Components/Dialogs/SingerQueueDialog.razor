@using KHost.Plugins.Sdk.Models.QueueRotation

<Dialog IsOpen="IsOpen" OnClose="OnClose" Class="kh-singer-queue-dialog">
    <Header>
        <Icon Name="people-fill" /> Singer Queue
    </Header>
    <Body>
        <QueueRotationSettingsEditor Config="Config" />
    </Body>
    <Footer>
        <button class="kh-button kh-button--primary" @onclick="OnClose" type="button">Done</button>
    </Footer>
</Dialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public QueueRotationConfig Config { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
}
