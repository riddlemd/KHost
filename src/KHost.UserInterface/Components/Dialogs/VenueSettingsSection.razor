@* Collapsed until opened: the venue dialog is long, and a host usually came for one section. The
   open state is the browser's own, never set from here, so a re-render cannot snap one shut. *@
<details class="kh-venue-settings__section kh-venue-settings__section--collapsible">
    <summary class="kh-venue-settings__section-title">@Title</summary>
    @ChildContent
</details>
