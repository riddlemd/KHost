@using KHost.Abstractions.Models
@using KHost.UserInterface.Models

<VenueSettingsSection Title="Screen QR codes">

    <div class="kh-venue-settings__row">
        <label for="venue-qr-source" class="kh-form-label">Code shown</label>
        <div class="kh-venue-qr-codes__source">
            <InputSelect id="venue-qr-source" class="kh-form-select" @bind-Value="Model.QrCodeSource">
                <option value="">None</option>
                @if (UnavailableQrCodeSource is { } missing)
                {
                    <option value="@missing">@missing: not installed</option>
                }
                @foreach (var (id, label) in QrCodeSources)
                {
                    <option value="@id">@label</option>
                }
            </InputSelect>
            <button type="button" class="kh-button kh-button--secondary kh-venue-qr-codes__download"
                    title="Save this code as a PNG in Downloads" aria-label="Save this code as a PNG"
                    disabled="@(string.IsNullOrWhiteSpace(Model.QrCodeSource) || _saving)"
                    @onclick="SaveCodeAsync">
                <Icon Name="download" />
            </button>
        </div>
    </div>
    @if (IsOnUnavailableQrCodeSource)
    {
        <p class="kh-note kh-note--warning">
            No installed plugin provides this code. Check it under
            Settings &rsaquo; Plugins Manager. Picking another here replaces this
            venue's choice for good.
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.QrCodeSource))
    {
        <div class="kh-venue-settings__row">
            <label for="venue-qr-corner" class="kh-form-label">Corner</label>
            <InputSelect id="venue-qr-corner" class="kh-form-select" @bind-Value="Model.QrCodeCorner">
                <OverlayCornerOptions />
            </InputSelect>
        </div>

        <div class="kh-venue-settings__row">
            <label for="venue-qr-size" class="kh-form-label">Size</label>
            <InputSelect id="venue-qr-size" class="kh-form-select" @bind-Value="Model.QrCodeSize">
                <option value="@QrCodeSize.Small">Small</option>
                <option value="@QrCodeSize.Medium">Medium</option>
                <option value="@QrCodeSize.Large">Large</option>
                <option value="@QrCodeSize.ExtraLarge">Extra Large</option>
            </InputSelect>
        </div>

        <div class="kh-venue-settings__row">
            <span class="kh-venue-settings__labelled">
                <label for="venue-qr-safe-zone" class="kh-form-label">Safe zone</label>
                <span class="kh-note">
                    The white around the code, measured in the code&rsquo;s own squares.
                </span>
            </span>
            <InputNumber id="venue-qr-safe-zone" class="kh-form-control" min="0" max="8"
                         @bind-Value="Model.QrCodeSafeZone" />
        </div>

        <div class="kh-venue-settings__row">
            <span class="kh-venue-settings__labelled">
                <label for="venue-qr-offset" class="kh-form-label">Offset</label>
                <span class="kh-note">
                    Pushes the code in from the edges it sits against, as a percentage of
                    the screen&rsquo;s shorter side.
                </span>
            </span>
            <InputNumber id="venue-qr-offset" class="kh-form-control" min="0" max="20" step="0.1"
                         @bind-Value="Model.QrCodeOffset" />
        </div>

        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">Hide codes while someone is singing</span>
            <input id="venue-qr-hide-during-song" type="checkbox" class="kh-form-check-input"
                   @bind="Model.QrCodeHideDuringSong" />
        </label>
    }
</VenueSettingsSection>
