@using System.ComponentModel.DataAnnotations
@using KHost.Abstractions.Models
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="music-note-beamed" /> Edit @Items?.Count Songs
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div >
                <div class="kh-form-check">
                    <InputCheckbox class="kh-form-check-input" id="updateArtistCheck" @bind-Value="_model.UpdateArtist" />
                    <label class="kh-form-check-label" for="updateArtistCheck">Update Artist</label>
                </div>
                <InputText class="@($"kh-form-control {(_model.UpdateArtist ? "" : "disabled")}".Trim())"
                           disabled="@(!_model.UpdateArtist)"
                           @bind-Value="_model.Artist"
                           placeholder="Artist name" />
                <ValidationMessage For="() => _model.Artist" />
            </div>
            <div >
                <div class="kh-form-check">
                    <InputCheckbox class="kh-form-check-input" id="swapCheck" @bind-Value="_model.SwapTitleAndArtist" />
                    <label class="kh-form-check-label" for="swapCheck">Swap Title and Artist</label>
                </div>
            </div>
            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CloseAsync" type="button">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SubmitAsync" type="button">Save</button>
    </Footer>
</Dialog>

@code {
    private const string _rootClassName = "kh-media-bulk-edit-dialog";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public IReadOnlyList<Media>? Items { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool CloseOnScrimClick { get; set; }

    [Parameter] public EventCallback<BulkEditMediaModel> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private BulkEditMediaModel _model = new();
    private EditContext _editContext = default!;
    private bool _prevIsOpen;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_prevIsOpen)
        {
            _model = new BulkEditMediaModel();
            _editContext = new EditContext(_model);
        }
        _prevIsOpen = IsOpen;
    }

    private async Task SubmitAsync()
    {
        if (_editContext.Validate())
            await SaveAsync();
    }

    private async Task SaveAsync()
    {
        await OnSave.InvokeAsync(_model);
        await CloseAsync();
    }

    public async Task CloseAsync()
    {
        IsOpen = false;
        await OnClose.InvokeAsync();
    }

    public record DialogRequest : BaseDialogRequest
    {
        public DialogRequest(IReadOnlyList<Media> items, Func<BulkEditMediaModel, Task> onSave, Action? onCancel, Action? onClose) : base(onClose)
        {
            Items = items;
            OnSave = onSave;
            OnCancel = onCancel;
        }

        public IReadOnlyList<Media> Items { get; }
        public Func<BulkEditMediaModel, Task> OnSave { get; }
        public Action? OnCancel { get; }
    }
}
