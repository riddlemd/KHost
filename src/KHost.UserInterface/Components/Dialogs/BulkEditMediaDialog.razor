@using System.ComponentModel.DataAnnotations
@using KHost.Abstractions.Models
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="music-note-beamed" /> Edit @Items?.Count Songs
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div >
                <div class="kh-form-check">
                    <InputCheckbox class="kh-form-check-input" id="updateArtistCheck" @bind-Value="_model.UpdateArtist" />
                    <label class="kh-form-check-label" for="updateArtistCheck">Update Artist</label>
                </div>
                <InputText class="@($"kh-form-control {(_model.UpdateArtist ? "" : "disabled")}".Trim())"
                           disabled="@(!_model.UpdateArtist)"
                           @bind-Value="_model.Artist"
                           placeholder="Artist name" />
                <ValidationMessage For="() => _model.Artist" />
            </div>
            <div >
                <div class="kh-form-check">
                    <InputCheckbox class="kh-form-check-input" id="swapCheck" @bind-Value="_model.SwapTitleAndArtist" />
                    <label class="kh-form-check-label" for="swapCheck">Swap Title and Artist</label>
                </div>
            </div>
            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CloseAsync" type="button">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SubmitAsync" type="button">Save</button>
    </Footer>
</Dialog>
