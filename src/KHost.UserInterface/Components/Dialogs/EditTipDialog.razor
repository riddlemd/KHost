@using System.ComponentModel.DataAnnotations
@using KHost.Abstractions.Models
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services
@using KHost.Abstractions.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class?.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="coin" /> @(_isNew ? "Add Tip" : "Edit Tip")
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @if (UserId is null)
            {
                <div >
                    <label class="kh-form-label">Singer</label>
                    <InputSelect class="kh-form-control" @bind-Value="_model.UserId">
                        <option value="">-- Select a singer --</option>
                        @foreach (var user in _users)
                        {
                            <option value="@user.Id">@user.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.UserId" />
                </div>
            }

            <div >
                <label class="kh-form-label">Amount</label>
                <input type="text" @ref="_amountRef" class="kh-form-control"
                       inputmode="numeric" @onchange="OnAmountChangedAsync" />
                <ValidationMessage For="() => _model.Amount" />
            </div>

            <div >
                <label class="kh-form-label">Payment Method</label>
                <InputSelect class="kh-form-control" @bind-Value="_model.PaymentMethod">
                    @foreach (var method in Enum.GetValues<TipPaymentMethod>())
                    {
                        <option value="@method">@method</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _model.PaymentMethod" />
            </div>

            <div >
                <label class="kh-form-label">Notes</label>
                <InputTextArea class="kh-form-control" @bind-Value="_model.Notes" rows="5" />
                <ValidationMessage For="() => _model.Notes" />
            </div>

            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CloseAsync" type="button">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SubmitAsync" type="button">Save</button>
    </Footer>
</Dialog>

