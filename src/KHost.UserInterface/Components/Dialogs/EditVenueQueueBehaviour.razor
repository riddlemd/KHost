@using KHost.UserInterface.Models

<VenueSettingsSection Title="Queue behavior">

    @* Who sings next first; then the rest grouped by what they touch, the duplicate window right
       under the warning it belongs to. *@
    <div class="kh-venue-queue-behaviour__rotation-row">
        <button type="button" class="kh-venue-queue-behaviour__rotation-btn kh-button kh-button--secondary"
                @onclick="() => _rotationDialogOpen = true">
            <Icon Name="people-fill" /> Edit Singer Queue Rotation Strategy
        </button>
    </div>

    <VenueSettingsGroup Title="Limits">
        <div class="kh-venue-settings__row">
            <span class="kh-venue-settings__labelled">
                <label for="venue-remote-song-limit" class="kh-form-label">Songs a singer may have queued</label>
                <span class="kh-note">
                    Remote sign-ups past this are turned away; songs you add count but are never refused.
                    0 is no limit.
                </span>
            </span>
            <InputNumber id="venue-remote-song-limit" class="kh-form-control" min="0" max="99"
                         @bind-Value="Model.RemoteSongLimit" />
            <ValidationMessage For="() => Model.RemoteSongLimit" />
        </div>
        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">
                Refuse a song another singer already has queued
                <span class="kh-note">
                    Turned away without asking you. A remote tells the singer who has it.
                </span>
            </span>
            <InputCheckbox id="venue-refuse-song-queued-for-another-singer" class="kh-form-check-input" @bind-Value="Model.RefuseSongQueuedForAnotherSinger" />
        </label>
    </VenueSettingsGroup>

    <VenueSettingsGroup Title="Duplicate songs">
        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">Warn when queueing a song already queued or recently sung</span>
            <InputCheckbox class="kh-form-check-input" @bind-Value="Model.WarnOnDuplicateSong" />
        </label>
        @if (Model.WarnOnDuplicateSong)
        {
            <div class="kh-venue-settings__row">
                <label for="duplicate-window" class="kh-form-label">Consider a song recently sung within</label>
                <InputSelect id="duplicate-window" class="kh-form-select" @bind-Value="Model.DuplicateSongWindowHours">
                    @foreach (var hours in EditVenueModel.DuplicateWindowOptions)
                    {
                        <option value="@hours">@hours @(hours == 1 ? "hour" : "hours")</option>
                    }
                </InputSelect>
            </div>
        }
    </VenueSettingsGroup>

    <VenueSettingsGroup Title="Showing the queue">
        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">Show estimated wait time in the singer queue</span>
            <InputCheckbox class="kh-form-check-input" @bind-Value="Model.ShowEstimatedWaitTime" />
        </label>
        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">
                Allow Singer Aliases
                <span class="kh-note">
                    Announce the name a song was signed up under, rather than the
                    singer&rsquo;s own.
                </span>
            </span>
            <InputCheckbox id="venue-allow-aliases" class="kh-form-check-input" @bind-Value="Model.AllowAliases" />
        </label>
    </VenueSettingsGroup>

    <VenueSettingsGroup Title="Closing">
        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">Clear queue when closing</span>
            <InputCheckbox class="kh-form-check-input" @bind-Value="Model.ClearQueueOnClose" />
        </label>
    </VenueSettingsGroup>
</VenueSettingsSection>

<SingerQueueDialog IsOpen="_rotationDialogOpen" Config="Model.QueueRotation" OnClose="CloseRotationDialog" />
