<div class="kh-venue-settings__row">
    <span class="kh-venue-settings__labelled">
        <label for="@Id" class="kh-form-label">@Label</label>
        <span class="kh-note" title="@Note">@Note</span>
    </span>
    <span class="kh-themed-colour">
        <ColourPicker Id="@Id" Value="@Value" ValueChanged="ValueChanged" Fallback="@Fallback"
                      Clearable ClearTitle="@ClearTitle" />
    </span>
</div>
