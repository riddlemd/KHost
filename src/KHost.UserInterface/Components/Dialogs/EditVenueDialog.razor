@using System.ComponentModel.DataAnnotations
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="geo-alt-fill" /> @(_isNew ? "Add Venue" : "Edit Venue")
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="kh-venue-settings__section kh-venue-settings__section--head">
                <div class="kh-venue-settings__field">
                    <label class="kh-form-label">Name</label>
                    <InputText class="kh-form-control" @bind-Value="_model.Name" autofocus />
                    <ValidationMessage For="() => _model.Name" />
                </div>

                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Enabled</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.Enabled" />
                </label>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Playback</span>
                <div class="kh-venue-settings__row">
                    <label for="default-volume" class="kh-form-label">Default Volume</label>
                    <InputNumber id="default-volume" class="kh-form-control" @bind-Value="_model.DefaultVolume" min="0" max="100" />
                </div>
                <div class="kh-venue-settings__row">
                    <label for="on-screen-disconnect" class="kh-form-label">When a screen disconnects</label>
                    <InputSelect id="on-screen-disconnect" class="kh-form-select" @bind-Value="_model.OnScreenDisconnect">
                        <option value="@ScreenDisconnectBehavior.ResumeOnReconnect">Resume when a screen returns</option>
                        <option value="@ScreenDisconnectBehavior.RestartFromStart">Pause and restart the song</option>
                        <option value="@ScreenDisconnectBehavior.CancelPerformance">Cancel the song</option>
                    </InputSelect>
                </div>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Queue behavior</span>

                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Move singer to bottom after performance</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.MoveSingerToBottomAfterPerformance" />
                </label>
                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Clear queue when closing</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.ClearQueueOnClose" />
                </label>
                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Show estimated wait time in the singer queue</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.ShowEstimatedWaitTime" />
                </label>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Require confirmation when removing</span>

                <div class="kh-venue-settings__prompt-grid">
                    <label class="kh-venue-settings__prompt-item kh-form-check">
                        <span class="kh-venue-settings__prompt-item-label">
                            <Icon Name="person-x-fill" />
                            <span class="kh-form-check-label">Singer from queue</span>
                        </span>
                        <InputCheckbox class="kh-form-check-input" @bind-Value="_model.PromptBeforeRemovingSinger" />
                    </label>
                    <label class="kh-venue-settings__prompt-item kh-form-check">
                        <span class="kh-venue-settings__prompt-item-label">
                            <Icon Name="music-note-beamed" />
                            <span class="kh-form-check-label">Song from queue</span>
                        </span>
                        <InputCheckbox class="kh-form-check-input" @bind-Value="_model.PromptBeforeRemovingPerformance" />
                    </label>
                </div>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Notes</span>
                <InputTextArea class="kh-form-control" @bind-Value="_model.Notes" rows="3"
                               placeholder="Anything worth remembering about this venue…" />
                <ValidationMessage For="() => _model.Notes" />
            </div>

            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CloseAsync" type="button">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SubmitAsync" type="button">Save</button>
    </Footer>
</Dialog>

@code {
    private const string _rootClassName = "kh-venue-edit-dialog";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Venue? Venue { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool CloseOnScrimClick { get; set; }

    [Parameter] public EventCallback<Venue> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }

    private bool _isNew;
    private EditVenueModel _model = new();
    private EditContext _editContext = default!;
    private bool _prevIsOpen;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_prevIsOpen)
        {
            _isNew = Venue is null;
            _model = Venue is null
                ? new EditVenueModel()
                : new EditVenueModel
                {
                    Id = Venue.Id,
                    Name = Venue.Name,
                    Notes = Venue.Notes,
                    Enabled = Venue.Enabled,
                    DefaultVolume = Venue.Settings.DefaultVolume,
                    OnScreenDisconnect = Venue.Settings.OnScreenDisconnect,
                    MoveSingerToBottomAfterPerformance = Venue.Settings.MoveSingerToBottomAfterPerformance,
                    ShowEstimatedWaitTime = Venue.Settings.ShowEstimatedWaitTime,
                    PromptBeforeRemovingSinger = Venue.Settings.PromptBeforeRemovingSinger,
                    PromptBeforeRemovingPerformance = Venue.Settings.PromptBeforeRemovingPerformance,
                    ClearQueueOnClose = Venue.Settings.ClearQueueOnClose,
                };
            _editContext = new EditContext(_model);
        }
        _prevIsOpen = IsOpen;
    }

    private async Task SubmitAsync()
    {
        if (_editContext.Validate())
            await SaveAsync();
    }

    private async Task SaveAsync()
    {
        var venue = Venue ?? new Venue { Id = _model.Id, Name = _model.Name };
        venue.Name = _model.Name;
        venue.Notes = _model.Notes;
        venue.Enabled = _model.Enabled;
        venue.Settings.DefaultVolume = _model.DefaultVolume;
        venue.Settings.OnScreenDisconnect = _model.OnScreenDisconnect;
        venue.Settings.MoveSingerToBottomAfterPerformance = _model.MoveSingerToBottomAfterPerformance;
        venue.Settings.ShowEstimatedWaitTime = _model.ShowEstimatedWaitTime;
        venue.Settings.PromptBeforeRemovingSinger = _model.PromptBeforeRemovingSinger;
        venue.Settings.PromptBeforeRemovingPerformance = _model.PromptBeforeRemovingPerformance;
        venue.Settings.ClearQueueOnClose = _model.ClearQueueOnClose;

        await OnSave.InvokeAsync(venue);

        await CloseAsync();
    }

    public async Task CloseAsync()
    {
        IsOpen = false;

        await OnClose.InvokeAsync();
    }

    private string GetClassString()
        => $"kh-singer-edit-dialog {Class?.Trim()}".Trim();

    public record DialogRequest : EditDialogRequest<Venue>
    {
        public DialogRequest(Venue? value, Action<Venue?> onSave, Action? onCancel, Action onClose) : base(value, onSave, onCancel, onClose)
        {
        }
    }
}
