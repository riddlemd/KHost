@using System.ComponentModel.DataAnnotations
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class.Trim()}".Trim())" OnClose="OnClose" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="geo-alt-fill" /> @(_isNew ? "Add Venue" : "Edit Venue")
    </Header>
    <Body>
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" class="kh-venue-settings">
            <DataAnnotationsValidator />
            <div class="kh-venue-settings__section kh-venue-settings__section--head">
                <div class="kh-venue-settings__field">
                    <label class="kh-form-label">Name</label>
                    <InputText class="kh-form-control" @bind-Value="_model.Name" autofocus />
                    <ValidationMessage For="() => _model.Name" />
                </div>

                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Enabled</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.Enabled" />
                </label>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Between singers</span>

                <div class="kh-venue-settings__row">
                    <label for="venue-break-music-mode" class="kh-form-label">Break music mode</label>
                    <select id="venue-break-music-mode" class="kh-form-select" @bind="_model.BreakMusicProvider">
                        @if (UnavailableProviderSource is { } unavailable)
                        {
                            <option value="@unavailable">@unavailable &mdash; not loaded</option>
                        }
                        @foreach (var provider in BreakMusic.Providers)
                        {
                            <option value="@provider.SourceName">@DescribeProvider(provider)</option>
                        }
                    </select>
                </div>

                @if (UnavailableProviderSource is not null)
                {
                    <p class="kh-venue-settings__hint kh-venue-settings__hint--warning">
                        Nothing loaded provides this mode &mdash; check its plugin under
                        Settings &rsaquo; Plugins Manager. Picking another mode here replaces this
                        venue's choice for good.
                    </p>
                }

                @if (UsesLocalPlaylists)
                {
                <div class="kh-venue-settings__row">
                    <label class="kh-form-label">Break music playlist</label>
                    <ComboBox TItem="MediaPool"
                              Class="kh-venue-settings__picker kh-venue-settings__picker--break-music"
                              Value="_breakMusicPool"
                              ValueChanged="OnBreakMusicPoolChanged"
                              @bind-Text="_breakMusicPoolText"
                              Search="SearchBreakMusicPoolsAsync"
                              DisplayName="@(pool => pool.Name)"
                              MinimumSearchLength="0"
                              OpenWhenEmpty="true"
                              Placeholder="None — silence between singers" />
                </div>
                }

                <div class="kh-venue-settings__row">
                    <label class="kh-form-label">Ad playlist</label>
                    <ComboBox TItem="MediaPool"
                              Class="kh-venue-settings__picker"
                              Value="_adPool"
                              ValueChanged="OnAdPoolChanged"
                              @bind-Text="_adPoolText"
                              Search="SearchAdPoolsAsync"
                              DisplayName="@(pool => pool.Name)"
                              MinimumSearchLength="0"
                              OpenWhenEmpty="true"
                              Placeholder="None — this venue runs no ads" />
                </div>

                <div class="kh-venue-settings__row">
                    <label class="kh-form-label">Card shown when nothing is playing</label>
                    <ComboBox TItem="Media"
                              Class="kh-venue-settings__picker"
                              Value="_brandingImage"
                              ValueChanged="OnBrandingImageChanged"
                              @bind-Text="_brandingImageText"
                              Search="SearchImagesAsync"
                              DisplayName="@(image => image.Title)"
                              MinimumSearchLength="0"
                              OpenWhenEmpty="true"
                              Placeholder="None — leave the screen blank" />
                </div>

                <p class="kh-venue-settings__hint">
                    The playlists themselves are built under Settings &rsaquo; Break Music Manager and Ads Manager.
                </p>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Playback</span>
                <div class="kh-venue-settings__row">
                    <label for="default-volume" class="kh-form-label">Default Volume</label>
                    <InputNumber id="default-volume" class="kh-form-control" @bind-Value="_model.DefaultVolume" min="0" max="100" />
                </div>
                <div class="kh-venue-settings__row">
                    <label for="on-screen-disconnect" class="kh-form-label">When a screen disconnects</label>
                    <InputSelect id="on-screen-disconnect" class="kh-form-select" @bind-Value="_model.OnScreenDisconnect">
                        <option value="@ScreenDisconnectBehavior.ResumeOnReconnect">Resume when a screen returns</option>
                        <option value="@ScreenDisconnectBehavior.RestartFromStart">Pause and restart the song</option>
                        <option value="@ScreenDisconnectBehavior.CancelPerformance">Cancel the song</option>
                    </InputSelect>
                </div>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Screen marquee</span>

                <label class="kh-venue-settings__row kh-form-check">
                    <input id="venue-marquee-enabled" type="checkbox" class="kh-form-check-input" @bind="_model.MarqueeEnabled" />
                    <span class="kh-form-check-label">Show a marquee on the screen</span>
                </label>

                @if (_model.MarqueeEnabled)
                {
                    <div class="kh-venue-settings__row">
                        <label for="marquee-singer-count" class="kh-form-label">Singers to show</label>
                        <InputNumber id="marquee-singer-count" class="kh-form-control"
                                     @bind-Value="_model.MarqueeSingerCount" min="0" max="20" />
                    </div>

                    <div class="kh-venue-settings__field">
                        <label for="marquee-message" class="kh-form-label">Message</label>
                        <InputText id="marquee-message" class="kh-form-control"
                                   @bind-Value="_model.MarqueeMessage"
                                   placeholder="Happy hour until 8 — ask your host about specials" />
                    </div>

                    <div class="kh-venue-settings__row">
                        <label for="marquee-font-size" class="kh-form-label">Text size</label>
                        <InputNumber id="marquee-font-size" class="kh-form-control"
                                     @bind-Value="_model.MarqueeFontSizePixels" min="12" max="96" />
                    </div>

                    <div class="kh-venue-settings__row">
                        <label for="marquee-speed" class="kh-form-label">Scroll speed</label>
                        <InputNumber id="marquee-speed" class="kh-form-control"
                                     @bind-Value="_model.MarqueeScrollSpeed" min="15" max="400" />
                    </div>

                    <div class="kh-venue-settings__row">
                        <label for="marquee-position" class="kh-form-label">Position</label>
                        <InputSelect id="marquee-position" class="kh-form-select" @bind-Value="_model.MarqueePosition">
                            <option value="@MarqueePosition.Bottom">Bottom of the screen</option>
                            <option value="@MarqueePosition.Top">Top of the screen</option>
                        </InputSelect>
                    </div>

                    <div class="kh-venue-settings__row">
                        <label for="marquee-background" class="kh-form-label">Background color</label>
                        <InputText id="marquee-background" type="color" class="kh-form-control kh-venue-settings__color"
                                   @bind-Value="_model.MarqueeBackgroundColor" />
                    </div>

                    <div class="kh-venue-settings__row">
                        <label for="marquee-text" class="kh-form-label">Text color</label>
                        <InputText id="marquee-text" type="color" class="kh-form-control kh-venue-settings__color"
                                   @bind-Value="_model.MarqueeTextColor" />
                    </div>

                    <label class="kh-venue-settings__row kh-form-check">
                        <input id="venue-marquee-pin-label" type="checkbox" class="kh-form-check-input"
                               @bind="_model.MarqueePinLabel" />
                        <span class="kh-form-check-label">Hold &ldquo;Up next&rdquo; at the edge instead of scrolling it</span>
                    </label>

                    <p class="kh-venue-settings__hint">
                        Zero singers leaves a message-only marquee. Text size is in pixels; scroll speed is pixels a second.
                    </p>
                }
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Queue behavior</span>

                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Clear queue when closing</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.ClearQueueOnClose" />
                </label>
                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Show estimated wait time in the singer queue</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.ShowEstimatedWaitTime" />
                </label>
                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Warn when queueing a song already queued or recently sung</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.WarnOnDuplicateSong" />
                </label>
                @if (_model.WarnOnDuplicateSong)
                {
                    <div class="kh-venue-settings__row">
                        <label for="duplicate-window" class="kh-form-label">Consider a song recently sung within</label>
                        <InputSelect id="duplicate-window" class="kh-form-select" @bind-Value="_model.DuplicateSongWindowHours">
                            @foreach (var hours in DuplicateWindowOptions)
                            {
                                <option value="@hours">@hours @(hours == 1 ? "hour" : "hours")</option>
                            }
                        </InputSelect>
                    </div>
                }

                <div class="@(_rootClassName)__rotation-row">
                    <button type="button" class="@(_rootClassName)__rotation-btn kh-button kh-button--secondary"
                            @onclick="() => _rotationDialogOpen = true">
                        <Icon Name="people-fill" /> Edit Singer Queue Rotation Strategy
                    </button>
                </div>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Tipping</span>

                <label class="kh-venue-settings__row kh-form-check">
                    <span class="kh-form-check-label">Track tips for singers</span>
                    <InputCheckbox class="kh-form-check-input" @bind-Value="_model.TippingEnabled" />
                </label>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Require confirmation when removing</span>

                <div class="kh-venue-settings__prompt-grid">
                    <label class="kh-venue-settings__prompt-item kh-form-check">
                        <span class="kh-venue-settings__prompt-item-label">
                            <Icon Name="person-x-fill" />
                            <span class="kh-form-check-label">Singer from queue</span>
                        </span>
                        <InputCheckbox class="kh-form-check-input" @bind-Value="_model.PromptBeforeRemovingSinger" />
                    </label>
                    <label class="kh-venue-settings__prompt-item kh-form-check">
                        <span class="kh-venue-settings__prompt-item-label">
                            <Icon Name="music-note-beamed" />
                            <span class="kh-form-check-label">Song from queue</span>
                        </span>
                        <InputCheckbox class="kh-form-check-input" @bind-Value="_model.PromptBeforeRemovingPerformance" />
                    </label>
                </div>
            </div>

            <div class="kh-venue-settings__section">
                <span class="kh-venue-settings__section-title">Notes</span>
                <InputTextArea class="kh-form-control" @bind-Value="_model.Notes" rows="3"
                               placeholder="Anything worth remembering about this venue…" />
                <ValidationMessage For="() => _model.Notes" />
            </div>

            <button type="submit" class="kh-hidden"></button>
        </EditForm>
    </Body>
    <Footer>
        <button class="@(_rootClassName)__cancel-btn kh-button kh-button--secondary" @onclick="CloseAsync" type="button">Cancel</button>
        <button class="@(_rootClassName)__save-btn kh-button kh-button--primary" @onclick="SubmitAsync" type="button">Save</button>
    </Footer>
</Dialog>

<SingerQueueDialog IsOpen="_rotationDialogOpen" Config="_model.QueueRotation" OnClose="CloseRotationDialog" />

