@using KHost.Abstractions.Services.IPC
@using KHost.UserInterface.Models

<Dialog IsOpen="IsOpen" OnClose="OnClose" Class="kh-dialog__screens">
    <Header>Screens</Header>
    <Body>
        <div class="kh-screens-dialog">

            <section class="kh-screens-dialog__connected">
                <h3>Connected</h3>
                @if (!_connectedScreens.Any())
                {
                    <p class="kh-screens-dialog__empty">No screens connected.</p>
                }
                else
                {
                    <ul class="kh-screens-dialog__list">
                        @foreach (var screen in _connectedScreens)
                        {
                            var state = _screenStates.TryGetValue(screen.ScreenId, out var s) ? s : null;
                            var isPrimary = IsPrimary(screen);
                            <li class="kh-screens-dialog__item @(isPrimary ? "kh-screens-dialog__item--primary" : "")">
                                <i class="bi bi-circle-fill kh-screens-dialog__status--connected"></i>
                                <div class="kh-screens-dialog__item-content">
                                    <div class="kh-screens-dialog__screen-name">
                                        <span>@screen.ScreenId</span>
                                        @if (isPrimary)
                                        {
                                            <span class="kh-screens-dialog__badge kh-screens-dialog__badge--primary"
                                                  title="Defines the timeline every other screen follows, and is never speed-corrected.">
                                                <i class="bi bi-star-fill"></i> Primary
                                            </span>
                                        }
                                        else if (!screen.Capabilities.SupportsSync)
                                        {
                                            <span class="kh-screens-dialog__badge"
                                                  title="Plays on its own schedule, so it cannot be kept in sync with the others.">
                                                Unsynced
                                            </span>
                                        }
                                    </div>
                                    @if (state is not null)
                                    {
                                        <div class="kh-screens-dialog__screen-state">
                                            @if (!string.IsNullOrEmpty(state.LoadedFilePath))
                                            {
                                                <span class="kh-screens-dialog__file">@Path.GetFileName(state.LoadedFilePath)</span>
                                            }
                                            <span class="kh-screens-dialog__playback">
                                                @if (state.IsPlaying)
                                                {
                                                    <i class="bi bi-play-fill"></i> <span>Playing</span>
                                                }
                                                else if (!string.IsNullOrEmpty(state.LoadedFilePath))
                                                {
                                                    <i class="bi bi-pause-fill"></i> <span>Paused</span>
                                                }
                                            </span>
                                            @if (state.Duration > TimeSpan.Zero)
                                            {
                                                <span class="kh-screens-dialog__time">@state.Position.ToString(@"hh\:mm\:ss") / @state.Duration.ToString(@"hh\:mm\:ss")</span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="kh-screens-dialog__item-actions">
                                    @if (screen.Capabilities.SupportsAudio)
                                    {
                                        <button class="kh-button kh-button--icon-minimal kh-screens-dialog__audio @(IsAudible(screen) ? "kh-screens-dialog__audio--on" : "kh-screens-dialog__audio--off")"
                                                title="@(IsAudible(screen) ? "Audible — click to mute" : "Muted — click to unmute")"
                                                @onclick="() => ToggleAudioAsync(screen)">
                                            <i class="bi @(IsAudible(screen) ? "bi-volume-up-fill" : "bi-volume-mute")"></i>
                                        </button>
                                    }
                                    @if (!isPrimary && screen.Capabilities.SupportsSync)
                                    {
                                        <button class="kh-button kh-button--secondary"
                                                title="Make this the screen the room hears and the others follow."
                                                @onclick="() => MakePrimaryAsync(screen)">
                                            Make primary
                                        </button>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                    <p class="kh-screens-dialog__hint">
                        Only the primary is audible by default — two screens playing the same song
                        into one room fight each other. Unmute another only if it is somewhere else.
                    </p>
                }
            </section>

            <section class="kh-screens-dialog__launch">
                <h3>Launch New Screen</h3>
                <div class="kh-screens-dialog__launch-form">
                    <input class="kh-input"
                           type="text"
                           placeholder="Screen name (auto if blank)"
                           disabled="@_isLaunching"
                           @bind="_screenName"
                           @bind:event="oninput" />
                    <select class="kh-select" disabled="@_isLaunching" @bind="_selectedProviderName">
                        @foreach (var provider in _providers)
                        {
                            <option value="@provider.Name" disabled="@(!provider.IsAvailable)">
                                @provider.Name@(!provider.IsAvailable ? " (unavailable)" : "")
                            </option>
                        }
                    </select>
                    <button class="kh-button"
                            disabled="@(!CanLaunch)"
                            @onclick="LaunchAsync">
                        @(_isLaunching ? "Loading…" : "Launch")
                    </button>
                </div>
            </section>

        </div>
    </Body>
</Dialog>

