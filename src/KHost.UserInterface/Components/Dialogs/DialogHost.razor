@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

@foreach (var item in _stack)
{
    @switch (item)
    {
        case ErrorDialog.DialogRequest r:
            <ErrorDialog @key="r.Id" IsOpen="true"
                Title="@r.Title" WhatHappened="@r.WhatHappened" Suggestion="@r.Suggestion"
                ReferenceCode="@r.ReferenceCode" Detail="@r.Detail"
                OnRetry="@(r.OnRetry is null ? null : EventCallback.Factory.Create(this, () => { r.OnRetry.Invoke(); Close(r); }))"
                OnClose="@(() => Close(r))" />
            break;

        case ConfirmationDialog.DialogRequest r:
            <ConfirmationDialog @key="r.Id" IsOpen="true"
                Title="@r.Title" Message="@r.Message" ConfirmText="@r.ConfirmText"
                OnConfirm="@(async () => { await r.OnConfirm(); Close(r); })"
                OnCancel="@(() => { r.OnCancel?.Invoke(); Close(r); })"
                OnClose="@(() => { r.OnCancel?.Invoke(); Close(r); })" />
            break;

        case EditUserDialog.DialogRequest r:
            <EditUserDialog @key="r.Id" IsOpen="true" User="@r.Value"
                OnSave="@(async (user) => { if (r.OnSave is not null) await r.OnSave(user); Close(r); })"
                OnClose="@(() => { r.OnCancel?.Invoke(); Close(r); })" />
            break;

        case EditUserGroupDialog.DialogRequest r:
            <EditUserGroupDialog @key="r.Id" IsOpen="true" Group="@r.Value"
                OnSave="@(async (group) => { if (r.OnSave is not null) await r.OnSave(group); Close(r); })"
                OnClose="@(() => { r.OnCancel?.Invoke(); Close(r); })" />
            break;

        case EditVenueDialog.DialogRequest r:
            <EditVenueDialog @key="r.Id" IsOpen="true" Venue="@r.Value"
                OnSave="@(async (venue) => { if (r.OnSave is not null) await r.OnSave(venue); Close(r); })"
                OnClose="@(() => { r.OnCancel?.Invoke(); Close(r); })" />
            break;

        case EditTipDialog.DialogRequest r:
            <EditTipDialog @key="r.Id" IsOpen="true" Tip="@r.Value" UserId="@r.UserId" ShowDate="@r.ShowDate"
                OnSave="@(async (tip) => { if (r.OnSave is not null) await r.OnSave(tip); Close(r); })"
                OnClose="@(() => { r.OnCancel?.Invoke(); Close(r); })" />
            break;

        case SingerPerformanceHistoryDialog.DialogRequest r:
            <SingerPerformanceHistoryDialog @key="r.Id" IsOpen="true" UserId="@r.UserId"
                OnClose="@(() => { r.OnClose?.Invoke(); Close(r); })" />
            break;

        case EditMediaDialog.DialogRequest r:
            <EditMediaDialog @key="r.Id" IsOpen="true" Media="@r.Value"
                OnSave="@(async (media) => { if (r.OnSave is not null) await r.OnSave(media); Close(r); })"
                OnClose="@(() => { r.OnCancel?.Invoke(); Close(r); })" />
            break;

        case BulkEditMediaDialog.DialogRequest r:
            <BulkEditMediaDialog @key="r.Id" IsOpen="true" Items="@r.Items"
                OnSave="@(async (model) => { await r.OnSave(model); Close(r); })"
                OnClose="@(() => { r.OnCancel?.Invoke(); Close(r); })" />
            break;

        case ShortcutsDialog.DialogRequest r:
            <ShortcutsDialog @key="r.Id" IsOpen="true"
                OnClose="@(() => { r.OnClose?.Invoke(); Close(r); })" />
            break;

        case ShowLyricsDialog.DialogRequest r:
            <ShowLyricsDialog @key="r.Id" IsOpen="true" Query="@r.Query"
                OnClose="@(() => { r.OnClose?.Invoke(); Close(r); })" />
            break;

        case ScreensDialog.DialogRequest r:
            <ScreensDialog @key="r.Id" IsOpen="true"
                OnClose="@(() => { r.OnClose?.Invoke(); Close(r); })" />
            break;
    }
}
