@using KHost.Abstractions.Services
@using KHost.UserInterface.Models

<Dialog IsOpen="IsOpen" Class="@($"{_rootClassName} {Class?.Trim()}".Trim())" OnClose="CloseAsync" CloseOnScrimClick="CloseOnScrimClick">
    <Header>
        <Icon Name="file-text" />
        @if (_loading)
        {
            <span>Lyrics</span>
        }
        else
        {              
            <span>Lyrics for @_lyrics?.Name</span>
        }
    </Header>
    <Body>
        @if (_loading)
        {
            <div class="kh-show-lyrics-dialog__loading">
                <Loader Type="Loader.LoaderType.Vinyl"></Loader>
                <div>Searching for lyrics for `@Query`...</div>
            </div>
        }
        else if (_lyrics is null)
        {
            <span>No lyrics found.</span>
        }
        else
        {
            <pre class="@(_rootClassName)__content">@_lyrics?.Text</pre>
        }
    </Body>
    <Footer>
        @if(_loading)
        {
            <span>...</span>
        }
        else
        {
            <span>Lyrics provided by <a href="@_lyrics?.ProviderUrl" target="_blank">@_lyrics?.ProviderName</a></span>
        }
    </Footer>
</Dialog>

