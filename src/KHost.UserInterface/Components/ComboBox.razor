@typeparam TItem

<div class="kh-combobox @(OpenWhenEmpty ? "kh-combobox--toggle" : "") @Class?.Trim()">
    <input type="text"
           @ref="_inputRef"
           class="kh-form-control kh-combobox__input"
           value="@_query"
           placeholder="@Placeholder"
           autocomplete="off"
           role="combobox"
           aria-expanded="@(_isOpen ? "true" : "false")"
           aria-autocomplete="list"
           data-menu-open="@(_isOpen ? "true" : "false")"
           data-has-rows="@(_results.Count > 0 ? "true" : "false")"
           data-kh-shortcut="@ShortcutId"
           @oninput="OnQueryChangedAsync"
           @onfocus="OnFocusAsync"
           @onfocusout="OnFocusOut"
           @onkeydown="OnKeyDownAsync" />

    @* Only on a box that lists everything: a name box that would otherwise list every singer gets none.
       Out of the tab order, since ArrowDown already opens the list from the field. *@
    @if (OpenWhenEmpty)
    {
        <button type="button"
                class="kh-combobox__toggle @(_isOpen ? "kh-combobox__toggle--open" : "")"
                tabindex="-1"
                aria-label="@(_isOpen ? "Hide the list" : "Show the list")"
                aria-expanded="@(_isOpen ? "true" : "false")"
                @onmousedown:preventDefault
                @onclick="ToggleAsync">
            <Icon Name="@(_isOpen ? "chevron-up" : "chevron-down")" />
        </button>
    }

    @if (_isOpen)
    {
        @* Takes the click that dismisses the menu, so it never lands on whatever is under it.
           Keeps focus in the field too, or the blur closes the menu before this click arrives. *@
        <div class="kh-combobox__overlay" @onmousedown:preventDefault @onclick="Close"></div>

        <ul class="kh-combobox__menu" role="listbox">
            @if (_isSearching && _results.Count == 0)
            {
                <li class="kh-combobox__message">Searching…</li>
            }
            else if (_results.Count == 0)
            {
                <li class="kh-combobox__message">No matches for “@_query”</li>
            }
            else
            {
                @for (var i = 0; i < _results.Count; i++)
                {
                    var index = i;
                    var item = _results[index];

                    @if (StartsGroup(index))
                    {
                        <li class="kh-combobox__group" role="presentation">@GroupOf(index)</li>
                    }

                    <li role="option" aria-selected="@(index == _highlighted ? "true" : "false")">
                        @* Otherwise the input blurs and the menu closes before the click lands. *@
                        <button type="button"
                                class="kh-combobox__option @(index == _highlighted ? "kh-combobox__option--highlighted" : "")"
                                @onmousedown:preventDefault
                                @onclick="() => SelectAsync(item)">@DisplayName(item)</button>
                    </li>
                }

                @if (_truncated)
                {
                    <li class="kh-combobox__message" role="presentation">Showing the first @MaxRows: type to narrow</li>
                }
            }
        </ul>
    }
</div>
