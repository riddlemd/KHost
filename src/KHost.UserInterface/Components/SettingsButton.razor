<DropdownMenu @ref="_menu" Class="kh-settings-menu" Title="Menu" CloseOnItemClick="false"
              OpenChanged="OnMenuOpenChanged">
    <Trigger><Icon Name="list" /></Trigger>
    <Items>
        @* Computed once and reused below rather than read again inside the flyout: LiveDisplay
           walks Displays, and this render may otherwise do that walk twice for one row. *@
        @{ var liveDisplay = LiveDisplay; }

        <button class="kh-dropdown__item @CurrentClass(HomeRoute)" type="button" @onclick="() => NavigateTo(HomeRoute)">
            <span class="kh-dropdown__check"><Icon Name="sliders2" /></span>
            Hosting Dashboard
        </button>

        <div class="kh-dropdown__divider"></div>
        <span class="kh-dropdown__heading">Quick Settings</span>

        <button class="kh-dropdown__item" type="button" @ref="_venueRowRef" @onclick="() => ToggleSection(VenueSection)">
            <span class="kh-dropdown__check"><Icon Name="geo-alt-fill" /></span>
            Venue
            <span class="kh-settings-menu__value">@(_selectedVenue?.Name ?? "None")</span>
            <Icon Name="chevron-left" Class="kh-settings-menu__chevron" />
        </button>

        <button class="kh-dropdown__item" type="button" @ref="_displayRowRef" @onclick="() => ToggleSection(DisplaySection)">
            <span class="kh-dropdown__check"><Icon Name="display" /></span>
            Display
            <span class="kh-settings-menu__value">@DisplayValueFor(liveDisplay)</span>
            <Icon Name="chevron-left" Class="kh-settings-menu__chevron" />
        </button>

        <button class="kh-dropdown__item" type="button" @ref="_themeRowRef" @onclick="() => ToggleSection(ThemeSection)">
            <span class="kh-dropdown__check"><Icon Name="palette-fill" /></span>
            Theme
            <span class="kh-settings-menu__value">@ThemeFlyout.NameOf(ThemeService, ThemeService.CurrentTheme)</span>
            <Icon Name="chevron-left" Class="kh-settings-menu__chevron" />
        </button>

        @foreach (var group in _groups)
        {
            <div class="kh-dropdown__divider"></div>
            <span class="kh-dropdown__heading">@group.Key</span>

            @* Not `page`: the Razor parser reads @page as the directive. *@
            @foreach (var settingsPage in group)
            {
                <button class="kh-dropdown__item @CurrentClass(settingsPage.Route)" type="button"
                        @onclick="() => NavigateTo(settingsPage.Route)">
                    <span class="kh-dropdown__check"><Icon Name="@settingsPage.Icon" /></span>
                    @settingsPage.Title
                </button>
            }
        }

        @if (CanExit)
        {
            <div class="kh-dropdown__divider"></div>

            <button class="kh-dropdown__item" type="button" @onclick="ExitAsync">
                <span class="kh-dropdown__check"><Icon Name="power" /></span>
                Exit
            </button>
        }
        @if (_openSection is not null)
        {
            <div class="kh-settings-menu__flyout" @ref="_flyoutRef">
                @if (IsOpen(VenueSection))
                {
                    <VenueFlyout Venues="_venues" SelectedVenue="_selectedVenue" Done="CloseMenu" />
                }
                else if (IsOpen(DisplaySection))
                {
                    <DisplayFlyout Displays="Displays" LiveDisplay="liveDisplay" Done="CloseMenu" Changed="StateHasChanged" />
                }
                else
                {
                    <ThemeFlyout Done="CloseMenu" />
                }
            </div>
        }
    </Items>
</DropdownMenu>
