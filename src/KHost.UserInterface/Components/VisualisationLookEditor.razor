@using KHost.Abstractions.Models

@* A disabled fieldset disables every control inside it, the video picker's search included. *@
<fieldset class="kh-visualisation-look" disabled="@Disabled">
    <div class="kh-venue-settings__field">
        <label for="visualisation-preset" class="kh-form-label">Preset</label>
        <select id="visualisation-preset" class="kh-form-select"
                value="@PresetKey(Look)" @onchange="SetPresetAsync">
            @if (!IsAvailable)
            {
                <option value="@PresetKey(Look)">@Look.PresetName: not there any more</option>
            }
            <option value="@VideoKey">A video from the library</option>
            <VisualiserPresetOptions Presets="Presets" />
        </select>
    </div>

    @if (Look.PresetSource == VisualiserPresetSource.Video)
    {
        <div class="kh-venue-settings__field kh-visualisation-look__video">
            <label class="kh-form-label">Video</label>
            <MediaPicker Types="[MediaType.Video]" MediaId="Look.VideoMediaId" MediaIdChanged="SetVideoAsync"
                         BrowseId="visualisation-video-browse" Placeholder="Pick a video" />
        </div>
        @if (PreviewNeedsEncode)
        {
            <p class="kh-note kh-visualisation-look__video-note">
                Preview plays MP4 (H.264) videos only; this one is converted for the screen when a song plays.
            </p>
        }
    }

    <div class="kh-venue-settings__row">
        <label for="visualisation-brightness" class="kh-form-label">Brightness</label>
        <span class="kh-visualisation-look__slider">
            <input id="visualisation-brightness" type="range" class="kh-visualisation-look__range"
                   min="@VisualisationEntry.MinBrightness" max="@VisualisationEntry.MaxBrightness" step="5"
                   value="@Look.Brightness"
                   @oninput="e => Adjust(Setting.Brightness, e.Value)"
                   @onchange="e => CommitAsync(Setting.Brightness, e.Value)" />
            <span class="kh-visualisation-look__value">@Look.Brightness%</span>
        </span>
    </div>

    <div class="kh-venue-settings__row">
        <label for="visualisation-saturation" class="kh-form-label">Colour</label>
        <span class="kh-visualisation-look__slider">
            <input id="visualisation-saturation" type="range" class="kh-visualisation-look__range"
                   min="@VisualisationEntry.MinSaturation" max="@VisualisationEntry.MaxSaturation" step="5"
                   value="@Look.Saturation"
                   @oninput="e => Adjust(Setting.Saturation, e.Value)"
                   @onchange="e => CommitAsync(Setting.Saturation, e.Value)" />
            <span class="kh-visualisation-look__value">@Look.Saturation%</span>
        </span>
    </div>

    @if (Look.PresetSource != VisualiserPresetSource.Video)
    {
        <div class="kh-venue-settings__row">
            <span class="kh-venue-settings__labelled">
                <label for="visualisation-sensitivity" class="kh-form-label">Audio sensitivity</label>
                <span class="kh-note">How hard it moves to the music. 100% is as the preset was made.</span>
            </span>
            <span class="kh-visualisation-look__slider">
                <input id="visualisation-sensitivity" type="range" class="kh-visualisation-look__range"
                       min="@VisualisationEntry.MinSensitivity" max="@VisualisationEntry.MaxSensitivity" step="10"
                       value="@Look.Sensitivity"
                       @oninput="e => Adjust(Setting.Sensitivity, e.Value)"
                       @onchange="e => CommitAsync(Setting.Sensitivity, e.Value)" />
                <span class="kh-visualisation-look__value">@Look.Sensitivity%</span>
            </span>
        </div>
    }

    @if (Look.PresetSource == VisualiserPresetSource.BuiltIn)
    {
        @if (HasBars(Look))
        {
            <div class="kh-venue-settings__row">
                <label for="visualisation-bars" class="kh-form-label">Bars</label>
                <select id="visualisation-bars" class="kh-form-select kh-visualisation-look__choice"
                        value="@Look.BarCount" @onchange="SetBarCountAsync">
                    @foreach (var count in VisualisationEntry.BarCounts)
                    {
                        <option value="@count">@count</option>
                    }
                </select>
            </div>
        }

        <label class="kh-venue-settings__row kh-form-check">
            <span class="kh-form-check-label">
                Respects venue theme
                <span class="kh-note">
                    Draws in the venue's theme colours at a venue that has a theme. The palette below
                    is kept for a venue that has none.
                </span>
            </span>
            <input id="visualisation-respects-theme" type="checkbox" class="kh-form-check-input"
                   checked="@Look.RespectsVenueTheme" @onchange="SetRespectsVenueThemeAsync" />
        </label>

        <div class="kh-venue-settings__row">
            <label for="visualisation-palette" class="kh-form-label">Palette</label>
            <select id="visualisation-palette" class="kh-form-select kh-visualisation-look__choice"
                    value="@Look.ColourScheme" @onchange="SetColourSchemeAsync">
                <option value="@VisualiserColourScheme.Classic">@ClassicWording(Look)</option>
                <option value="@VisualiserColourScheme.Theme">The screen's accent</option>
                <option value="@VisualiserColourScheme.Single">One colour</option>
            </select>
        </div>

        @if (Look.ColourScheme == VisualiserColourScheme.Single)
        {
            <div class="kh-venue-settings__row">
                <label for="visualisation-colour" class="kh-form-label">Palette colour</label>
                <ColourPicker Id="visualisation-colour" Value="@Look.Colour" ValueChanged="SetColourAsync" />
            </div>
        }
    }

    @if (ShowPreview)
    {
        <iframe @ref="_preview" class="kh-visualisation-look__preview" title="Preview of this visualisation"
                src="visualiser-preview.html" sandbox="allow-scripts"
                data-kh-visualiser-preview></iframe>
        <p class="kh-note">
            The preview plays a made-up beat under two sample lines, and shows every
            change as you make it. A song on the screen reacts to its own music.
        </p>
    }
</fieldset>
