@page "/settings/users-manager"
@attribute [Authorize(Policy = nameof(KHostPermission.EditUser))]
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<PageTitle>KHost &mdash; Manage Users</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <div class="kh-card">
            <div class="kh-card__header">
                <span class="kh-card__title"><Icon Name="person-fill" /> Users Manager</span>
                <button class="kh-button kh-button--primary" @onclick="OpenAddDialogAsync" type="button">
                    <Icon Name="plus-lg" /> Add User
                </button>
            </div>
            <div class="kh-card__body">
                <form class="kh-panel__form-row" @onsubmit:preventDefault>
                    <input type="text" class="kh-form-control kh-panel__form-grow" placeholder="Search Users..."
                            autocomplete="off" @bind="_searchQuery" @bind:event="oninput" @onchange="OnSearchChangedAsync" />
                </form>
            </div>
            <div class="kh-card__body">
                @if (_paginatedResult?.Items.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        @if (string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <Icon Name="person" />
                            <span>No Users yet. Add one using the button above to get started.</span>
                        }
                        else
                        {
                            <Icon Name="search" />
                            <span>No Users match your search.</span>
                        }
                    </div>
                }
                else
                {
                    <table class="kh-table">
                        <thead>
                            <tr>
                                <th class="kh-table__col--sortable" @onclick='() => OnSortColumnClicked("name")'>
                                    Name @if (_sortColumn == "name") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th>Notes</th>
                                <th>Groups</th>
                                <th>Total Tips</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _paginatedResult!.Items)
                            {
                                <tr>
                                    <td class="kh-table__cell--fill">@user.Name</td>
                                    <td class="kh-table__cell--fill">@user.Notes</td>
                                    <td>
                                        @foreach (var group in user.Groups)
                                        {
                                            <span class="kh-badge kh-badge--secondary">@group.Name</span>
                                        }
                                        @if (user.Groups.Count == 0)
                                        {
                                            <span >—</span>
                                        }
                                    </td>
                                    <td>$@_tipTotals.GetValueOrDefault(user.Id).ToString("F2")</td>
                                    <td class="kh-table__cell--actions">
                                        <button class="kh-singer-manager__edit-btn kh-button--icon-minimal" title="Edit User" @onclick="() => OpenEditDialogAsync(user)">
                                            <Icon Name="pencil" />
                                        </button>
                                        <button class="kh-singer-manager__history-btn kh-button--icon-minimal" title="View Performance History" @onclick="() => OpenPerformanceHistoryAsync(user)">
                                            <Icon Name="music-note-list" />
                                        </button>
                                        @if (!KHostUser.IsBuiltIn(user.Id))
                                        {
                                            <AuthorizeView Policy="@nameof(KHostPermission.DeleteUser)" Context="_auth">
                                            <button class="kh-singer-manager__delete-btn kh-button--icon-minimal" title="Delete User" @onclick="@(async () => await StartDeleteAsync(user))">
                                                <Icon Name="trash" />
                                            </button>
                                            </AuthorizeView>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <Pagination
                        CurrentPage="_currentPage"
                        TotalPages="@(_paginatedResult?.TotalPages ?? 0)"
                        OnPreviousPage="PreviousPageAsync"
                        OnNextPage="NextPageAsync" />
                }
            </div>
        </div>
    </div>
</div>
