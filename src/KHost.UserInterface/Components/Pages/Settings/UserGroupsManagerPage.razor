@page "/settings/user-groups-manager"
@attribute [Authorize(Policy = nameof(KHostPermission.EditGroup))]
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<PageTitle>KHost &mdash; Manage User Groups</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <div class="kh-card">
            <div class="kh-card__header">
                <span class="kh-card__title"><Icon Name="people-fill" /> User Groups Manager</span>
                <button class="kh-button kh-button--primary" @onclick="OpenAddDialogAsync" type="button">
                    <Icon Name="plus-lg" /> Add Group
                </button>
            </div>
            <div class="kh-card__body">
                <form class="kh-panel__form-row" @onsubmit:preventDefault>
                    <input type="text" class="kh-form-control kh-panel__form-grow" placeholder="Search Groups..."
                            autocomplete="off" @bind="_searchQuery" @bind:event="oninput" @onchange="OnSearchChangedAsync" />
                </form>
            </div>
            <div class="kh-card__body">
                @if (_paginatedResult?.Items.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        @if (string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <Icon Name="people" />
                            <span>No Groups yet. Add one using the button above to get started.</span>
                        }
                        else
                        {
                            <Icon Name="search" />
                            <span>No Groups match your search.</span>
                        }
                    </div>
                }
                else
                {
                    <table class="kh-table">
                        <thead>
                            <tr>
                                <th class="kh-table__col--sortable" @onclick='() => OnSortColumnClicked("name")'>
                                    Name @if (_sortColumn == "name") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th>Description</th>
                                <th>Permissions</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in _paginatedResult!.Items)
                            {
                                <tr>
                                    <td class="kh-table__cell--fill">@group.Name</td>
                                    <td class="kh-table__cell--fill">@group.Description</td>
                                    <td>
                                        @if (group.IsAdmin)
                                        {
                                            <span class="kh-badge kh-badge--secondary">Admin</span>
                                        }
                                        else
                                        {
                                            @foreach (var permission in group.Permissions)
                                            {
                                                <span class="kh-badge kh-badge--secondary">@permission</span>
                                            }
                                            @if (group.Permissions.Count == 0)
                                            {
                                                <span >—</span>
                                            }
                                        }
                                    </td>
                                    <td class="kh-table__cell--actions">
                                        <button class="kh-user-groups-manager__edit-btn kh-button--icon-minimal" title="Edit Group" @onclick="() => OpenEditDialogAsync(group)">
                                            <Icon Name="pencil" />
                                        </button>
                                        @if (!KHostUserGroup.IsBuiltIn(group.Id))
                                        {
                                            <AuthorizeView Policy="@nameof(KHostPermission.DeleteGroup)" Context="_auth">
                                            <button class="kh-user-groups-manager__delete-btn kh-button--icon-minimal" title="Delete Group" @onclick="@(async () => await StartDeleteAsync(group))">
                                                <Icon Name="trash" />
                                            </button>
                                            </AuthorizeView>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <Pagination
                        CurrentPage="_currentPage"
                        TotalPages="@(_paginatedResult?.TotalPages ?? 0)"
                        OnPreviousPage="PreviousPageAsync"
                        OnNextPage="NextPageAsync" />
                }
            </div>
        </div>
    </div>
</div>
