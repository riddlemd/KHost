@using KHost.Abstractions.Models

@if (Presets.Any(p => p.Source == VisualiserPresetSource.BuiltIn))
{
    <optgroup label="Built-in">
        @foreach (var preset in Presets.Where(p => p.Source == VisualiserPresetSource.BuiltIn))
        {
            <option value="@VisualisationsManagerPage.PresetKey(preset.Source, preset.Name)">@(preset.Title ?? preset.Name)</option>
        }
    </optgroup>
}
<optgroup label="MilkDrop presets">
    @foreach (var preset in Presets.Where(p => p.Source == VisualiserPresetSource.Bundled))
    {
        <option value="@VisualisationsManagerPage.PresetKey(preset.Source, preset.Name)">@preset.Name</option>
    }
</optgroup>
@if (Presets.Any(p => p.Source == VisualiserPresetSource.Imported))
{
    <optgroup label="Imported">
        @foreach (var preset in Presets.Where(p => p.Source == VisualiserPresetSource.Imported))
        {
            <option value="@VisualisationsManagerPage.PresetKey(preset.Source, preset.Name)">@preset.Name</option>
        }
    </optgroup>
}
