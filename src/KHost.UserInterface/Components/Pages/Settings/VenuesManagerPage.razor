@page "/settings/venues-manager"
@attribute [Authorize(Policy = nameof(KHostPermission.EditVenue))]
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<PageTitle>KHost &mdash; Manage Venues</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <div class="kh-card">
            <div class="kh-card__header">
                <span class="kh-card__title"><Icon Name="geo-alt-fill" /> Venues Manager</span>
                <button class="kh-button kh-button--primary" @onclick="OpenAddDialogAsync" type="button">
                    <Icon Name="plus-lg" /> Add Venue
                </button>
            </div>
            <div class="kh-card__body">
                <form class="kh-panel__form-row" @onsubmit:preventDefault>
                    <input type="text" class="kh-form-control kh-panel__form-grow" placeholder="Search venues..."
                            autocomplete="off" @bind="_searchQuery" @bind:event="oninput" @onchange="OnSearchChangedAsync" />
                </form>
            </div>
            <div class="kh-card__body">
                @if (_paginatedResult?.Items.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        @if (string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <Icon Name="geo-alt" />
                            <span>No venues yet. Add one using the button above to get started.</span>
                        }
                        else
                        {
                            <Icon Name="search" />
                            <span>No venues match your search.</span>
                        }
                    </div>
                }
                else
                {
                    <table class="kh-table">
                        <thead>
                            <tr>
                                <th class="kh-table__col--sortable" @onclick='() => OnSortColumnClicked("name")'>
                                    Name @if (_sortColumn == "name") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th>Notes</th>
                                <th class="kh-table__col--sortable kh-table__cell--centered" @onclick='() => OnSortColumnClicked("enabled")'>
                                    Enabled @if (_sortColumn == "enabled") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var venue in _paginatedResult!.Items)
                            {
                                <tr>
                                    <td class="kh-table__cell--fill">@venue.Name</td>
                                    <td>@venue.Notes</td>
                                    <td class="kh-table__cell--centered">
                                        <Icon Name="@(venue.Enabled ? "check" : "x")" />
                                    </td>
                                    <td>
                                        <button class="kh-venues-manager__edit-btn kh-button--icon-minimal" @onclick="() => OpenEditDialogAsync(venue)" type="button">
                                            <Icon Name="pencil" />
                                        </button>
                                        <button class="kh-venues-manager__clone-btn kh-button--icon-minimal" title="Clone this venue" @onclick="() => CloneAsync(venue)" type="button">
                                            <Icon Name="copy" />
                                        </button>
                                        @{
                                            var isSelectedVenue = VenuesService?.SelectedVenueId == venue.Id;
                                        }
                                        <AuthorizeView Policy="@nameof(KHostPermission.DeleteVenue)" Context="_auth">
                                        <button class="kh-venues-manager__delete-btn kh-button--icon-minimal"
                                                title="@(isSelectedVenue ? "Switch to another venue before deleting this one" : "Delete Venue")"
                                                disabled="@isSelectedVenue"
                                                @onclick="@(async () => await StartDeleteAsync(venue))" type="button">
                                            <Icon Name="trash" />
                                        </button>
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <Pagination
                        CurrentPage="_currentPage"
                        TotalPages="@(_paginatedResult?.TotalPages ?? 0)"
                        OnPreviousPage="PreviousPageAsync"
                        OnNextPage="NextPageAsync" />
                }
            </div>
        </div>
    </div>
</div>
