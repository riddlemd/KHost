@page "/settings/ads-manager"
@attribute [Authorize(Policy = nameof(KHostPermission.ManageMedia))]
@using KHost.Abstractions.Models

<PageTitle>KHost: Ads</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <PlaylistManager Purpose="PoolPurpose.Ads"
                          Title="Ads Manager"
                          Icon="megaphone"
                          EmptyText="No ad playlists yet. Add one using the button above."
                          DeleteWarning="Any venue using it stops running ads."
                          ShowTrigger="true"
                          ActivePoolOf="settings => settings.AdPoolId" />
    </div>
</div>
