@page "/settings/plugins-manager"
@using KHost.Abstractions.Models.Plugins
@using KHost.UserInterface.Services
@using System.Text.Json

<PageTitle>KHost &mdash; Manage Plugins</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <div class="kh-card">
            <div class="kh-card__header">
                <span class="kh-card__title"><Icon Name="plug-fill" /> Plugins Manager</span>
            </div>
            @if (PluginsService?.RestartRequired == true)
            {
                <div class="kh-plugins-manager__restart-banner">
                    <Icon Name="arrow-clockwise" />
                    <span>Changes take effect after restarting KHost.</span>
                </div>
            }
            <div class="kh-card__body">
                @if (PluginsService is null || PluginsService.Plugins.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        <Icon Name="plug" />
                        <span>No plugins installed. Drop a plugin folder into <span class="kh-emphasis">@_pluginsDirectory</span> and restart KHost.</span>
                    </div>
                }
                else
                {
                    @foreach (var plugin in PluginsService.Plugins)
                    {
                        var manifest = plugin.Manifest;
                        var canEnable = plugin.Status is not (PluginStatus.Errored or PluginStatus.Incompatible) || _enabledIds.Contains(plugin.Id);

                        <div class="kh-plugins-manager__plugin" @key="plugin.Directory">
                            <div class="kh-plugins-manager__plugin__header">
                                <span class="kh-plugins-manager__plugin__name">@plugin.DisplayName</span>
                                @if (manifest is not null)
                                {
                                    <span class="kh-badge kh-badge--ext">v@(manifest.Version)</span>
                                }
                                <span class="kh-badge @GetStatusBadgeClass(plugin.Status)">@GetStatusLabel(plugin.Status)</span>
                                <label class="kh-checkbox kh-plugins-manager__plugin__toggle">
                                    <input type="checkbox" checked="@_enabledIds.Contains(plugin.Id)" disabled="@(!canEnable)"
                                           @onchange="async e => await ToggleAsync(plugin.Id, (bool)e.Value!)" />
                                    <span>Enabled</span>
                                </label>
                            </div>
                            <div class="kh-plugins-manager__plugin__meta">
                                @if (!string.IsNullOrWhiteSpace(manifest?.Description))
                                {
                                    <span>@manifest.Description</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(manifest?.Author))
                                {
                                    <span class="kh-plugins-manager__plugin__author">by @manifest.Author</span>
                                }
                            </div>
                            @if (plugin.Error is not null)
                            {
                                <div class="kh-plugins-manager__plugin__error">
                                    <Icon Name="exclamation-triangle-fill" />
                                    <span>@plugin.Error</span>
                                </div>
                            }
                            @foreach (var warning in plugin.Warnings)
                            {
                                <div class="kh-plugins-manager__plugin__warning">
                                    <Icon Name="exclamation-circle" />
                                    <span>@warning</span>
                                </div>
                            }
                            @if (manifest?.Settings.Count > 0 && _settingFields.TryGetValue(plugin.Id, out var fields))
                            {
                                <form class="kh-plugins-manager__plugin__settings" @onsubmit="async () => await SaveSettingsAsync(plugin.Id)" @onsubmit:preventDefault>
                                    @foreach (var field in fields)
                                    {
                                        <label class="kh-plugins-manager__plugin__setting">
                                            @if (field.Definition.Type == PluginSettingType.Bool)
                                            {
                                                <span class="kh-checkbox">
                                                    <input type="checkbox" @bind="field.Flag" />
                                                    <span>@field.Definition.Label</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span>@field.Definition.Label</span>
                                                <input class="kh-form-control"
                                                       type="@GetInputType(field.Definition)"
                                                       autocomplete="off"
                                                       @bind="field.Text" />
                                            }
                                        </label>
                                    }
                                    <button type="submit" class="kh-button kh-button--primary kh-plugins-manager__plugin__save-btn">
                                        <Icon Name="floppy" /> Save Settings
                                    </button>
                                </form>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
