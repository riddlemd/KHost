@page "/settings/plugins-manager"
@attribute [Authorize(Roles = KHost.UserInterface.Auth.KHostClaimsFactory.AdminRole)]
@using KHost.Abstractions.Models.Plugins
@using KHost.Common.Plugins

<PageTitle>KHost: Manage Plugins</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <div class="kh-card kh-plugins-manager">
            <div class="kh-card__header">
                <span class="kh-card__title"><Icon Name="plug-fill" /> Plugins Manager</span>
                <button type="button" class="kh-button kh-button--secondary" title="Open the plugins folder"
                        @onclick="() => OpenFolder(PluginDirectories.PluginsDirectory)">
                    <Icon Name="folder2-open" />
                </button>
            </div>
            <PluginRestartBanner RestartRequired="PluginsService.RestartRequired" Waiting="WaitingOnRestart.ToList()"
                                 StagingIsEmpty="_staging.IsEmpty" StagingSummary="StagingSummary" />
            <div class="kh-plugins-manager__tabs" role="tablist">
                <button type="button" role="tab" class="kh-plugins-manager__tab @(_tab == Tab.Installed ? "kh-plugins-manager__tab--active" : null)"
                        aria-selected="@(_tab == Tab.Installed ? "true" : "false")"
                        @onclick="() => SelectTab(Tab.Installed)">
                    <Icon Name="plug-fill" /> Installed <span class="kh-plugins-manager__count">@Plugins.Count</span>
                </button>
                <button type="button" role="tab" class="kh-plugins-manager__tab @(_tab == Tab.Available ? "kh-plugins-manager__tab--active" : null)"
                        aria-selected="@(_tab == Tab.Available ? "true" : "false")"
                        @onclick="() => SelectTab(Tab.Available)">
                    <Icon Name="cloud-arrow-down" /> Available
                    @if (CatalogEntries.Count > 0)
                    {
                        <span class="kh-plugins-manager__count">@CatalogEntries.Count</span>
                    }
                </button>
            </div>
            <div class="kh-card__body">
                @if (_tab == Tab.Available)
                {
                    <AvailablePluginsTab Staging="_staging" PluginsDirectory="PluginDirectories.PluginsDirectory" SetEnabledAsync="SetEnabledAsync" />
                }
                else if (Plugins.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        <Icon Name="plug" />
                        <span>No plugins installed. Drop a plugin folder into <span class="kh-emphasis">@PluginDirectories.PluginsDirectory</span> and restart KHost.</span>
                    </div>
                }
                else
                {
                    @foreach (var plugin in Plugins)
                    {
                        <InstalledPluginRow @key="plugin.Directory" Plugin="plugin" Draft="_drafts.GetValueOrDefault(plugin.Id)"
                                             Enabled="IsEnabled(plugin.Id)" Open="IsOpen(plugin)"
                                             PendingRemoval="IsPendingRemoval(plugin)" State="GetRowState(plugin)"
                                             RunningButtons="_runningButtons"
                                             OnToggleOpen="() => ToggleOpen(plugin)" OnChanged="StateHasChanged"
                                             SetEnabledAsync="SetEnabledAsync" SaveSettingsAsync="SaveSettingsAsync"
                                             Revert="Revert" RunButtonAsync="RunButtonAsync"
                                             ConfirmUninstallAsync="ConfirmUninstallAsync" ClearRemovalAsync="ClearRemovalAsync" />
                    }
                }
            </div>
        </div>
    </div>
</div>
