@page "/settings/tips-manager"
@using KHost.Abstractions.Models
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services

<PageTitle>KHost &mdash; Manage Tips</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <div class="kh-card">
            <div class="kh-card__header">
                <span class="kh-card__title"><Icon Name="coin" /> Tips Manager</span>
                <button class="kh-button kh-button--primary" @onclick="OpenAddDialogAsync" type="button">
                    <Icon Name="plus-lg" /> Add Tip
                </button>
            </div>
            <div class="kh-card__body">
                <form class="kh-panel__form-row" @onsubmit:preventDefault>
                    <input type="text" class="kh-form-control kh-panel__form-grow" placeholder="Search tips by notes..."
                            autocomplete="off" @bind="_searchQuery" @bind:event="oninput" @onchange="OnSearchChangedAsync" />
                </form>
            </div>
            <div class="kh-card__body">
                @if (_paginatedResult?.Items.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        @if (string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <Icon Name="coin" />
                            <span>No tips recorded yet. Add one using the button above to get started.</span>
                        }
                        else
                        {
                            <Icon Name="search" />
                            <span>No tips match your search.</span>
                        }
                    </div>
                }
                else
                {
                    <table class="kh-table">
                        <thead>
                            <tr>
                                <th class="kh-table__col--sortable" @onclick='() => OnSortColumnClicked("createdDate")'>
                                    Date @if (_sortColumn == "createdDate") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th>Singer</th>
                                <th class="kh-table__col--sortable" @onclick='() => OnSortColumnClicked("amount")'>
                                    Amount @if (_sortColumn == "amount") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th class="kh-table__col--sortable" @onclick='() => OnSortColumnClicked("paymentMethod")'>
                                    Payment Method @if (_sortColumn == "paymentMethod") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th>Venue</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tip in _paginatedResult!.Items)
                            {
                                <tr>
                                    <td>@tip.CreatedDate.ToString("MM/dd/yyyy HH:mm")</td>
                                    <td>@GetSingerName(tip.UserId)</td>
                                    <td>@tip.Amount.ToString("C")</td>
                                    <td>@tip.PaymentMethod</td>
                                    <td>@GetVenueName(tip.VenueId)</td>
                                    <td class="kh-table__cell--fill">@tip.Notes</td>
                                    <td class="kh-table__cell--actions">
                                        <button class="kh-tips-manager__edit-btn kh-button--icon-minimal" @onclick="() => OpenEditDialogAsync(tip)" type="button">
                                            <Icon Name="pencil" />
                                        </button>
                                        <button class="kh-tips-manager__delete-btn kh-button--icon-minimal" @onclick="@(async () => await StartDeleteAsync(tip))" type="button">
                                            <Icon Name="trash" />
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <Pagination
                        CurrentPage="_currentPage"
                        TotalPages="@(_paginatedResult?.TotalPages ?? 0)"
                        OnPreviousPage="PreviousPageAsync"
                        OnNextPage="NextPageAsync" />
                }
            </div>
        </div>
    </div>
</div>
