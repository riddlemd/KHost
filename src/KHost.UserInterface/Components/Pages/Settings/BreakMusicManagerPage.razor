@page "/settings/break-music-manager"
@attribute [Authorize(Policy = nameof(KHostPermission.ManageMedia))]
@using KHost.Abstractions.Models

<PageTitle>KHost: Break Music</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <PlaylistManager Purpose="PoolPurpose.BreakMusic"
                          Title="Break Music Playlists"
                          Icon="music-note-beamed"
                          EmptyText="No break music playlists yet. Add one using the button above."
                          DeleteWarning="Any venue using it falls back to silence."
                          ShowTrigger="false"
                          ActivePoolOf="settings => settings.BreakMusicPoolId" />
    </div>
</div>
