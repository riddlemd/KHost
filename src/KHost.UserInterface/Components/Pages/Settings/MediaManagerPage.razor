@page "/settings/media-manager"
@using KHost.Abstractions.Services
@using KHost.UserInterface.Models
@using KHost.UserInterface.Services
@implements IAsyncDisposable

<PageTitle>KHost &mdash; Media Library</PageTitle>

<div class="kh-app__body">
    <div class="kh-settings-page">
        <div class="kh-card">
            <div class="kh-card__header">
                <span class="kh-card__title"><Icon Name="music-note-list" /> Media Manager</span>
                <button class="kh-button kh-button--primary" @onclick="NavigateToImporter" type="button">
                    <Icon Name="plus-lg" /> Import New Song/s
                </button>
            </div>
            <div class="kh-card__body">
                <form class="kh-panel__form-row" @onsubmit:preventDefault>
                    <input type="text" class="kh-form-control kh-panel__form-grow" placeholder="Search by title or artist (press Enter)..."
                            autocomplete="off" @bind="_searchQuery" @bind:event="oninput" @onkeydown="OnSearchKeyDownAsync" />
                </form>
            </div>
            <div class="kh-card__body">
                @if (_paginatedResult?.Items.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        @if (string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <Icon Name="music-note-list" />
                            <span>No media in the library yet.</span>
                        }
                        else
                        {
                            <Icon Name="search" />
                            <span>No media match your search.</span>
                        }
                    </div>
                }
                else
                {
                    <table class="kh-table kh-media-manager__table">
                        <thead>
                            <tr>
                                <th class="kh-media-manager__col--check">
                                    <Icon Name="@SelectAllIconName" class="kh-media-manager__select-icon" @onclick="OnSelectAllClicked" />
                                </th>
                                <th class="kh-table__col--sortable" @onclick='() => OnSortColumnClicked("title")'>
                                    Title @if (_sortColumn == "title") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th class="kh-table__col--sortable" @onclick='() => OnSortColumnClicked("artist")'>
                                    Artist @if (_sortColumn == "artist") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th class="kh-media-manager__col--format kh-table__col--sortable" @onclick='() => OnSortColumnClicked("format")'>
                                    Format @if (_sortColumn == "format") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th class="kh-media-manager__col--duration kh-table__col--sortable" @onclick='() => OnSortColumnClicked("duration")'>
                                    Duration @if (_sortColumn == "duration") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th class="kh-media-manager__col--status kh-table__col--sortable" @onclick='() => OnSortColumnClicked("status")'>
                                    Status @if (_sortColumn == "status") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th class="kh-media-manager__col--date kh-table__col--sortable" @onclick='() => OnSortColumnClicked("dateAdded")'>
                                    Date Added @if (_sortColumn == "dateAdded") { <Icon Name="@(_sortDescending ? "sort-down" : "sort-up")" class="kh-table__sort-indicator" /> }
                                </th>
                                <th class="kh-media-manager__col--actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var media in _paginatedResult?.Items ?? [])
                            {
                                <tr class="@(_selectedIds.Contains(media.Id) ? "kh-media-manager__row--selected" : "")">
                                    <td class="kh-media-manager__col--check">
                                        <Icon Name="@(_selectedIds.Contains(media.Id) ? "check-square" : "square")"
                                              class="kh-media-manager__select-icon"
                                              @onclick="() => ToggleSelection(media.Id)" />
                                    </td>
                                    <td class="kh-table__cell--fill" title="@media.FilePath">@media.Title</td>
                                    <td>@media.Artist</td>
                                    <td>@media.Format</td>
                                    <td>
                                        @if (media.Duration is { } dur)
                                        {
                                            <span>@(((int)dur.TotalMinutes).ToString("D2")):@dur.Seconds.ToString("D2")</span>
                                        }
                                        else
                                        {
                                            <span class="kh-text--muted">--:--</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="kh-badge @GetStatusBadgeClass(media.Status)">@media.Status</span>
                                    </td>
                                    <td>@media.DateAdded.ToString("yyyy-MM-dd")</td>
                                    <td class="kh-media-manager__col--actions">
                                        <button class="kh-button kh-button--outline-secondary kh-button--icon-minimal" title="Edit" @onclick="() => EditAsync(media)" type="button">
                                            <Icon Name="pencil" />
                                        </button>
                                        <button class="kh-button kh-button--outline-danger kh-button--icon-minimal" title="Remove" @onclick="() => RemoveAsync(media)" type="button">
                                            <Icon Name="trash" />
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (_selectedIds.Count > 0)
                    {
                        <div class="kh-media-manager__bulk-edit-menu">
                            <div >
                                <SplitButton OnClick="EditSelectedAsync">
                                    <Text>
                                        <Icon Name="pencil" /> Edit @_selectedIds.Count Selected
                                    </Text>
                                    <Buttons>
                                        <button class="kh-button kh-button--danger" @onclick="DeleteSelectedAsync" type="button">
                                            <Icon Name="trash" /> Delete Selected
                                        </button>
                                    </Buttons>
                                </SplitButton>
                            </div>
                        </div>
                    }

                    <Pagination CurrentPage="_paginatedResult?.PageNumber ?? 1"
                                TotalPages="_paginatedResult?.TotalPages ?? 1"
                                OnPreviousPage="PreviousPage"
                                OnNextPage="NextPage" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const int _pageSize = 25;

    private int _currentPage = 1;
    private string _searchQuery = "";
    private string? _sortColumn;
    private bool _sortDescending;
    private PaginatedResult<Media>? _paginatedResult;
    private HashSet<Guid> _selectedIds = [];

    [Inject] private IMediaService? MediaService { get; set; }
    [Inject] private NavigationManager? Navigation { get; set; }
    [Inject] private IDialogService? DialogService { get; set; }
    [Inject] private IVenuesService? VenuesService { get; set; }

    private void NavigateToImporter() => Navigation!.NavigateTo("/settings/media-importer");

    private Task EditAsync(Media media) =>
        DialogService!.RequestEditAsync(media, onSave: updated =>
        {
            if (updated is not null)
                _ = MediaService!.UpdateAsync(updated);
        });

    private async Task RemoveAsync(Media media)
    {
        var venue = VenuesService is not null ? await VenuesService.ReadSelectedVenueAsync() : null;
        if (venue?.Settings.PromptBeforeRemovingMedia == true)
        {
            await DialogService!.ShowConfirmationAsync(
                $"Are you sure you want to remove <span class=\"kh-emphasis\">{media.Title}</span> from the library?",
                onConfirm: () => _ = MediaService!.DeleteAsync(media.Id),
                title: "Remove Media",
                confirmText: "Remove"
            );
        }
        else
        {
            await MediaService!.DeleteAsync(media.Id);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (MediaService is null)
            return;

        await SearchAsync();
        MediaService.StateChanged += OnMediaStateChanged;
    }

    private async Task SearchAsync()
    {
        if (MediaService is null)
            return;

        var sort = _sortColumn is not null ? new SortDescriptor(_sortColumn, _sortDescending) : null;
        _paginatedResult = await MediaService.SearchAsync(_searchQuery, _currentPage, _pageSize, sort);
    }

    private void OnSortColumnClicked(string column)
    {
        if (_sortColumn == column)
            _sortDescending = !_sortDescending;
        else
        {
            _sortColumn = column;
            _sortDescending = false;
        }
        _currentPage = 1;
        _ = SearchAsync();
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await SearchAsync();
        }
    }

    private void OnMediaStateChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await SearchAsync();
            StateHasChanged();
        });

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (MediaService is not null)
            MediaService.StateChanged -= OnMediaStateChanged;

        await Task.CompletedTask;
    }

    private async Task ClearSearch()
    {
        _searchQuery = "";
        await SearchAsync();
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            _selectedIds.Clear();
            await SearchAsync();
        }
    }

    private async Task NextPage()
    {
        if (_paginatedResult?.HasNextPage ?? false)
        {
            _currentPage++;
            _selectedIds.Clear();
            await SearchAsync();
        }
    }

    private void ToggleSelection(Guid mediaId)
    {
        if (_selectedIds.Contains(mediaId))
            _selectedIds.Remove(mediaId);
        else
            _selectedIds.Add(mediaId);
    }

    private void OnSelectAllClicked()
    {
        if (_selectedIds.Count == _paginatedResult?.Items.Count)
            _selectedIds.Clear();
        else
        {
            _selectedIds.Clear();
            foreach (var media in _paginatedResult?.Items ?? [])
                _selectedIds.Add(media.Id);
        }
    }

    private string SelectAllIconName =>
        _selectedIds.Count == 0 ? "square"
        : _selectedIds.Count == _paginatedResult?.Items.Count ? "check-square"
        : "slash-square";

    private async Task EditSelectedAsync()
    {
        var items = _paginatedResult?.Items
            .Where(m => _selectedIds.Contains(m.Id))
            .ToList() ?? [];

        if (items.Count == 0)
            return;

        await DialogService!.RequestBulkEditAsync(items, ApplyBulkEditAsync);
    }

    private async Task ApplyBulkEditAsync(BulkEditMediaModel model)
    {
        var items = _paginatedResult?.Items
            .Where(m => _selectedIds.Contains(m.Id))
            .ToList() ?? [];

        foreach (var media in items)
        {
            if (model.SwapTitleAndArtist)
                (media.Title, media.Artist) = (media.Artist, media.Title);
            if (model.UpdateArtist)
                media.Artist = model.Artist;

            await MediaService!.UpdateAsync(media);
        }

        _selectedIds.Clear();
    }

    private async Task DeleteSelectedAsync()
    {
        var items = _paginatedResult?.Items
            .Where(m => _selectedIds.Contains(m.Id))
            .ToList() ?? [];

        if (items.Count == 0)
            return;

        await DialogService!.ShowConfirmationAsync(
            $"Are you sure you want to remove {items.Count} item(s) from the library?",
            onConfirm: () => _ = DeleteSelectedItemsAsync(items),
            title: "Remove Media",
            confirmText: "Remove"
        );
    }

    private async Task DeleteSelectedItemsAsync(List<Media> items)
    {
        foreach (var media in items)
            await MediaService!.DeleteAsync(media.Id);

        _selectedIds.Clear();
    }

    private async Task ClearSelectionAsync()
    {
        _selectedIds.Clear();
        await Task.CompletedTask;
    }

    private static string GetStatusBadgeClass(MediaStatus status) => status switch
    {
        MediaStatus.Ready       => "kh-badge--success",
        MediaStatus.Downloading => "kh-badge--info",
        MediaStatus.Broken      => "kh-badge--danger",
        _                       => "kh-badge--secondary",
    };
}
