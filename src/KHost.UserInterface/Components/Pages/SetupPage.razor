@page "/setup"
@attribute [AllowAnonymous]
@layout SetupLayout
@using KHost.UserInterface.Components.Setup
@using KHost.Abstractions.Models

<PageTitle>KHost &mdash; Setup Wizard</PageTitle>

<div class="kh-setup-wizard">
    <div class="kh-setup-wizard__progress">
        <div class="kh-setup-wizard__progress-bar">
            <div class="kh-setup-wizard__progress-fill" style="@($"width: {CurrentStepProgress}%")"></div>
        </div>
        <div class="kh-setup-wizard__progress-text">
            Step @(_currentStep + 1) of @_steps.Count
        </div>
    </div>

    <div class="kh-setup-wizard__content">
        @switch (_steps[_currentStep])
        {
            case SetupStep.Security:
                <WizardStepSecurity OnComplete="@OnSecurityCompletedAsync" />
                break;
            case SetupStep.Admin:
                <WizardStep1AdminUser OnComplete="@(async () => await MoveToNextStepAsync())" />
                break;
            case SetupStep.Venue:
                <WizardStep2VenueSetup OnComplete="@(async () => await MoveToNextStepAsync())" />
                break;
            case SetupStep.Media:
                <WizardStep3MediaImport OnComplete="@OnSetupCompleteAsync" />
                break;
        }
    </div>
</div>
