@page "/login"
@attribute [AllowAnonymous]
@layout SetupLayout

<PageTitle>Sign in - KHost</PageTitle>

<div class="kh-login">
    <div class="kh-login__card">
        <h1 class="kh-login__title">KHost</h1>
        <p class="kh-login__subtitle">Sign in to run the show</p>

        @if (Failed is not null)
        {
            <div class="kh-alert--warning">Invalid name or password.</div>
        }

        <form class="kh-login__form" method="post" action="/auth/login">
            <div class="kh-login__group">
                <label class="kh-login__label" for="username">Username</label>
                <input class="kh-login__control" id="username" name="username" value="@_lastUser"
                       placeholder="Enter your username" autocomplete="username"
                       @ref="_usernameInput" required />
            </div>
            <div class="kh-login__group">
                <label class="kh-login__label" for="password">Password</label>
                <input class="kh-login__control" id="password" name="password" type="password"
                       placeholder="Enter your password" autocomplete="current-password"
                       @ref="_passwordInput" required />
            </div>
            <button class="kh-button kh-login__submit" type="submit">
                <Icon Name="box-arrow-in-right" /> Sign in
            </button>
        </form>
    </div>
</div>
