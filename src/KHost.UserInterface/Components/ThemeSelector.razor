@using KHost.UserInterface.Services
@implements IDisposable

<span class="kh-theme-selector input">
    Theme
    <DropdownMenu Class="kh-theme-selector__dropdown" Title="Change the app theme">
        <Trigger>@DisplayName(ThemeService?.CurrentTheme)</Trigger>
        <Items>
            @foreach (var theme in ThemeService?.AvailableThemes ?? [])
            {
                var isCurrent = ThemeService?.CurrentTheme == theme;

                <button class="kh-dropdown__item @(isCurrent ? "kh-dropdown__item--selected" : "")"
                        @onclick="() => SetThemeAsync(theme)">
                    <span class="kh-dropdown__check">
                        @if (isCurrent)
                        {
                            <Icon Name="check2" />
                        }
                    </span>
                    @DisplayName(theme)
                </button>
            }
        </Items>
    </DropdownMenu>
</span>

@code {
    [Inject] private IThemeService? ThemeService { get; set; }

    protected override void OnInitialized()
    {
        ThemeService?.StateChanged += OnStateChanged;
    }

    private async Task SetThemeAsync(string theme)
    {
        if (ThemeService is not null)
            await ThemeService.SetThemeAsync(theme);
    }

    private static string DisplayName(string? theme)
        => string.IsNullOrEmpty(theme) ? "" : char.ToUpper(theme[0]) + theme[1..];

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService?.StateChanged -= OnStateChanged;
    }
}
