<div class="kh-dropdown @Class" @ref="_rootRef">
    <button class="kh-dropdown__trigger"
            disabled="@Disabled"
            title="@Title"
            aria-haspopup="menu" aria-expanded="@_open"
            @onclick="Toggle">
        <span class="kh-dropdown__trigger-label">@Trigger</span>
        <Icon Name="@(_open ? "chevron-up" : "chevron-down")" Class="kh-dropdown__caret" />
    </button>

    @if (_open)
    {
        <div class="kh-dropdown__overlay" @onclick="Close"></div>

        <div class="kh-dropdown__menu" @ref="_menuRef" @onclick="OnMenuClick">
            @Items
        </div>
    }
</div>
