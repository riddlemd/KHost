@inherits LayoutComponentBase

<ThemeLink />

<header class="kh-header">
    <Icon Name="headphones" Class="kh-app__logo-icon" />
    <span class="kh-app__logo-text">KHost</span>
    <span class="kh-app__logo-sep">|</span>
    <span class="kh-app__logo-sub">Karaoke for the people, by the people.</span>
    @* The venue selector used to carry the auto margin that pushed these right; with it gone the
       gap has to be something the header owns. *@
    <span class="kh-header__gap"></span>
    <ScreensButton />
    <SettingsButton />
</header>

<div class="kh-app" tabindex="0">
    <FlashBanner />
    <KHostErrorBoundary>
        @Body
    </KHostErrorBoundary>
</div>

<footer class="kh-footer">
    <AppStatusBar />
</footer>

<DialogHost />

<div id="blazor-error-ui" class="kh-blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>