<span class="kh-app__toast-message">
    @if (ImportService!.State != ImportState.Idle)
    {
        <span class="kh-app__import-status">
            @if (ImportService.State == ImportState.Cancelling)
            {
                <Icon Name="x-circle" />
                <span>Cancelling import...</span>
            }
            else
            {
                <Icon Name="arrow-repeat" />
                <span>Importing @ImportService.ImportedCount / @ImportService.TotalCount...</span>
            }
        </span>
    }
    else
    {
        @_toastMessage
    }
</span>
<span class="kh-app__version">Version: @_version</span>
