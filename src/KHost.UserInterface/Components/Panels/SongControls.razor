@using KHost.Abstractions.Models
@using KHost.Abstractions.Services
@using KHost.UserInterface.Models

<div class="kh-song-controls" @onkeydown="OnKeyDown">
    <button type="button" class="kh-song-controls__trigger"
            disabled="@(PlaybackService?.CurrentPerformance is null)"
            title="@TriggerTitle"
            aria-expanded="@_open" aria-haspopup="true"
            @onclick="Toggle">
        <Icon Name="sliders" Class="@($"kh-song-controls__icon {(IsChanged ? "kh-song-controls__icon--on" : "")}")" />
    </button>

    @if (_open)
    {
        <div class="kh-song-controls__scrim" @onclick="Close"></div>

        <div class="kh-song-controls__panel kh-song-controls__panel--@(Style.ToString().ToLowerInvariant())">
            @foreach (var control in Controls())
            {
                @if (Style == SongControlStyle.Dials)
                {
                    <SongControlDial Label="@control.Label" AriaLabel="@control.AriaLabel"
                                     Value="@control.Value" Min="@control.Min" Max="@control.Max"
                                     Step="@control.Step" Format="@control.Format"
                                     ValueInput="@control.OnInput" ValueCommitted="@control.OnCommit" />
                }
                else
                {
                    <SongControlSlider Label="@control.Label" AriaLabel="@control.AriaLabel"
                                       Value="@control.Value" Min="@control.Min" Max="@control.Max"
                                       Step="@control.Step" Format="@control.Format"
                                       ValueInput="@control.OnInput" ValueCommitted="@control.OnCommit" />
                }
            }
        </div>
    }
</div>
