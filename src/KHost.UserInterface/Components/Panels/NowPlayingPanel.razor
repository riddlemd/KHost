@using KHost.UserInterface.Services

<div class="kh-now-playing-panel" tabindex="0" @onkeydown="OnKeyDownAsync">
    <div class="kh-card kh-now-playing">
    <div class="kh-card__header">
        <Icon Name="music-note-beamed" />
        <span class="kh-card__title">Now Playing</span>
        <BreakMusicBar />
    </div>

    <div class="kh-card__body kh-now-playing__body">
        @if (PlaybackService?.CurrentPerformance is null || PlaybackService?.CurrentMedia is null)
        {
            <div class="kh-now-playing__empty">
                <Icon Name="mic" Class="kh-now-playing__empty-icon" />
                <span class="kh-now-playing__empty-text">
                    No song loaded &mdash; click <Icon Name="play-fill" /> in the queue
                </span>
            </div>
        }
        else
        {
            var performance = PlaybackService.CurrentPerformance;
            var media = PlaybackService.CurrentMedia;
            var singer = SingerQueueService?.Users?.FirstOrDefault(u => u.Id == performance.SingerId);
            var isPlaying  = PlaybackService.State == PlaybackState.Playing;
            var isStopping = PlaybackService.State == PlaybackState.Stopping;
            var hasDur     = media.Duration is { TotalSeconds: > 0 };
            var pct       = hasDur
                ? Math.Clamp(PlaybackService.Position.TotalSeconds / media.Duration!.Value.TotalSeconds * 100, 0, 100)
                : 0;

            <div class="kh-now-playing__top-row @(isStopping ? "kh-now-playing__top-row--stopping" : "")">
                <div class="kh-now-playing__info">
                    <div class="kh-now-playing__media-title">@media.Title</div>
                    @if (!string.IsNullOrEmpty(media.Artist))
                    {
                        <div class="kh-now-playing__artist">@media.Artist</div>
                    }
                    @if (isStopping)
                    {
                        <div class="kh-now-playing__stopping">
                            <Icon Name="volume-down-fill" />
                            <span class="kh-now-playing__stopping-text">Fading out&hellip;</span>
                        </div>
                    }
                    else
                    {
                        <div class="kh-now-playing__singer-name">
                            <Icon Name="person-fill" />
                            @(singer?.Name ?? "Unknown")
                        </div>
                    }
                </div>

                <div class="kh-now-playing__controls">
                    <div class="kh-now-playing__key">
                        <button class="kh-now-playing__key-btn" @onclick="() => AdjustPitchAsync(-1)"
                                disabled="@(PlaybackService.Pitch <= IPlaybackService.MinPitch)"
                                title="Lower the key a semitone (−)">
                            <Icon Name="dash-lg" />
                        </button>
                        <span class="kh-now-playing__key-value @(PlaybackService.Pitch != 0 ? "kh-now-playing__key-value--shifted" : "")"
                              title="Key, in semitones from the recording">
                            @FormatPitch(PlaybackService.Pitch)
                        </span>
                        <button class="kh-now-playing__key-btn" @onclick="() => AdjustPitchAsync(1)"
                                disabled="@(PlaybackService.Pitch >= IPlaybackService.MaxPitch)"
                                title="Raise the key a semitone (+)">
                            <Icon Name="plus-lg" />
                        </button>
                    </div>

                    @if (isPlaying)
                    {
                        <button class="kh-now-playing__btn--play" @onclick="PlaybackService.PauseAsync" title="Pause">
                            <Icon Name="pause-fill" />
                        </button>
                    }
                    else
                    {
                        <button class="kh-now-playing__btn--play" @onclick="PlayAsync"
                                title="@(isStopping ? "Resume — cancels the fade out" : "Play")">
                            <Icon Name="play-fill" Class="kh-now-playing__icon-nudge" />
                        </button>
                    }
                    <button class="kh-now-playing__btn--stop" @onclick="PlaybackService.StopAsync"
                            title="@(isStopping ? "Fading out…" : "Stop")"
                            disabled="@(PlaybackService.State is PlaybackState.Stopped or PlaybackState.Stopping)">
                        <Icon Name="stop-fill" />
                    </button>
                </div>
            </div>

            <div class="kh-now-playing__progress-section">
                @if (hasDur)
                {
                    <div class="kh-now-playing__progress-track kh-now-playing__progress-track--seekable"
                         @ref="_trackRef" @onclick="SeekToClickAsync"
                         title="Click to skip to a point in the song">
                        <div class="kh-now-playing__progress-fill @(isPlaying ? "kh-now-playing__progress-fill--playing" : "") @(isStopping ? "kh-now-playing__progress-fill--stopping" : "")"
                             style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                        </div>
                    </div>
                }
                else if (isPlaying)
                {
                    <div class="kh-now-playing__progress-track">
                        <div class="kh-now-playing__progress-fill--indeterminate"></div>
                    </div>
                }
                else
                {
                    <div class="kh-now-playing__progress-track"></div>
                }
                <div class="kh-now-playing__times">
                    <span class="kh-now-playing__time">@FormatTime(PlaybackService.Position)</span>
                    <span class="kh-now-playing__time-separator">/</span>
                    <span class="kh-now-playing__time">@(hasDur ? FormatTime(media.Duration!.Value) : "--:--")</span>
                </div>
            </div>
        }
    </div>
    </div>
</div>
