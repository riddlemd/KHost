@using KHost.Abstractions.Models
@using KHost.Abstractions.Services
@using KHost.Domain.Services.MediaProviders
@using KHost.UserInterface.Services
@using KHost.Domain.Chronography;

<div class="kh-media-search-panel" tabindex="0">
    <div class="kh-card">
    <div class="kh-card__header">
        <Icon Name="search" />
        <span class="kh-card__title">Song Search</span>
        <span class="kh-card__shortcut">ctrl+2</span>
    </div>

    <div class="kh-card__body kh-media-search-panel__inputs">
        <Control>
            <input type="text" class="kh-form-control" placeholder="Type a Title or Artist"
                    autocomplete="off"
                    data-kh-shortcut="media-search"
                    @bind="_query"
                    @bind:event="oninput"
                    @onkeydown="OnFilterKeyDownAsync" />
        </Control>
        <SplitButton
            @onclick="RunSearchAsync"
            disabled="@(_searching)"
            Title="Search the local library">
                <Text>
                    @if (_searching)
                    {
                        <Loader Type="Loader.LoaderType.Spinner" />
                    }
                    else
                    {
                        <Icon Name="search" />
                    }
                </Text>
                <Buttons>
                    @foreach (var provider in MediaSearchService?.Providers ?? [])
                    {
                        <button @onclick="() => RunProviderSearchAsync(provider.SourceName, provider.DisplayName)">Search @provider.DisplayName</button>
                    }
                </Buttons>
        </SplitButton>
    </div>

    <div class="kh-card__body kh-card__body kh-media-search-panel__results">
        @if (_errorMessage is not null)
        {
            <div class="kh-alert--warning">
                <Icon Name="exclamation-triangle-fill" Class="me-1" />@_errorMessage
            </div>
        }

        @if (_searching)
        {
            <div class="kh-media-search-panel__searching">
                <Loader Type="Loader.LoaderType.Spinner" />
                <span class="kh-media-search-panel__searching-label">Searching @_searchingSource…</span>
                <button type="button" class="kh-button kh-button--danger" @onclick="CancelSearch">Cancel</button>
            </div>
        }

        @if (_results is not null && !_searching)
        {
            <div>
                @if (SingerQueueService?.SelectedUserId is null && _results.Count > 0)
                {
                    <span>
                        <Icon Name="arrow-left" Class="me-1" />Select a singer in the queue to add media
                    </span>
                }
            </div>

            <div class="kh-media-search-panel__results">
                @if (_results.Count == 0)
                {
                    <div class="kh-panel--empty">
                        <Icon Name="search" />
                        <span>No songs match that search.</span>
                    </div>
                }
                else
                {
                    <table class="kh-table">
                        <thead >
                            <tr>
                                <th>Title</th>
                                <th class="kh-media-search-panel__col--artist">Artist</th>
                                <th>Duration</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mediaSearchEntity in _results.Take(300))
                            {
                                    var queuedBy = GetSingersWithMediaQueued(mediaSearchEntity.ForeignKey, mediaSearchEntity.Source);

                                    <tr class="kh-media-search-panel__results__result @(queuedBy.Count > 0 ? "kh-media-search-panel__results__result--queued" : "")">
                                    <td class="kh-table__cell--fill" title="@mediaSearchEntity.Title">
                                        @mediaSearchEntity.Title

                                        @if (queuedBy.Count > 0)
                                        {
                                            <span class="kh-badge kh-badge--info kh-media-search-panel__queued-badge"
                                                  title="@($"Already queued by {string.Join(", ", queuedBy)}")">
                                                <Icon Name="person-check-fill" />
                                                @(queuedBy.Count == 1 ? queuedBy[0] : $"{queuedBy[0]} +{queuedBy.Count - 1}")
                                            </span>
                                        }
                                    </td>
                                    <td class="kh-table__cell--fill kh-media-search-panel__col--artist"
                                        title="@mediaSearchEntity.Artist">@mediaSearchEntity.Artist</td>
                                    <td>@(mediaSearchEntity.Duration?.ToTotalMinutesAndSeconds() ?? "--:--")</td>
                                    <td class="kh-table__cell--actions">
                                        @if (_canAddToQueue)
                                        {
                                        @foreach(var action in CombineWithGlobalActions(mediaSearchEntity.SupportedActions))
                                        {
                                            <SplitButton
                                                    disabled="@(SingerQueueService?.SelectedUserId is null)"
                                                    @onclick="() => PerformActionAsync(action.PerformAsync, mediaSearchEntity)"
                                                    title="@action.Description">
                                                <Text>
                                                    <Icon Name="@action.Icon" />
                                                    <span class="kh-media-search-panel__action-label">@action.DisplayName</span>
                                                </Text>
                                                <Buttons>
                                                    @foreach(var subAction in action.SubActions)
                                                    {
                                                        <button class="kh-button kh-button--primary"
                                                            disabled="@(SingerQueueService?.SelectedUserId is null)"
                                                            @onclick="() => PerformActionAsync(subAction.PerformAsync, mediaSearchEntity)"
                                                                title="@subAction.Description">
                                                            <Icon Name="@subAction.Icon" /> @subAction.DisplayName
                                                        </button>    
                                                    }
                                                </Buttons>
                                            </SplitButton>
                                        }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else if (!_searching)
        {
            <div class="kh-panel--empty">
                <Icon Name="cassette" />
                <span>No songs searched for yet.</span>
            </div>
        }
    </div>
    </div>
</div>
