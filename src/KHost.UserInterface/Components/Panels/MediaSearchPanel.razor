@using KHost.Abstractions.Models
@using KHost.Abstractions.Services
@using KHost.Domain.Services.MediaProviders
@using KHost.UserInterface.Services
@using KHost.Common.Chronography

<div class="kh-media-search-panel" tabindex="0">
    <div class="kh-card">
    <div class="kh-card__header">
        <Icon Name="search" />
        <span class="kh-card__title">Song Search</span>
        <span class="kh-card__shortcut">ctrl+2</span>
    </div>

    <div class="kh-card__body kh-media-search-panel__inputs">
        <Control>
            <input type="text" class="kh-form-control" placeholder="Type a Title or Artist"
                    autocomplete="off"
                    data-kh-shortcut="media-search"
                    @ref="_queryInputRef"
                    @bind="_query"
                    @bind:event="oninput"
                    @onkeydown="OnFilterKeyDownAsync" />
        </Control>
        <SplitButton
            @onclick="RunSearchAsync"
            disabled="@(_searching)"
            Title="@($"Search {SearchTargetLabel}")">
                <Text>
                    @if (_searching)
                    {
                        <Loader Type="Loader.LoaderType.Spinner" />
                    }
                    else
                    {
                        <Icon Name="search" />
                    }
                    <span class="kh-media-search-panel__source">@SearchTargetLabel</span>
                </Text>
                <Buttons>
                    @foreach (var provider in UnselectedProviders)
                    {
                        <button @onclick="() => SelectSource(provider.SourceName)">@provider.DisplayName</button>
                    }
                </Buttons>
        </SplitButton>
    </div>

    <div class="kh-card__body kh-media-search-panel__results">
        @if (_errorMessage is not null)
        {
            <div class="kh-alert--warning">
                <Icon Name="exclamation-triangle-fill" Class="me-1" />@_errorMessage
            </div>
        }

        @if (_searching)
        {
            <div class="kh-media-search-panel__searching">
                <Loader Type="Loader.LoaderType.Spinner" />
                <span class="kh-media-search-panel__searching-label">Searching @_searchingSource…</span>
                <button type="button" class="kh-button kh-button--danger" @onclick="CancelSearch">Cancel</button>
            </div>
        }

        @if (_results is not null && !_searching)
        {
            <div>
                @if (SingerQueueService?.SelectedUserId is null && _results.Count > 0)
                {
                    <span>
                        <Icon Name="arrow-left" Class="me-1" />Select a singer in the queue to add media
                    </span>
                }
            </div>

            <div>
                @if (_results.Count == 0)
                {
                    <div class="kh-panel--empty">
                        <Icon Name="search" />
                        <span>No songs match that search.</span>
                    </div>
                }
                else
                {
                    var columns = MediaResultColumnSet.For(_results, MediaSearchService?.Providers ?? []);

                    RenderFragment<MediaSearchEntity> Actions = entity =>
                        @<text>
                            @if (_canAddToQueue)
                            {
                                @foreach (var action in CombineWithGlobalActions(entity.SupportedActions))
                                {
                                    <SplitButton
                                            disabled="@(SingerQueueService?.SelectedUserId is null)"
                                            @onclick="() => PerformActionAsync(action, entity)"
                                            title="@action.Description">
                                        <Text>
                                            <Icon Name="@action.Icon" />
                                            <span class="kh-media-search-panel__action-label">@action.DisplayName</span>
                                        </Text>
                                        <Buttons>
                                            @foreach (var subAction in action.SubActions)
                                            {
                                                <button class="kh-button kh-button--primary"
                                                        disabled="@(SingerQueueService?.SelectedUserId is null)"
                                                        @onclick="() => PerformActionAsync(subAction, entity)"
                                                        title="@subAction.Description">
                                                    <Icon Name="@subAction.Icon" /> @subAction.DisplayName
                                                </button>
                                            }
                                        </Buttons>
                                    </SplitButton>
                                }
                            }
                        </text>;

                    <table class="kh-table kh-media-search-panel__table">
                        <thead>
                            <tr>
                                @for (var i = 0; i < columns.Count; i++)
                                {
                                    <th class="@ColumnClass(columns, i)">@columns[i].Header</th>
                                }
                                <th class="kh-media-search-panel__col--actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mediaSearchEntity in _results.Take(300))
                            {
                                var queuedBy = GetSingersWithMediaQueued(mediaSearchEntity.ForeignKey, mediaSearchEntity.Source);

                                if (mediaSearchEntity.SpansAllColumns)
                                {
                                    <tr class="kh-media-search-panel__results__result kh-media-search-panel__offer">
                                        @* One cell across the table and the header above it: the columns describe a
                                           song this row is not, and an action named for what it does needs the width. *@
                                        <td colspan="@(columns.Count + 1)">
                                            <div class="kh-media-search-panel__offer-body">
                                                @if (OfferImage(mediaSearchEntity) is { Length: > 0 } image)
                                                {
                                                    <img class="kh-media-search-panel__offer-image" src="@image" alt="" loading="lazy" />
                                                }
                                                <div class="kh-media-search-panel__offer-text">
                                                    <span class="kh-media-search-panel__offer-title">@mediaSearchEntity.Title</span>
                                                    @if (!string.IsNullOrWhiteSpace(mediaSearchEntity.Notes))
                                                    {
                                                        <span class="kh-media-search-panel__offer-notes">@mediaSearchEntity.Notes</span>
                                                    }
                                                </div>
                                                <div class="kh-media-search-panel__offer-actions">
                                                    @Actions(mediaSearchEntity)
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="kh-media-search-panel__results__result @(queuedBy.Count > 0 ? "kh-media-search-panel__results__result--queued" : "")">
                                    @for (var i = 0; i < columns.Count; i++)
                                    {
                                        var column = columns[i];
                                        var value = MediaResultColumnSet.Value(mediaSearchEntity, column);

                                        <td class="@ColumnClass(columns, i)" title="@(column.EffectiveKind == MediaResultColumnKind.Thumbnail ? null : value)">
                                            @if (column.EffectiveKind == MediaResultColumnKind.Thumbnail)
                                            {
                                                @if (!string.IsNullOrEmpty(value))
                                                {
                                                    <img class="kh-media-search-panel__thumb" src="@value" alt="" loading="lazy" />
                                                }
                                            }
                                            else
                                            {
                                                @value
                                            }

                                            @if (i == MediaResultColumnSet.PrimaryIndex(columns) && queuedBy.Count > 0)
                                            {
                                                @* The glyph alone. Who has it queued is in the title,
                                                   and a name repeated beside the song it is queued
                                                   against says nothing the hover does not. *@
                                                <span class="kh-badge kh-badge--info kh-media-search-panel__queued-badge"
                                                      title="@QueuedByLabel(queuedBy)"
                                                      aria-label="@QueuedByLabel(queuedBy)"
                                                      role="img">
                                                    <Icon Name="person-check-fill" />
                                                </span>
                                            }
                                        </td>
                                    }
                                    <td class="kh-table__cell--actions">
                                        @Actions(mediaSearchEntity)
                                    </td>
                                </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else if (!_searching)
        {
            <div class="kh-panel--empty">
                <Icon Name="cassette" />
                <span>No songs searched for yet.</span>
            </div>
        }
    </div>
    </div>
</div>
