@using KHost.UserInterface.Components.Dialogs
@using KHost.UserInterface.Services
@using Microsoft.Extensions.Options

<div class="kh-singer-queue-panel kh-card">
    <div class="kh-card__header">
        <Icon Name="people-fill" />
        <span class="kh-card__title">Singer Queue</span>
        @if (SingerQueueService?.Users.Count > 0)
        {
            <span class="kh-badge kh-badge--secondary kh-singer-queue-panel__singer-count" title="Number of singers in queue">@SingerQueueService.Users.Count</span>
        }
        <span class="kh-card__shortcut">ctrl+1</span>
    </div>
    @if (_canAddToQueue)
    {
    @* Not a scrolling body like the queue below it: the picker's menu opens into the card. *@
    <div class="kh-card__body kh-singer-queue-panel__add">
        <form name="add-singer-form" class="kh-panel__form-row" @onsubmit="AddUserAsync" @onsubmit:preventDefault>
            <ComboBox TItem="KHostUser"
                      ShortcutId="new-singer"
                      Class="kh-panel__form-grow"
                      Value="_pickedSinger"
                      ValueChanged="OnSingerPickedAsync"
                      @bind-Text="_newSingerName"
                      Search="SearchSingersAsync"
                      DisplayName="@(singer => singer.Name)"
                      GroupName="GroupForSinger"
                      MinimumSearchLength="1"
                      Placeholder="Type New Singer's Name..." />
            <button type="submit" class="kh-singer-queue-panel__add-btn kh-button kh-button--primary"
                    disabled="@string.IsNullOrWhiteSpace(_newSingerName)" title="Add Singer to Queue">
                <Icon Name="plus-lg" />
            </button>
        </form>
    </div>
    }
    <div class="kh-singer-queue-panel__singer-queue kh-card__body"
         tabindex="0" @onkeydown="OnKeyDownAsync">
        @if (!SingerQueueService?.Users.Any() == true)
        {
            <div class="kh-panel--empty kh-panel--empty-lg">
                <Icon Name="person-plus" />
                <span>No singers yet. Add one above to get started.</span>
            </div>
        }

        @foreach (var (user, userIdx) in SingerQueueService?.Users.Select((u, i) => (u, i)) ?? [])
        {
            var isCurrentlyPerforming = PlaybackService?.CurrentlyPerformingUserId == user.Id;
            var isFirst = userIdx == 0;
            var disableMoveUp = isFirst || isCurrentlyPerforming || (userIdx == 1 && SingerQueueService?.IsTopSlotLocked == true);
            var disableMoveDown = userIdx == SingerQueueService?.Users.Count - 1 || isCurrentlyPerforming;
            var disableRemove = isCurrentlyPerforming;
            var mediaCount = _performanceCounts.GetValueOrDefault(user.Id, 0);
            var ewt = CalculateEwt(userIdx);

            <div class="@GetSingerRowClasses(user.Id, isFirst)"
                 @key="user.Id"
                 data-singer-id="@user.Id"
                 @onclick="() => SingerQueueService?.SelectUserAsync(user.Id) ?? Task.CompletedTask">
                @if (_canReorderQueue)
                {
                    <button class="kh-singer-queue-panel__drag-handle kh-button--icon-minimal"
                            title="Drag to reorder"
                            @onclick:stopPropagation>
                        <Icon Name="grip-vertical" />
                    </button>
                }
                <div class="kh-singer-queue-panel__singer-queue__singer__icon">
                    @if (isFirst && PlaybackService?.CurrentPerformance?.SingerId == user.Id && PlaybackService.State == PlaybackState.Playing)
                    {
                        <div class="kh-now-playing__bars kh-now-playing__bars--sm">
                            <div class="kh-now-playing__bar"></div>
                            <div class="kh-now-playing__bar"></div>
                            <div class="kh-now-playing__bar"></div>
                        </div>
                    }
                    else
                    {
                        <Icon Name="person-circle" />
                    }
                </div>
                <div class="kh-singer-queue-panel__singer-queue__singer__text">
                    <div class="kh-singer-queue-panel__singer-queue__singer__name">@user.Name</div>
                    <div class="kh-singer-queue-panel__singer-queue__singer__info">
                        <span class="@(mediaCount <= 0 ? "kh-singer-queue-panel__empty-queue" : null)">@mediaCount media queued</span>
                        @if (_showEwt && ewt > TimeSpan.Zero)
                        {
                            <span>EWT: @FormatEwt(ewt)</span>
                        }
                    </div>
                </div>

                <div class="kh-singer-queue-panel__singer-queue__singer__actions">
                    @if (_canReorderQueue)
                    {
                    <button class="kh-singer-queue-panel__singer-queue__singer__move-up-btn kh-button--icon-minimal" title="Move up (Shift+Up)"
                            disabled="@disableMoveUp"
                            @onclick="async () => await (SingerQueueService?.MoveUserUpAsync(user.Id) ?? Task.CompletedTask)"
                            @onclick:stopPropagation>
                        <Icon Name="chevron-up" />
                    </button>
                    <button class="kh-singer-queue-panel__singer-queue__singer__move-down-btn kh-button--icon-minimal" title="Move down (Shift+Down)"
                            disabled="@disableMoveDown"
                            @onclick="async () => await (SingerQueueService?.MoveUserDownAsync(user.Id) ?? Task.CompletedTask)"
                            @onclick:stopPropagation>
                        <Icon Name="chevron-down" />
                    </button>
                    }
                    @if (_canRemoveFromQueue)
                    {
                    <button class="kh-singer-queue-panel__singer-queue__singer__remove-btn kh-button--icon-danger" title="Remove singer"
                            disabled="@disableRemove"
                            @onclick="@(async () => await ConfirmRemoveUserAsync(user))"
                            @onclick:stopPropagation>
                        <Icon Name="x-lg" />
                    </button>
                    }
                </div>
            </div>
        }
    </div>
</div>
