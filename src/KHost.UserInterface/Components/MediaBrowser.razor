@using KHost.Abstractions.Repositories
@using KHost.Abstractions.Services
@using System.Collections.Concurrent

<div class="kh-card">
            <div class="kh-card__header">
                <span class="kh-card__title"><Icon Name="folder2-open" /> Media Importer</span>
                @if (ImportService!.State != ImportState.Idle)
                {
                    <span class="kh-media-importer__progress">
                        @if (ImportService.State == ImportState.Cancelling)
                        {
                            <span>Cancelling...</span>
                        }
                        else
                        {
                            <Icon Name="arrow-repeat" />
                            <span>@ImportService.ImportedCount / @ImportService.TotalCount imported</span>
                            @if (ImportService.FailedCount > 0)
                            {
                                <span class="kh-badge kh-badge--secondary">@ImportService.FailedCount failed</span>
                            }
                        }
                    </span>
                    <button class="kh-button kh-button--outline-danger"
                            disabled="@(ImportService.State == ImportState.Cancelling)"
                            @onclick="() => ImportService.Cancel()"
                            type="button">
                        <Icon Name="x-lg" /> Cancel
                    </button>
                }
                else if (_currentPath is not null || _selectedPaths.Count > 0 || _selectedFolderPaths.Count > 0)
                {
                    <div class="kh-media-importer__header-actions">
                        @if (_currentPath is not null)
                        {
                            <button class="kh-button kh-button--outline-secondary"
                                    @onclick="() => _hideImported = !_hideImported"
                                    type="button">
                                <Icon Name="@(_hideImported ? "eye-slash" : "eye")" /> @(_hideImported ? "Show in-library" : "Hide in-library")
                            </button>
                        }
                        <button class="kh-button kh-button--primary"
                                disabled="@(_selectedPaths.Count == 0 && _selectedFolderPaths.Count == 0)"
                                @onclick="StartImportAsync"
                                type="button">
                            @{
                                var _importParts = new List<string>();
                                if (_selectedPaths.Count > 0) _importParts.Add($"{_selectedPaths.Count} file{(_selectedPaths.Count == 1 ? "" : "s")}");
                                if (_selectedFolderPaths.Count > 0) _importParts.Add($"{_selectedFolderPaths.Count} folder{(_selectedFolderPaths.Count == 1 ? "" : "s")}");
                            }
                            <Icon Name="download" /> Import@(_importParts.Count > 0 ? $" ({string.Join(", ", _importParts)})" : "")
                        </button>
                    </div>
                }
            </div>

            <div class="kh-card__body kh-media-importer__path-bar">
                <div class="kh-media-importer__breadcrumb">
                    @if (_currentPath is not null)
                    {
                        <button class="kh-button--icon-minimal" @onclick="GoUpAsync" type="button" title="Up one level">
                            <Icon Name="arrow-left" />
                        </button>
                    }
                    @if (_breadcrumbEditMode)
                    {
                        <input type="text"
                               class="kh-media-importer__path-input"
                               placeholder="Enter a path..."
                               autocomplete="off"
                               spellcheck="false"
                               @bind="_pathInput"
                               @bind:event="oninput"
                               @onkeydown="OnPathInputKeyDownAsync" />
                    }
                    else if (_currentPath is not null)
                    {
                        <div class="kh-media-importer__breadcrumb-path">
                            @foreach (var (display, fullPath) in GetBreadcrumbSegments())
                            {
                                <button class="kh-media-importer__breadcrumb-segment"
                                        @onclick="async () => await NavigateToAsync(fullPath)"
                                        type="button">
                                    @display
                                </button>
                                @if (fullPath != _currentPath)
                                {
                                    <span class="kh-media-importer__breadcrumb-separator">›</span>
                                }
                            }
                        </div>
                    }
                    <button class="kh-button--icon-minimal"
                            @onclick="() => _breadcrumbEditMode = !_breadcrumbEditMode"
                            type="button"
                            title="@(_breadcrumbEditMode ? "Done" : "Edit path")">
                        <Icon Name="@(_breadcrumbEditMode ? "check-lg" : "pencil")" />
                    </button>
                    <button class="kh-button--icon-minimal"
                            disabled="@(ImportService!.State != ImportState.Idle)"
                            @onclick="RefreshAsync"
                            type="button"
                            title="Refresh">
                        <Icon Name="arrow-clockwise" />
                    </button>
                    <input type="text"
                           class="kh-media-importer__filter-input"
                           placeholder="Filter files..."
                           autocomplete="off"
                           spellcheck="false"
                           @bind="_filterQuery"
                           @bind:event="oninput" />
                </div>
            </div>

            <div class="kh-card__body kh-media-importer__listing">
                @if (_entries.Count == 0)
                {
                    <div class="kh-panel--empty kh-panel--empty-lg">
                        <Icon Name="folder2" />
                        <span>No supported files in this folder.</span>
                    </div>
                }
                else
                {
                    <table class="kh-table kh-media-importer__table">
                        <thead>
                            <tr>
                                <th class="kh-media-importer__col--check">
                                    <Icon Name="@SelectAllIconName"
                                          class="@(!HasNewFiles && !HasSelectableFolders ? "kh-media-importer__check kh-media-importer__check--disabled" : "kh-media-importer__check")"
                                          @onclick="OnSelectAllClicked" />
                                </th>
                                <th class="kh-media-importer__col--sortable" @onclick="() => OnSortColumnClicked(SortColumn.Name)" style="cursor: pointer;">
                                    Name
                                    @if (_sortColumn == SortColumn.Name)
                                    {
                                        <Icon Name="@(_sortAsc ? "sort-up" : "sort-down")" class="kh-media-importer__sort-indicator" />
                                    }
                                </th>
                                <th class="kh-media-importer__col--size kh-media-importer__col--sortable" @onclick="() => OnSortColumnClicked(SortColumn.Size)" style="cursor: pointer;">
                                    Size
                                    @if (_sortColumn == SortColumn.Size)
                                    {
                                        <Icon Name="@(_sortAsc ? "sort-up" : "sort-down")" class="kh-media-importer__sort-indicator" />
                                    }
                                </th>
                                <th class="kh-media-importer__col--modified kh-media-importer__col--sortable" @onclick="() => OnSortColumnClicked(SortColumn.Modified)" style="cursor: pointer;">
                                    Modified
                                    @if (_sortColumn == SortColumn.Modified)
                                    {
                                        <Icon Name="@(_sortAsc ? "sort-up" : "sort-down")" class="kh-media-importer__sort-indicator" />
                                    }
                                </th>
                                <th class="kh-media-importer__col--status kh-media-importer__col--sortable" @onclick="() => OnSortColumnClicked(SortColumn.Status)" style="cursor: pointer;">
                                    Status
                                    @if (_sortColumn == SortColumn.Status)
                                    {
                                        <Icon Name="@(_sortAsc ? "sort-up" : "sort-down")" class="kh-media-importer__sort-indicator" />
                                    }
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in FilteredEntries)
                            {
                                <tr class="@(entry.IsDirectory ? "kh-media-importer__row--dir" : "") @(entry.IsDirectory && _selectedFolderPaths.Contains(entry.FullPath) ? "kh-media-importer__row--dir--selected" : "")"
                                    @onclick="() => OnEntryClickAsync(entry)"
                                    @onmouseover="() => GetParsedMetadataTooltip(entry)"
                                    title="@GetParsedMetadataTooltip(entry)">
                                    <td class="kh-media-importer__col--check" @onclick:stopPropagation>
                                        @if (entry.IsDirectory && entry.Name != "..")
                                        {
                                            <Icon Name="@(_selectedFolderPaths.Contains(entry.FullPath) ? "check-square" : "square")"
                                                  class="kh-media-importer__check"
                                                  @onclick="() => ToggleFolderSelection(entry)" />
                                        }
                                        else if (!entry.IsDirectory)
                                        {
                                            <Icon Name="@(_selectedPaths.Contains(entry.FullPath) ? "check-square" : "square")"
                                                  class="@(entry.AlreadyImported ? "kh-media-importer__check kh-media-importer__check--disabled" : "kh-media-importer__check")"
                                                  @onclick="() => ToggleSelection(entry)" />
                                        }
                                    </td>
                                    <td class="kh-table__cell--fill" title="@GetParsedMetadataTooltip(entry)">
                                        @if (entry.IsDirectory)
                                        {
                                            <Icon Name="folder-fill" />
                                        }
                                        else
                                        {
                                            <Icon Name="file-earmark-music" />
                                        }
                                        @entry.Name
                                        @if (entry.IsDirectory && entry.SupportedFileCount is not null)
                                        {
                                            <span class="kh-media-importer__folder-count"> (@entry.SupportedFileCount)</span>
                                        }
                                    </td>
                                    <td class="kh-media-importer__col--size">
                                        @if (entry.IsDirectory)
                                        {
                                            <span class="kh-text--muted">—</span>
                                        }
                                        else
                                        {
                                            <span>@FormatFileSize(entry.Size)</span>
                                        }
                                    </td>
                                    <td class="kh-media-importer__col--modified">
                                        @if (entry.ModifiedDate != DateTime.MinValue)
                                        {
                                            <span>@entry.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="kh-text--muted">—</span>
                                        }
                                    </td>
                                    <td class="kh-media-importer__col--status">
                                        @if (entry.AlreadyImported)
                                        {
                                            <span class="kh-badge kh-badge--success">In Library</span>
                                        }
                                        else
                                        {
                                            <span>Available</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!FilteredEntries.Any(e => !e.IsDirectory))
                            {
                                <tr class="kh-media-importer__row--empty">
                                    <td colspan="5">
                                        <div class="kh-panel--empty">
                                            <Icon Name="folder2" />
                                            <span>No supported files in this folder.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
