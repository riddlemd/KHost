<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships in the package so a plugin author sees these in IntelliSense; missing one is an
         error here so Common can't silently regress. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- Helpers a plugin may want as much as the host does: no project references, so taking one
         drags in nothing of KHost's own. -->
    <Description>Helpers shared by KHost and the plugins it loads.</Description>
    <!-- Published beside KHost.Abstractions: a plugin builds against both. -->
    <IsPackable>true</IsPackable>
    <Version>$(ContractsVersion)</Version>
    <PackageTags>khost;karaoke;plugin</PackageTags>
    <!-- MIT, while the rest of KHost is PolyForm Shield: a plugin ships a copy of this assembly,
         so a non-compete term here would forbid copyleft plugins outright. See ./LICENSE. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Michael Riddle</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT to MIT. Common sits above Abstractions: helpers may use the contracts, never
         the other way round. -->
    <ProjectReference Include="..\KHost.Abstractions\KHost.Abstractions.csproj" />
  </ItemGroup>

</Project>
