<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>KHost.LocalScreen</AssemblyName>
    <RootNamespace>KHost.LocalScreen</RootNamespace>
  </PropertyGroup>

  <!-- Windows-only: WinExe so no console window appears behind the screen output. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The app icon: embedded in the exe for Explorer and the taskbar, and copied beside it for the
       window and the Dock, which read it at runtime. assets/icon/build-icons.py regenerates them. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);KHOST_LOCALSCREEN</DefineConstants>
    <ApplicationIcon>..\..\assets\icon\khost.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AppIcon.cs" Link="AppIcon.cs" />
    <None Include="..\..\assets\icon\khost.ico" Link="icons\khost.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\icon\khost.icns" Link="icons\khost.icns" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\icon\linux\khost-256.png" Link="icons\khost-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging comes with the AspNetCore framework reference above. -->
    <PackageReference Include="Photino.NET" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KHost.Abstractions\KHost.Abstractions.csproj" />
    <ProjectReference Include="..\KHost.Common\KHost.Common.csproj" />
    <ProjectReference Include="..\KHost.Telemetry\KHost.Telemetry.csproj" />
    <ProjectReference Include="..\KHost.IPC.SignalR\KHost.IPC.SignalR.csproj" />
  </ItemGroup>

  <!-- Embedded, not copied: this output is copied wholesale into the UI's output, and loose
       player files there are both clutter and a shadowing hazard. LogicalName is set explicitly
       so the lookup in Program.cs cannot break on MSBuild's path-to-namespace mangling. -->
  <ItemGroup>
    <EmbeddedResource Include="screen-ui\index.html" LogicalName="screen-ui/index.html" />
    <EmbeddedResource Include="screen-ui\hls.light.min.js" LogicalName="screen-ui/hls.light.min.js" />
    <EmbeddedResource Include="screen-ui\title-bar.js" LogicalName="screen-ui/title-bar.js" />
    <EmbeddedResource Include="screen-ui\lyrics-overlay.js" LogicalName="screen-ui/lyrics-overlay.js" />
    <EmbeddedResource Include="screen-ui\intro-card.js" LogicalName="screen-ui/intro-card.js" />
    <EmbeddedResource Include="screen-ui\lead-in.js" LogicalName="screen-ui/lead-in.js" />
    <EmbeddedResource Include="screen-ui\stem-mixer.js" LogicalName="screen-ui/stem-mixer.js" />
    <EmbeddedResource Include="screen-ui\wake-watch.js" LogicalName="screen-ui/wake-watch.js" />
    <EmbeddedResource Include="screen-ui\butterchurn.min.js" LogicalName="screen-ui/butterchurn.min.js" />
    <EmbeddedResource Include="screen-ui\visualiser-presets.js" LogicalName="screen-ui/visualiser-presets.js" />
    <EmbeddedResource Include="screen-ui\visualiser.js" LogicalName="screen-ui/visualiser.js" />
    <EmbeddedResource Include="screen-ui\eq-visualisers.js" LogicalName="screen-ui/eq-visualisers.js" />
    <EmbeddedResource Include="screen-ui\player.js" LogicalName="screen-ui/player.js" />
    <!-- Not copied into screen-ui: the console's file is the one source of truth for both windows. -->
    <EmbeddedResource Include="..\KHost.UserInterface\wwwroot\js\browser-keys.js" LogicalName="screen-ui/browser-keys.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KHost.UnitTests" />
    <!-- NSubstitute builds its proxies here, so it can stand in for IScreenWindow. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
