<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KHost.Screen.Views.MainWindow"
        Title="KHost.Screen"
        Width="900" Height="600"
        MinWidth="480" MinHeight="360"
        Background="#1C1C1C"
        Focusable="True">

    <DockPanel>

        <!-- ── Toolbar ── -->
        <Border x:Name="TopToolbar"
                DockPanel.Dock="Top"
                Background="#2A2A2A"
                BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnLoad"
                        Content="📂  Load…"
                        Padding="12,6"
                        Click="BtnLoad_Click" />
                <Button x:Name="BtnPlay"
                        Content="▶  Play"
                        Padding="12,6"
                        IsEnabled="False"
                        Click="BtnPlay_Click" />
                <Button x:Name="BtnStop"
                        Content="⏹  Stop"
                        Padding="12,6"
                        IsEnabled="False"
                        Click="BtnStop_Click" />

                <!-- Pitch controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" Margin="8,0,0,0">
                    <Button x:Name="BtnPitchDown"
                            Content="&#x2212;"
                            Width="28" Height="28"
                            IsEnabled="False"
                            Click="BtnPitchDown_Click" />
                    <TextBlock x:Name="TxtPitch"
                               Text="Key: 0"
                               VerticalAlignment="Center"
                               MinWidth="56"
                               TextAlignment="Center"
                               Foreground="#AAAAAA"
                               FontSize="12" />
                    <Button x:Name="BtnPitchUp"
                            Content="&#x2B;"
                            Width="28" Height="28"
                            IsEnabled="False"
                            Click="BtnPitchUp_Click" />
                </StackPanel>

                <!-- Spacer -->
                <Border Width="1" Background="#3A3A3A" Margin="4,0" />

                <!-- Status label -->
                <TextBlock x:Name="TxtStatus"
                           Text="No file loaded"
                           VerticalAlignment="Center"
                           Foreground="#888888"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <!-- ── Status bar ── -->
        <Border x:Name="BottomToolbar"
                DockPanel.Dock="Bottom"
                Background="#222222"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel>
                <TextBlock x:Name="TxtTime"
                           DockPanel.Dock="Right"
                           Text="--:-- / --:--"
                           Foreground="#AAAAAA"
                           FontFamily="Consolas,Menlo,monospace"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <Slider x:Name="SldPosition"
                        Minimum="0"
                        Maximum="1000"
                        Value="0"
                        IsEnabled="False"
                        VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ── Video area ── -->
        <!-- Double-tap toggles full screen. Handled here rather than on the window so the
             toolbar's own controls do not trigger it. -->
        <Border Background="#111111" DoubleTapped="VideoArea_DoubleTapped">
            <Panel>
                <!-- Decoded video frames -->
                <Image x:Name="ImgVideo"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- Placeholder shown when nothing is loaded -->
                <TextBlock x:Name="TxtPlaceholder"
                           Text="No video loaded — click Load… to open a file"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="14" />

                <!-- Connection indicator: shown only while NOT connected to the host -->
                <Ellipse x:Name="ConnDot"
                         Width="14" Height="14"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,12,12,0"
                         Fill="#FF4136"
                         Stroke="#000000" StrokeThickness="1" />
            </Panel>
        </Border>

    </DockPanel>
</Window>
