<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A plugin compiles against this assembly and ships a copy of it, so a non-compete term here
         would forbid copyleft plugins outright. MIT while the rest of KHost is PolyForm Shield.
         See ./LICENSE. -->
    <Description>Contracts KHost is built on, and what a plugin is built against.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Michael Riddle</Copyright>
    <!-- Published so a plugin author needs no checkout of KHost to compile against it. -->
    <IsPackable>true</IsPackable>
    <Version>$(ContractsVersion)</Version>
    <PackageTags>khost;karaoke;plugin</PackageTags>
  </PropertyGroup>

  <!-- Build-time only: ReferenceOutputAssembly="false" keeps the analyzer out of this assembly,
       so it carries no code into what a plugin redistributes. -->
  <ItemGroup>
    <ProjectReference Include="..\..\build\KHost.Analyzers\KHost.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Entities\**" />
    <EmbeddedResource Remove="Entities\**" />
    <None Remove="Entities\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Repositories\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Models/Plugins/manifest.schema.json" Pack="true" PackagePath="content" />
    <!-- build/, not buildTransitive/: it must reach a plugin and not the plugin's test project. -->
    <None Include="build/KHost.Abstractions.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
